<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">3</defaultcontrol>
    <onload condition="Window.IsDialogTopMost(gameachievements) + !RetroPlayer.AchievementsLoggedIn">SetFocus(9001)</onload>
    <controls>
        <include condition="Window.IsDialogTopMost(gameports)">DialogGameControllers_GamePorts</include>
        <include condition="Window.IsDialogTopMost(gameagents)">DialogGameControllers_GameAgents</include>
        <include condition="Window.IsDialogTopMost(gameleaderboards)">DialogGameControllers_GameLeaderBoards</include>
        <include condition="Window.IsDialogTopMost(gameleaderboardentries)">DialogGameControllers_GameLeaderBoardEntries</include>
        <include condition="Window.IsDialogTopMost(gameachievements)">DialogGameControllers_GameAchievements</include>
        <include condition="Window.IsDialogTopMost(gameindicators)">DialogGameControllers_GameIndicators</include>
        <include condition="Window.IsDialogTopMost(gamecheats)">DialogGameControllers_GameCheats</include>
        <include condition="Window.IsDialogTopMost(gamediscmanager)">DialogGameControllers_GameDiscManager</include>
        <include condition="Window.IsDialogTopMost(gamecontrollers)">DialogGameControllers</include>
    </controls>
</window>
