<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">3</defaultcontrol>
    <controls>
        <!-- Kodi builds most of its game dialogs on this one window file -->
        <include condition="Window.IsDialogTopMost(gameachievements)">DialogGameAchievements</include>
        <include condition="Window.IsDialogTopMost(gameleaderboards)">DialogGameLeaderboards</include>
        <include condition="Window.IsDialogTopMost(gameleaderboardentries)">DialogGameLeaderboardEntries</include>
        <include condition="Window.IsDialogTopMost(gameindicators)">DialogGameIndicators</include>
        <include condition="Window.IsDialogTopMost(gamecheats)">DialogGameCheats</include>
        <include condition="!Window.IsDialogTopMost(gameachievements) + !Window.IsDialogTopMost(gameleaderboards) + !Window.IsDialogTopMost(gameleaderboardentries) + !Window.IsDialogTopMost(gameindicators) + !Window.IsDialogTopMost(gamecheats)">DialogGameControllers</include>
    </controls>
</window>
