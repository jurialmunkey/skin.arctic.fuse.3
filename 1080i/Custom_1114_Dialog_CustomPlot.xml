<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1114">

    <!-- Focus the info button when the header provides one. -->
    <include content="Object_DefaultControl" condition="!String.IsEmpty(Window.Property(path))">
        <param name="always">true</param>
        <param name="defaultcontrol">90002</param>
    </include>
    <include content="Object_DefaultControl" condition="String.IsEmpty(Window.Property(path))">
        <param name="always">true</param>
        <param name="defaultcontrol">90001</param>
    </include>
    <onload>ClearProperty(ModeList)</onload>
    <onunload>ClearProperty(ModeList,1114)</onunload>
    <onunload>ClearProperty(header,1114)</onunload>
    <onunload>ClearProperty(textbox,1114)</onunload>
    <onunload>ClearProperty(poster,1114)</onunload>
    <onunload>ClearProperty(landscape,1114)</onunload>
    <onunload>ClearProperty(clearlogo,1114)</onunload>
    <onunload>ClearProperty(icon,1114)</onunload>
    <onunload>ClearProperty(path,1114)</onunload>
    <onunload>ClearProperty(trailer,1114)</onunload>
    <onunload>ClearProperty(tmdb_id,1114)</onunload>
    <onunload>ClearProperty(tmdb_type,1114)</onunload>
    <onunload>ClearProperty(season,1114)</onunload>
    <onunload>ClearProperty(episode,1114)</onunload>
    <onunload>ClearProperty(filenameandpath,1114)</onunload>
    <onunload>ClearProperty(folderpath,1114)</onunload>
    <onunload>ClearProperty(dbtype,1114)</onunload>
    <onunload>ClearProperty(origin_tmdb_id,1114)</onunload>
    <onunload>ClearProperty(origin_tmdb_type,1114)</onunload>
    <onunload>ClearProperty(origin_season,1114)</onunload>
    <onunload>ClearProperty(origin_episode,1114)</onunload>
    <onload>SetProperty(TMDbHelper.ServicePause,True)</onload>
    <controls>

        <include>DialogCustomPlot_FocusButton</include>

        <include condition="!String.IsEmpty(Window.Property(tmdb_type)) + !String.IsEmpty(Window.Property(tmdb_id)) + String.IsEmpty(Window.Property(textbox))">DialogCustomPlot_DetailsList</include>

        <include content="Object_Hidden_Button" condition="String.IsEmpty(Window.Property(path))">
            <param name="id">9001</param>
            <onleft>Close</onleft>
            <onclick>Close</onclick>
            <onup>Control.Message(61,pageup)</onup>
            <ondown>Control.Message(61,pagedown)</ondown>
        </include>

        <include content="DialogCustomPlot" condition="![!String.IsEmpty(Window.Property(poster)) | !String.IsEmpty(Window.Property(icon))]">
            <param name="include_artwork">false</param>
        </include>
        <include content="DialogCustomPlot" condition="!String.IsEmpty(Window.Property(poster)) | !String.IsEmpty(Window.Property(icon))">
            <param name="include_artwork">true</param>
        </include>

        <include condition="!String.IsEmpty(Window.Property(tmdb_type)) + !String.IsEmpty(Window.Property(tmdb_id))">DialogCustomPlot_Busy</include>

    </controls>
</window>
