    <!-- One layer of the ruler: a grouplist of the steps, each group 140px wide and 18px after the last.
         It starts 70px left of step 0 and is 1580px wide so the pill at either end is not clipped -->
    <include name="DialogSlider_RulerLayer">
        <control type="grouplist">
            <left>-70</left>
            <top>0</top>
            <width>1580</width>
            <height>200</height>
            <orientation>horizontal</orientation>
            <itemgap>-122</itemgap>
            <scrolltime>0</scrolltime>
            <visible>$PARAM[visible]</visible>
            <include content="DialogSlider_RulerSteps">
                <param name="front">$PARAM[front]</param>
                <param name="pill_label">$PARAM[pill_label]</param>
            </include>
        </control>
    </include>

    <!-- Ruler for one known scale: ticks, labels and fill behind, nib and pill in front so later steps do not draw over them.
         The steps compare their index with the properties SkinVariables run_sliderruler sets. The nib waits until the script has set them -->
    <include name="DialogSlider_RulerScale">
        <param name="pill_label">$INFO[Window(Home).Property(SkinVariables.SliderRuler.Label)]</param>
        <definition>
            <include content="DialogSlider_RulerLayer">
                <param name="visible">$PARAM[visible]</param>
                <param name="front">false</param>
                <param name="pill_label" />
            </include>
            <include content="DialogSlider_RulerLayer">
                <param name="visible">$PARAM[visible] + !String.IsEmpty(Window(Home).Property(SkinVariables.SliderRuler.Ready))</param>
                <param name="front">true</param>
                <param name="pill_label">$PARAM[pill_label]</param>
            </include>
        </definition>
    </include>

    <!-- Starts SkinVariables run_sliderruler for the window. It follows the value and range variables named here
         and sets the ruler properties until the window closes. Clearing its owner property on close stops it -->
    <include name="DialogSlider_RulerScript">
        <param name="origin">Value_DialogSlider_RulerOrigin</param>
        <definition>
            <onload>RunScript(script.skinvariables,run_sliderruler,window=$PARAM[window],value=$PARAM[value],minimum=$PARAM[minimum],maximum=$PARAM[maximum],origin=$PARAM[origin])</onload>
            <onunload>ClearProperty(SkinVariables.SliderRuler.Owner,home)</onunload>
        </definition>
    </include>

    <include name="DialogSlider_RulerBaseline">
        <control type="image">
            <centertop>140</centertop>
            <height>2</height>
            <texture colordiffuse="main_fg_30">common/white.png</texture>
            <visible>$PARAM[visible]</visible>
        </control>
    </include>

    <!-- The ruler's area above the OSD progress bar. Nest the frame, labels, lists and the focusable control -->
    <include name="DialogSlider_RulerGroup">
        <control type="group">
            <left>view_osd_l</left>
            <right>view_osd_r</right>
            <bottom>120</bottom>
            <height>200</height>
            <nested />
        </control>
    </include>

    <include name="DialogSlider_Ruler">
        <include content="DialogSlider_RulerGroup">
            <!-- Scales are known from the heading. Other sliders keep just the baseline and Kodi's nib -->
            <include content="DialogSlider_RulerBaseline">
                <param name="visible">true</param>
            </include>
            <include content="DialogSlider_RulerScale">
                <param name="visible">$EXP[Exp_DialogSlider_Ruler]</param>
                <param name="pill_label">$VAR[Label_DialogSlider_Pill]</param>
            </include>

            <!-- Kodi's slider takes left and right. For the known scales its nib is faded out (it stays focusable) and the ruler list draws the value.
                 Other scales show only its nib, matching the ruler nib, on the ruler baseline. The hidden bar uses the nib texture so Kodi draws the nib at the control height,
                 and the 20px overhang each side lets the nib centre reach both end ticks -->
            <control type="slider" id="11">
                <left>-20</left>
                <right>-20</right>
                <centertop>140</centertop>
                <height>40</height>
                <texturesliderbar colordiffuse="00ffffff">slider/slider_nib_ring.png</texturesliderbar>
                <textureslidernib colordiffuse="main_fg_100">slider/slider_nib_ring.png</textureslidernib>
                <textureslidernibfocus colordiffuse="main_fg_100">slider/slider_nib_ring.png</textureslidernibfocus>
                <animation effect="fade" start="0" end="0" time="0" condition="$EXP[Exp_DialogSlider_Ruler]">Conditional</animation>
                <ondown>Close</ondown>
                <onup>Close</onup>
            </control>
        </include>
    </include>

    <!-- The OSD settings spotlight in the same place as in DialogSettings. DialogSlider leaves label empty for Kodi to set label 10.
         Opened from the OSD settings it appears without animating, so it reads as the same element -->
    <include name="DialogSlider_Spotlight">
        <param name="id">10</param>
        <param name="label" />
        <param name="hint">$VAR[Label_DialogSlider_Hint]</param>
        <definition>
            <control type="group">
                <right>view_pad</right>
                <width>1200</width>
                <include content="Animation_SlideIn_Dialog">
                    <param name="visible_condition">false</param>
                    <param name="windowopen_condition">!Window.IsVisible(DialogSettings.xml)</param>
                </include>
                <include content="DialogSettings_OSD_Spotlight">
                    <param name="id">$PARAM[id]</param>
                    <param name="label">$PARAM[label]</param>
                    <param name="hint">$PARAM[hint]</param>
                </include>
            </control>
        </definition>
    </include>
</includes>
