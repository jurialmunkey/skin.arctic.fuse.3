<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!-- Sync ruler for DialogSlider. The ruler sits 50px above the OSD progress bar, which stays visible, with its baseline 140 from the top of DialogSlider_Ruler.
         Ticks every 36px (two 18px steps), a major tick every 180px and a tall tick at zero. -->

    <include name="DialogSlider_RulerTick">
        <param name="height">14</param>
        <param name="colordiffuse">panel_fg_30</param>
        <definition>
            <control type="image">
                <left>$PARAM[left]</left>
                <width>2</width>
                <bottom>0</bottom>
                <height>$PARAM[height]</height>
                <texture colordiffuse="$PARAM[colordiffuse]">common/white.png</texture>
            </control>
        </definition>
    </include>

    <!-- One major tick and its minor ticks. Decimal scales use 180px segments with four minor ticks, the speed scale 144px segments with three -->
    <include name="DialogSlider_RulerSegment">
        <param name="width">180</param>
        <param name="fourth">true</param>
        <definition>
            <control type="group">
                <left>$PARAM[left]</left>
                <width>$PARAM[width]</width>
                <include content="DialogSlider_RulerTick">
                    <param name="left">-1</param>
                    <param name="height">28</param>
                    <param name="colordiffuse">panel_fg_50</param>
                </include>
                <include content="DialogSlider_RulerTick"><param name="left">35</param></include>
                <include content="DialogSlider_RulerTick"><param name="left">71</param></include>
                <include content="DialogSlider_RulerTick"><param name="left">107</param></include>
                <include content="DialogSlider_RulerTick" condition="$PARAM[fourth]"><param name="left">143</param></include>
            </control>
        </definition>
    </include>

    <include name="DialogSlider_RulerSegment_Speed">
        <include content="DialogSlider_RulerSegment">
            <param name="left">$PARAM[left]</param>
            <param name="width">144</param>
            <param name="fourth">false</param>
        </include>
    </include>

    <include name="DialogSlider_RulerLabel">
        <param name="textcolor">panel_fg_50</param>
        <definition>
            <control type="label">
                <left>$PARAM[left]</left>
                <width>100</width>
                <height>24</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>font_hint_bold</font>
                <textcolor>$PARAM[textcolor]</textcolor>
                <label>$PARAM[label]</label>
            </control>
        </definition>
    </include>

    <!-- Range labels under the major ticks, for one known scale. The origin label (where the fill starts) is brighter; leave its regular label empty -->
    <include name="DialogSlider_RulerLabels">
        <param name="label_4" />
        <param name="origin_label">$NUMBER[0]</param>
        <param name="origin_left">670</param>
        <definition>
            <control type="group">
                <top>150</top>
                <height>40</height>
                <visible>$PARAM[visible]</visible>
                <include content="DialogSlider_RulerLabel"><param name="left">-50</param><param name="label">$PARAM[label_0]</param></include>
                <include content="DialogSlider_RulerLabel"><param name="left">130</param><param name="label">$PARAM[label_1]</param></include>
                <include content="DialogSlider_RulerLabel"><param name="left">310</param><param name="label">$PARAM[label_2]</param></include>
                <include content="DialogSlider_RulerLabel"><param name="left">490</param><param name="label">$PARAM[label_3]</param></include>
                <include content="DialogSlider_RulerLabel"><param name="left">670</param><param name="label">$PARAM[label_4]</param></include>
                <include content="DialogSlider_RulerLabel"><param name="left">850</param><param name="label">$PARAM[label_5]</param></include>
                <include content="DialogSlider_RulerLabel"><param name="left">1030</param><param name="label">$PARAM[label_6]</param></include>
                <include content="DialogSlider_RulerLabel"><param name="left">1210</param><param name="label">$PARAM[label_7]</param></include>
                <include content="DialogSlider_RulerLabel"><param name="left">1390</param><param name="label">$PARAM[label_8]</param></include>
                <include content="DialogSlider_RulerLabel"><param name="left">$PARAM[origin_left]</param><param name="label">$PARAM[origin_label]</param><param name="textcolor">panel_fg_90</param></include>
            </control>
        </definition>
    </include>

    <!-- Rewind and fast forward speeds under the 144px major ticks, with normal speed in the centre -->
    <include name="DialogSlider_RulerLabels_Speed">
        <control type="group">
            <top>150</top>
            <height>40</height>
            <visible>$PARAM[visible]</visible>
            <include content="DialogSlider_RulerLabel"><param name="left">-50</param><param name="label">32×</param></include>
            <include content="DialogSlider_RulerLabel"><param name="left">94</param><param name="label">16×</param></include>
            <include content="DialogSlider_RulerLabel"><param name="left">238</param><param name="label">8×</param></include>
            <include content="DialogSlider_RulerLabel"><param name="left">382</param><param name="label">4×</param></include>
            <include content="DialogSlider_RulerLabel"><param name="left">526</param><param name="label">2×</param></include>
            <include content="DialogSlider_RulerLabel"><param name="left">670</param><param name="label">1×</param><param name="textcolor">panel_fg_90</param></include>
            <include content="DialogSlider_RulerLabel"><param name="left">814</param><param name="label">2×</param></include>
            <include content="DialogSlider_RulerLabel"><param name="left">958</param><param name="label">4×</param></include>
            <include content="DialogSlider_RulerLabel"><param name="left">1102</param><param name="label">8×</param></include>
            <include content="DialogSlider_RulerLabel"><param name="left">1246</param><param name="label">16×</param></include>
            <include content="DialogSlider_RulerLabel"><param name="left">1390</param><param name="label">32×</param></include>
        </control>
    </include>

    <!-- One 18px step of the ruler list from SkinVariables get_slider_ruler: the fill from zero to the nib, and the nib with its value pill.
         pill_label: the pill text, by default the route's millisecond label -->
    <include name="DialogSlider_RulerItem">
        <param name="pill_label">$INFO[ListItem.Label]</param>
        <definition>
        <control type="image">
            <top>136</top>
            <height>8</height>
            <texture colordiffuse="panel_fg_100">common/white.png</texture>
            <visible>String.IsEqual(ListItem.Property(fill),full)</visible>
        </control>
        <control type="image">
            <width>9</width>
            <top>136</top>
            <height>8</height>
            <texture colordiffuse="panel_fg_100">common/white.png</texture>
            <visible>String.IsEqual(ListItem.Property(fill),left)</visible>
        </control>
        <control type="image">
            <left>9</left>
            <width>9</width>
            <top>136</top>
            <height>8</height>
            <texture colordiffuse="panel_fg_100">common/white.png</texture>
            <visible>String.IsEqual(ListItem.Property(fill),right)</visible>
        </control>
        <control type="group">
            <visible>!String.IsEmpty(ListItem.Property(nib))</visible>
            <control type="image">
                <left>-11</left>
                <top>120</top>
                <width>40</width>
                <height>40</height>
                <texture colordiffuse="panel_fg_30">common/circle.png</texture>
            </control>
            <control type="image">
                <left>-5</left>
                <top>126</top>
                <width>28</width>
                <height>28</height>
                <texture colordiffuse="panel_fg_100">common/circle.png</texture>
            </control>
            <control type="image">
                <left>8</left>
                <top>80</top>
                <width>2</width>
                <height>34</height>
                <texture colordiffuse="panel_fg_100">common/white.png</texture>
            </control>
            <control type="image">
                <left>-61</left>
                <top>38</top>
                <width>140</width>
                <height>40</height>
                <texture colordiffuse="panel_fg_100" border="20">common/dialog.png</texture>
            </control>
            <control type="label">
                <left>-61</left>
                <top>38</top>
                <width>140</width>
                <height>40</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>font_tiny_bold</font>
                <textcolor>panel_bg_90</textcolor>
                <label>$PARAM[pill_label]</label>
            </control>
        </control>
        </definition>
    </include>

    <!-- Ruler list for one known scale. Its path includes the live value, so Kodi reloads it on every change.
         Items are centred on the 18px steps, with four blank items each side so the pill has room at the ends.
         The fill starts at a value of zero, so scales centred elsewhere pass a step count as the value -->
    <include name="DialogSlider_RulerList">
        <param name="pill_label">$INFO[ListItem.Label]</param>
        <definition>
        <control type="list">
            <left>-81</left>
            <top>0</top>
            <width>1602</width>
            <height>200</height>
            <orientation>horizontal</orientation>
            <scrolltime>0</scrolltime>
            <visible>$PARAM[visible]</visible>
            <itemlayout width="18" height="200">
                <include content="DialogSlider_RulerItem">
                    <param name="pill_label">$PARAM[pill_label]</param>
                </include>
            </itemlayout>
            <focusedlayout width="18" height="200">
                <include content="DialogSlider_RulerItem">
                    <param name="pill_label">$PARAM[pill_label]</param>
                </include>
            </focusedlayout>
            <content>plugin://script.skinvariables?info=get_slider_ruler&amp;value=$PARAM[value]&amp;minimum=$PARAM[minimum]&amp;maximum=$PARAM[maximum]&amp;steps=80&amp;pad=4</content>
        </control>
        </definition>
    </include>

    <!-- Baseline and ticks. speed: ten 144px segments instead of eight 180px ones. origin: left of the tall tick where the fill starts -->
    <include name="DialogSlider_RulerFrame">
        <param name="speed">false</param>
        <param name="origin">719</param>
        <definition>
            <control type="image">
                <centertop>140</centertop>
                <height>2</height>
                <texture colordiffuse="panel_fg_30">common/white.png</texture>
                <visible>$PARAM[visible]</visible>
            </control>
            <control type="group">
                <centertop>100</centertop>
                <height>44</height>
                <visible>$PARAM[visible]</visible>
                <include content="DialogSlider_RulerSegments" condition="![$PARAM[speed]]" />
                <include content="DialogSlider_RulerSegments_Speed" condition="$PARAM[speed]" />
                <include content="DialogSlider_RulerTick">
                    <param name="left">1439</param>
                    <param name="height">28</param>
                    <param name="colordiffuse">panel_fg_50</param>
                </include>
                <include content="DialogSlider_RulerTick">
                    <param name="left">$PARAM[origin]</param>
                    <param name="height">44</param>
                    <param name="colordiffuse">panel_fg_90</param>
                </include>
            </control>
        </definition>
    </include>

    <include name="DialogSlider_RulerSegments">
        <include content="DialogSlider_RulerSegment"><param name="left">0</param></include>
        <include content="DialogSlider_RulerSegment"><param name="left">180</param></include>
        <include content="DialogSlider_RulerSegment"><param name="left">360</param></include>
        <include content="DialogSlider_RulerSegment"><param name="left">540</param></include>
        <include content="DialogSlider_RulerSegment"><param name="left">720</param></include>
        <include content="DialogSlider_RulerSegment"><param name="left">900</param></include>
        <include content="DialogSlider_RulerSegment"><param name="left">1080</param></include>
        <include content="DialogSlider_RulerSegment"><param name="left">1260</param></include>
    </include>

    <include name="DialogSlider_RulerSegments_Speed">
        <include content="DialogSlider_RulerSegment_Speed"><param name="left">0</param></include>
        <include content="DialogSlider_RulerSegment_Speed"><param name="left">144</param></include>
        <include content="DialogSlider_RulerSegment_Speed"><param name="left">288</param></include>
        <include content="DialogSlider_RulerSegment_Speed"><param name="left">432</param></include>
        <include content="DialogSlider_RulerSegment_Speed"><param name="left">576</param></include>
        <include content="DialogSlider_RulerSegment_Speed"><param name="left">720</param></include>
        <include content="DialogSlider_RulerSegment_Speed"><param name="left">864</param></include>
        <include content="DialogSlider_RulerSegment_Speed"><param name="left">1008</param></include>
        <include content="DialogSlider_RulerSegment_Speed"><param name="left">1152</param></include>
        <include content="DialogSlider_RulerSegment_Speed"><param name="left">1296</param></include>
    </include>

    <!-- The ruler's area above the OSD progress bar. Nest the frame, labels, lists and the focusable control -->
    <include name="DialogSlider_RulerGroup">
        <control type="group">
            <left>view_osd_l</left>
            <right>view_osd_r</right>
            <bottom>120</bottom>
            <height>200</height>
            <nested />
        </control>
    </include>

    <include name="DialogSlider_Ruler">
        <include content="DialogSlider_RulerGroup">
            <include content="DialogSlider_RulerFrame">
                <param name="visible">true</param>
            </include>

            <!-- Audio offset: -1 to +1 s in 25 ms steps. Subtitle offset: -4 to +4 s in 100 ms steps -->
            <include content="DialogSlider_RulerLabels">
                <param name="visible">$EXP[Exp_DialogSlider_AudioDelay]</param>
                <param name="label_0">&#8722;1.00</param>
                <param name="label_1">&#8722;0.75</param>
                <param name="label_2">&#8722;0.50</param>
                <param name="label_3">&#8722;0.25</param>
                <param name="label_5">+0.25</param>
                <param name="label_6">+0.50</param>
                <param name="label_7">+0.75</param>
                <param name="label_8">+1.00</param>
            </include>
            <include content="DialogSlider_RulerLabels">
                <param name="visible">$EXP[Exp_DialogSlider_SubtitleDelay]</param>
                <param name="label_0">&#8722;4.0</param>
                <param name="label_1">&#8722;3.0</param>
                <param name="label_2">&#8722;2.0</param>
                <param name="label_3">&#8722;1.0</param>
                <param name="label_5">+1.0</param>
                <param name="label_6">+2.0</param>
                <param name="label_7">+3.0</param>
                <param name="label_8">+4.0</param>
            </include>
            <include content="DialogSlider_RulerList">
                <param name="visible">$EXP[Exp_DialogSlider_AudioDelay]</param>
                <param name="value">$INFO[Player.AudioDelay]</param>
                <param name="minimum">-1</param>
                <param name="maximum">1</param>
            </include>
            <include content="DialogSlider_RulerList">
                <param name="visible">$EXP[Exp_DialogSlider_SubtitleDelay]</param>
                <param name="value">$INFO[Player.SubtitleDelay]</param>
                <param name="minimum">-4</param>
                <param name="maximum">4</param>
            </include>

            <!-- Kodi's slider takes left and right. For the delay scales its nib is faded out (it stays focusable) and the ruler list draws the value -->
            <control type="slider" id="11">
                <centertop>140</centertop>
                <height>12</height>
                <texturesliderbar colordiffuse="panel_fg_30" border="6">slider/slider_bg.png</texturesliderbar>
                <textureslidernib colordiffuse="panel_fg_100" border="6">slider/slider_nib.png</textureslidernib>
                <include>Texture_Slider_NibFocus</include>
                <animation effect="fade" start="0" end="0" time="0" condition="$EXP[Exp_DialogSlider_Delay]">Conditional</animation>
                <ondown>Close</ondown>
                <onup>Close</onup>
            </control>
        </include>
    </include>

    <!-- Heading with its icon and the key hint, in the OSD title position. DialogSlider leaves label empty for Kodi to set label 10 -->
    <include name="DialogSlider_Heading">
        <param name="label" />
        <param name="icon">$VAR[Image_DialogSlider_Icon]</param>
        <param name="hint">$VAR[Label_DialogSlider_Hint]</param>
        <definition>
        <control type="group">
            <bottom>320</bottom>
            <control type="grouplist">
                <left>view_pad</left>
                <width>1000</width>
                <bottom>40</bottom>
                <height>80</height>
                <orientation>horizontal</orientation>
                <itemgap>20</itemgap>
                <control type="image">
                    <centertop>50%</centertop>
                    <width>40</width>
                    <height>40</height>
                    <bordersize>-8</bordersize>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="panel_fg_100">$PARAM[icon]</texture>
                </control>
                <control type="label" id="10">
                    <width>auto</width>
                    <aligny>center</aligny>
                    <font>font_title_main</font>
                    <textcolor>panel_fg_100</textcolor>
                    <label>$PARAM[label]</label>
                </control>
            </control>
            <control type="label">
                <left>view_pad</left>
                <width>1000</width>
                <bottom>0</bottom>
                <height>40</height>
                <aligny>center</aligny>
                <font>font_mini</font>
                <textcolor>panel_fg_70</textcolor>
                <label>$PARAM[hint]</label>
            </control>
        </control>
        </definition>
    </include>

    <!-- Large value on the right. Kodi still sets label 12, which stays hidden behind the player delay labels -->
    <include name="DialogSlider_Value">
        <param name="value">$VAR[Label_DialogSlider_Value]</param>
        <definition>
        <control type="label" id="12">
            <visible>false</visible>
        </control>
        <control type="label">
            <right>view_pad</right>
            <width>800</width>
            <bottom>320</bottom>
            <height>120</height>
            <align>right</align>
            <aligny>bottom</aligny>
            <font>font_title_huge</font>
            <textcolor>panel_fg_100</textcolor>
            <label>$PARAM[value]</label>
        </control>
        </definition>
    </include>
</includes>
