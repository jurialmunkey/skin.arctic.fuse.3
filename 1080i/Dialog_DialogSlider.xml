<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!-- Sync ruler for DialogSlider. The ruler matches the OSD settings list width, under the spotlight, with its baseline 140 from the top of DialogSlider_Ruler
         on the same line as the OSD header divider. Steps are 9px apart with step 0 at the left end. Minor ticks fall on every second step, major ticks every ten steps (90px scales) or eight (72px scales). -->

    <!-- One step of the ruler, a 140px group centred on its 9px slice. The grouplists overlap the groups so each starts 9px after the last.
         Groups always stay visible so the grouplist keeps its spacing; each piece has its own condition.
         Back layer (front false): the minor tick on even steps, the major tick and label where the scale has one, and the fill.
         Front layer (front true): the nib, drawn over the back layer.
         index: the step from 0 to 80. minor: an even step. labelled: a step that is major in some scale, with major its condition -->
    <include name="DialogSlider_RulerStep">
        <param name="minor">false</param>
        <param name="labelled">false</param>
        <param name="major">false</param>
        <param name="lower">Window(Home).Property(SkinVariables.SliderRuler.Lower)</param>
        <param name="upper">Window(Home).Property(SkinVariables.SliderRuler.Upper)</param>
        <param name="nib">Window(Home).Property(SkinVariables.SliderRuler.Nib)</param>
        <param name="origin">Window(Home).Property(SkinVariables.SliderRuler.Origin)</param>
        <definition>
        <control type="group">
            <width>140</width>
            <include content="DialogSlider_RulerStep_Tick" condition="![$PARAM[front]] + $PARAM[minor]">
                <param name="top">108</param>
                <param name="height">14</param>
                <param name="colordiffuse">main_fg_30</param>
                <param name="visible">![$PARAM[major]]</param>
            </include>
            <include content="DialogSlider_RulerStep_Major" condition="![$PARAM[front]] + $PARAM[labelled]">
                <param name="major">$PARAM[major]</param>
                <param name="tick">$VAR[Label_DialogSlider_RulerTick_$PARAM[index]]</param>
                <param name="origin">Integer.IsEqual($PARAM[index],$PARAM[origin]) + !String.IsEmpty(Window(Home).Property(SkinVariables.SliderRuler.Ready))</param>
            </include>
            <include content="DialogSlider_RulerStep_Fill" condition="![$PARAM[front]]">
                <param name="index">$PARAM[index]</param>
                <param name="lower">$PARAM[lower]</param>
                <param name="upper">$PARAM[upper]</param>
            </include>
            <include content="DialogSlider_RulerStep_Nib" condition="$PARAM[front]">
                <param name="visible">Integer.IsEqual($PARAM[index],$PARAM[nib])</param>
            </include>
        </control>
        </definition>
    </include>

    <!-- A tick standing on the baseline -->
    <include name="DialogSlider_RulerStep_Tick">
        <control type="image">
            <left>69</left>
            <top>$PARAM[top]</top>
            <width>2</width>
            <height>$PARAM[height]</height>
            <texture colordiffuse="$PARAM[colordiffuse]">common/white.png</texture>
            <visible>$PARAM[visible]</visible>
        </control>
    </include>

    <!-- The major tick and its label where the scale has a major tick at this step. The origin label is brighter -->
    <include name="DialogSlider_RulerStep_Major">
        <include content="DialogSlider_RulerStep_Tick">
            <param name="top">94</param>
            <param name="height">28</param>
            <param name="colordiffuse">main_fg_50</param>
            <param name="visible">$PARAM[major]</param>
        </include>
        <include content="DialogSlider_RulerStep_Label">
            <param name="tick">$PARAM[tick]</param>
            <param name="textcolor">main_fg_50</param>
            <param name="visible">[$PARAM[major]] + ![$PARAM[origin]]</param>
        </include>
        <include content="DialogSlider_RulerStep_Label">
            <param name="tick">$PARAM[tick]</param>
            <param name="textcolor">main_fg_90</param>
            <param name="visible">[$PARAM[major]] + [$PARAM[origin]]</param>
        </include>
    </include>

    <include name="DialogSlider_RulerStep_Label">
        <control type="label">
            <left>20</left>
            <top>150</top>
            <width>100</width>
            <height>24</height>
            <align>center</align>
            <aligny>center</aligny>
            <font>font_hint_bold</font>
            <textcolor>$PARAM[textcolor]</textcolor>
            <label>$PARAM[tick]</label>
            <visible>$PARAM[visible]</visible>
        </control>
    </include>

    <!-- The fill from the origin to the nib: the whole slice between the ends, and the half slices towards the fill at each end -->
    <include name="DialogSlider_RulerStep_Fill">
        <include content="DialogSlider_RulerStep_FillBar">
            <param name="left">66</param>
            <param name="width">9</param>
            <param name="visible">Integer.IsGreater($PARAM[index],$PARAM[lower]) + Integer.IsLess($PARAM[index],$PARAM[upper])</param>
        </include>
        <include content="DialogSlider_RulerStep_FillBar">
            <param name="left">66</param>
            <param name="width">4</param>
            <param name="visible">Integer.IsEqual($PARAM[index],$PARAM[upper]) + !Integer.IsEqual($PARAM[lower],$PARAM[upper])</param>
        </include>
        <include content="DialogSlider_RulerStep_FillBar">
            <param name="left">70</param>
            <param name="width">5</param>
            <param name="visible">Integer.IsEqual($PARAM[index],$PARAM[lower]) + !Integer.IsEqual($PARAM[lower],$PARAM[upper])</param>
        </include>
    </include>

    <include name="DialogSlider_RulerStep_FillBar">
        <control type="image">
            <left>$PARAM[left]</left>
            <top>136</top>
            <width>$PARAM[width]</width>
            <height>8</height>
            <texture colordiffuse="$VAR[ColorHighlight]">common/white.png</texture>
            <visible>$PARAM[visible]</visible>
        </control>
    </include>

    <include name="DialogSlider_RulerStep_Nib">
        <control type="group">
            <visible>$PARAM[visible]</visible>
            <control type="image">
                <left>50</left>
                <top>120</top>
                <width>40</width>
                <height>40</height>
                <texture colordiffuse="main_fg_30">common/circle.png</texture>
            </control>
            <control type="image">
                <left>56</left>
                <top>126</top>
                <width>28</width>
                <height>28</height>
                <texture colordiffuse="main_fg_100">common/circle.png</texture>
            </control>
        </control>
    </include>

    <!-- The 81 ruler steps from 0 to 80 -->
    <include name="DialogSlider_RulerSteps">
        <include content="DialogSlider_RulerStep"><param name="index">0</param><param name="minor">true</param><param name="labelled">true</param><param name="major">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">1</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">2</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">3</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">4</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">5</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">6</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">7</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">8</param><param name="minor">true</param><param name="labelled">true</param><param name="major">$EXP[Exp_DialogSlider_RulerSpeed]</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">9</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">10</param><param name="minor">true</param><param name="labelled">true</param><param name="major">$EXP[Exp_DialogSlider_RulerDecimal]</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">11</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">12</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">13</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">14</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">15</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">16</param><param name="minor">true</param><param name="labelled">true</param><param name="major">$EXP[Exp_DialogSlider_RulerSpeed]</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">17</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">18</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">19</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">20</param><param name="minor">true</param><param name="labelled">true</param><param name="major">$EXP[Exp_DialogSlider_RulerDecimal]</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">21</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">22</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">23</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">24</param><param name="minor">true</param><param name="labelled">true</param><param name="major">$EXP[Exp_DialogSlider_RulerSpeed]</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">25</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">26</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">27</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">28</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">29</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">30</param><param name="minor">true</param><param name="labelled">true</param><param name="major">$EXP[Exp_DialogSlider_RulerDecimal]</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">31</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">32</param><param name="minor">true</param><param name="labelled">true</param><param name="major">$EXP[Exp_DialogSlider_RulerSpeed]</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">33</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">34</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">35</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">36</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">37</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">38</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">39</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">40</param><param name="minor">true</param><param name="labelled">true</param><param name="major">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">41</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">42</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">43</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">44</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">45</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">46</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">47</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">48</param><param name="minor">true</param><param name="labelled">true</param><param name="major">$EXP[Exp_DialogSlider_RulerSpeed]</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">49</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">50</param><param name="minor">true</param><param name="labelled">true</param><param name="major">$EXP[Exp_DialogSlider_RulerDecimal]</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">51</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">52</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">53</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">54</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">55</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">56</param><param name="minor">true</param><param name="labelled">true</param><param name="major">$EXP[Exp_DialogSlider_RulerSpeed]</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">57</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">58</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">59</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">60</param><param name="minor">true</param><param name="labelled">true</param><param name="major">$EXP[Exp_DialogSlider_RulerDecimal]</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">61</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">62</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">63</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">64</param><param name="minor">true</param><param name="labelled">true</param><param name="major">$EXP[Exp_DialogSlider_RulerSpeed]</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">65</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">66</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">67</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">68</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">69</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">70</param><param name="minor">true</param><param name="labelled">true</param><param name="major">$EXP[Exp_DialogSlider_RulerDecimal]</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">71</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">72</param><param name="minor">true</param><param name="labelled">true</param><param name="major">$EXP[Exp_DialogSlider_RulerSpeed]</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">73</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">74</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">75</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">76</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">77</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">78</param><param name="minor">true</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">79</param><param name="front">$PARAM[front]</param></include>
        <include content="DialogSlider_RulerStep"><param name="index">80</param><param name="minor">true</param><param name="labelled">true</param><param name="major">true</param><param name="front">$PARAM[front]</param></include>
    </include>

    <!-- One layer of the ruler: a grouplist of the steps, each group 140px wide and 9px after the last.
         It starts 70px left of step 0 and is 860px wide so the groups at either end are not clipped -->
    <include name="DialogSlider_RulerLayer">
        <control type="grouplist">
            <left>-70</left>
            <top>0</top>
            <width>860</width>
            <height>200</height>
            <orientation>horizontal</orientation>
            <itemgap>-131</itemgap>
            <scrolltime>0</scrolltime>
            <visible>$PARAM[visible]</visible>
            <include content="DialogSlider_RulerSteps">
                <param name="front">$PARAM[front]</param>
            </include>
        </control>
    </include>

    <!-- Ruler for one known scale: ticks, labels and fill behind, nib in front so later steps do not draw over it.
         The steps compare their index with the properties SkinVariables run_sliderruler sets. The nib waits until the script has set them -->
    <include name="DialogSlider_RulerScale">
        <include content="DialogSlider_RulerLayer">
            <param name="visible">$PARAM[visible]</param>
            <param name="front">false</param>
        </include>
        <include content="DialogSlider_RulerLayer">
            <param name="visible">$PARAM[visible] + !String.IsEmpty(Window(Home).Property(SkinVariables.SliderRuler.Ready))</param>
            <param name="front">true</param>
        </include>
    </include>

    <!-- Starts SkinVariables run_sliderruler for the window. It follows the value and range variables named here
         and sets the ruler properties until the window closes. Clearing its owner property on close stops it -->
    <include name="DialogSlider_RulerScript">
        <param name="origin">Value_DialogSlider_RulerOrigin</param>
        <definition>
            <onload>RunScript(script.skinvariables,run_sliderruler,window=$PARAM[window],value=$PARAM[value],minimum=$PARAM[minimum],maximum=$PARAM[maximum],origin=$PARAM[origin])</onload>
            <onunload>ClearProperty(SkinVariables.SliderRuler.Owner,home)</onunload>
        </definition>
    </include>

    <!-- Over the OSD settings and stream lists the ruler quickly fades in and out. Otherwise it slides in with the spotlight -->
    <include name="DialogSlider_RulerAnimation">
        <include content="Animation_SlideIn_Dialog">
            <param name="windowopen_condition">!$EXP[Exp_OSD_SpotlightList]</param>
        </include>
        <include content="Animation_Fade_In">
            <param name="type">WindowOpen</param>
            <param name="time">150</param>
            <param name="condition">$EXP[Exp_OSD_SpotlightList]</param>
        </include>
        <include content="Animation_Fade_Out">
            <param name="type">WindowClose</param>
            <param name="time">150</param>
            <param name="condition">$EXP[Exp_OSD_SpotlightList]</param>
        </include>
    </include>

    <include name="DialogSlider_RulerBaseline">
        <control type="image">
            <centertop>140</centertop>
            <height>2</height>
            <texture colordiffuse="main_fg_30">common/white.png</texture>
            <visible>$PARAM[visible]</visible>
        </control>
    </include>

    <!-- The ruler's area under the spotlight, as wide as the OSD settings list. Nest the frame, labels, lists and the focusable control -->
    <include name="DialogSlider_RulerGroup">
        <control type="group">
            <right>view_pad</right>
            <width>720</width>
            <bottom>180</bottom>
            <height>200</height>
            <nested />
        </control>
    </include>

    <include name="DialogSlider_Ruler">
        <include content="DialogSlider_RulerGroup">
            <!-- Scales are known from the heading. Other sliders keep just the baseline and Kodi's nib -->
            <include content="DialogSlider_RulerBaseline">
                <param name="visible">true</param>
            </include>
            <include content="DialogSlider_RulerScale">
                <param name="visible">$EXP[Exp_DialogSlider_Ruler]</param>
            </include>

            <!-- Kodi's slider takes left and right. For the known scales its nib is faded out (it stays focusable) and the ruler list draws the value.
                 Other scales show only its nib, matching the ruler nib, on the ruler baseline. The hidden bar uses the nib texture so Kodi draws the nib at the control height,
                 and the 20px overhang each side lets the nib centre reach both end ticks -->
            <control type="slider" id="11">
                <left>-20</left>
                <right>-20</right>
                <centertop>140</centertop>
                <height>40</height>
                <texturesliderbar colordiffuse="00ffffff">slider/slider_nib_ring.png</texturesliderbar>
                <textureslidernib colordiffuse="main_fg_100">slider/slider_nib_ring.png</textureslidernib>
                <textureslidernibfocus colordiffuse="main_fg_100">slider/slider_nib_ring.png</textureslidernibfocus>
                <animation effect="fade" start="0" end="0" time="0" condition="$EXP[Exp_DialogSlider_Ruler]">Conditional</animation>
                <ondown>Close</ondown>
                <onup>Close</onup>
            </control>
        </include>
    </include>

    <!-- The OSD settings spotlight in the same place as in DialogSettings, with the slider value before the key hints. DialogSlider leaves label empty for Kodi to set label 10.
         Opened from the OSD settings or stream lists it appears without animating, so it reads as the same element -->
    <include name="DialogSlider_Spotlight">
        <param name="id">10</param>
        <param name="label" />
        <param name="value">$VAR[Label_DialogSlider_Display]</param>
        <param name="hint">$VAR[Label_DialogSlider_Hint]</param>
        <definition>
            <control type="group">
                <right>view_pad</right>
                <width>1200</width>
                <include content="Animation_SlideIn_Dialog">
                    <param name="visible_condition">false</param>
                    <param name="windowopen_condition">!$EXP[Exp_OSD_SpotlightList]</param>
                </include>
                <include content="DialogSettings_OSD_Spotlight">
                    <param name="id">$PARAM[id]</param>
                    <param name="label">$PARAM[label]</param>
                    <param name="hint">[B]$PARAM[value][/B]       $PARAM[hint]</param>
                </include>
            </control>
        </definition>
    </include>
</includes>
