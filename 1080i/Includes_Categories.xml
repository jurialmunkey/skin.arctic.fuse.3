<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <include name="Categories_Selector_Button_List">
        <param name="onfocus_condition">true</param>
        <definition>
            <control type="wraplist" id="$PARAM[id]">
                <onfocus condition="$PARAM[onfocus_condition]">SetFocus($PARAM[altfocusid])</onfocus>
                <include>Object_Hidden_List_Definition</include>
                <nested />
            </control>
        </definition>
    </include>

    <include name="Categories_Selector_Button_Control">
        <param name="hidden_button" />
        <param name="hidden_button_enabled">false</param>
        <param name="onclick_condition">true</param>
        <definition>
            <control type="button" id="$PARAM[altfocusid]">
                <width max="640">auto</width>
                <height>70</height>
                <aligny>center</aligny>
                <include>Texture_Highlight_Underline_H</include>
                <font>font_main_bold</font>
                <textcolor>00ffffff</textcolor>
                <focusedcolor>00ffffff</focusedcolor>
                <selectedcolor>00ffffff</selectedcolor>
                <textoffsetx>0</textoffsetx>
                <onclick condition="$PARAM[onclick_condition]">RunScript(script.skinvariables,run_selectfocusdialog=$PARAM[id],"header=$VAR[Label_CategorySelectList]")</onclick>
                <include content="$PARAM[hidden_button]_OnFocus" condition="$PARAM[hidden_button_enabled]">
                    <param name="id">$PARAM[id]</param>
                    <param name="container">Container($PARAM[id]).</param>
                    <param name="prefix">$PARAM[hidden_button_prefix]</param>
                </include>
                <nested />
                <label>$INFO[Container($PARAM[id]).ListItem.Label,, ⌄ ]</label>
            </control>
        </definition>
    </include>

    <include name="Categories_Selector_Button_Label">
        <definition>
            <control type="label">
                <height>80</height>
                <width max="640">auto</width>
                <font>font_main_bold</font>
                <textcolor>main_fg_100</textcolor>
                <visible>Control.HasFocus($PARAM[id]) | Control.HasFocus($PARAM[altfocusid])</visible>
                <nested />
                <label>$INFO[Container($PARAM[id]).ListItem.Label,, ⌄ ]</label>
            </control>
            <control type="label">
                <height>80</height>
                <width max="640">auto</width>
                <font>font_main_bold</font>
                <textcolor>main_fg_30</textcolor>
                <visible>![Control.HasFocus($PARAM[id]) | Control.HasFocus($PARAM[altfocusid])]</visible>
                <nested />
                <label>$INFO[Container($PARAM[id]).ListItem.Label,, ⌄ ]</label>
            </control>
        </definition>
    </include>

    <include name="Categories_Selector_OverlayList">
        <param name="id">302</param>
        <definition>
            <control type="group">
                <nested />
                <control type="group">
                    <left>40</left>
                    <height>80</height>
                    <centertop>50%</centertop>
                    <control type="group">
                        <animation effect="slide" start="0" end="-60" time="400" tween="quadratic" easing="out" condition="!Container($PARAM[id]).OnScrollNext" reversible="false">Conditional</animation>
                        <animation effect="slide" start="0" end="60" time="400" tween="quadratic" easing="out" condition="!Container($PARAM[id]).OnScrollPrevious" reversible="false">Conditional</animation>
                        <!-- <control type="label">
                            <height>80</height>
                            <align>right</align>
                            <left>-670</left>
                            <width>640</width>
                            <centertop>50%</centertop>
                            <font>font_main</font>
                            <textcolor>main_fg_30</textcolor>
                            <label>$INFO[Container($PARAM[id]).ListItem(-1).Label]</label>
                            <visible>Integer.IsGreater(Container($PARAM[id]).NumItems,1)</visible>
                            <animation effect="fade" start="100" end="0" delay="200" time="300" condition="!Container($PARAM[id]).OnScrollNext + !Container($PARAM[id]).OnScrollPrevious" reversible="false">Conditional</animation>
                        </control> -->
                        <control type="grouplist">

                            <orientation>horizontal</orientation>
                            <itemgap>30</itemgap>
                            <width>800</width>
                            <control type="label">
                                <height>80</height>
                                <width max="640">auto</width>
                                <centertop>50%</centertop>
                                <font>font_main_bold</font>
                                <textcolor>main_fg_30</textcolor>
                                <textcolor>main_fg_100</textcolor>
                                <label>$INFO[Container($PARAM[id]).ListItem.Label]</label>
                                <!-- <animation effect="fade" start="100" end="0" delay="200" time="300" condition="!Container($PARAM[id]).OnScrollNext + !Container($PARAM[id]).OnScrollPrevious" reversible="false">Conditional</animation> -->
                                <animation effect="fade" start="100" end="0" delay="100" time="200" condition="!Container($PARAM[id]).OnScrollNext" reversible="false">Conditional</animation>
                            </control>
                            <control type="label">
                                <height>80</height>
                                <width max="640">auto</width>
                                <centertop>50%</centertop>
                                <font>font_main</font>
                                <textcolor>main_fg_30</textcolor>
                                <label>$INFO[Container($PARAM[id]).ListItem(1).Label]</label>
                                <visible>Integer.IsGreater(Container($PARAM[id]).NumItems,1)</visible>
                            </control>
                            <control type="label">
                                <height>80</height>
                                <width max="640">auto</width>
                                <centertop>50%</centertop>
                                <font>font_main</font>
                                <textcolor>main_fg_30</textcolor>
                                <label>$INFO[Container($PARAM[id]).ListItem(2).Label]</label>
                                <visible>Integer.IsGreater(Container($PARAM[id]).NumItems,2)</visible>
                            </control>
                            <control type="label">
                                <height>80</height>
                                <width max="640">auto</width>
                                <centertop>50%</centertop>
                                <font>font_main</font>
                                <textcolor>main_fg_30</textcolor>
                                <label>$INFO[Container($PARAM[id]).ListItem(3).Label]</label>
                                <visible>Integer.IsGreater(Container($PARAM[id]).NumItems,3)</visible>
                            </control>
                        </control>
                    </control>
                    <control type="label">
                        <height>80</height>
                        <width max="640">auto</width>
                        <centertop>50%</centertop>
                        <font>font_main_bold</font>
                        <textcolor>main_fg_100</textcolor>
                        <label>$INFO[Container($PARAM[id]).ListItem.Label]</label>
                    </control>
                </control>
            </control>
        </definition>
    </include>

    <include name="Categories_Selector_ControlList">
        <param name="hidden_button" />
        <param name="hidden_button_enabled">false</param>
        <definition>
            <control type="wraplist" id="$PARAM[id]">
                <!-- <animation effect="slide" start="0" end="-60" time="400" tween="quadratic" easing="out" condition="!Container($PARAM[id]).OnScrollNext" reversible="false">Conditional</animation>
                <animation effect="slide" start="0" end="60" time="400" tween="quadratic" easing="out" condition="!Container($PARAM[id]).OnScrollPrevious" reversible="false">Conditional</animation> -->
                <orientation>horizontal</orientation>
                <height>80</height>
                <focusposition>0</focusposition>
                <movement>0</movement>
                <preloaditems>2</preloaditems>
                <width>720</width>
                <!-- <onclick>RunScript(script.skinvariables,run_selectfocusdialog=$PARAM[id],"header=$VAR[Label_CategorySelectList]")</onclick> -->
                <scrolltime tween="quadratic">0</scrolltime>
                <itemlayout width="0" height="80">
                </itemlayout>
                <focusedlayout width="640" height="80">
                    <control type="button">
                        <left>40</left>
                        <right>-40</right>
                        <width max="640">auto</width>
                        <height>70</height>
                        <centertop>50%</centertop>
                        <aligny>center</aligny>
                        <include>Texture_Highlight_Underline_FakeFocus_H</include>
                        <font>font_main_bold</font>
                        <textcolor>00ffffff</textcolor>
                        <focusedcolor>00ffffff</focusedcolor>
                        <selectedcolor>00ffffff</selectedcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <textoffsetx>0</textoffsetx>
                        <visible>Control.HasFocus($PARAM[id]) | Control.HasFocus($PARAM[altfocusid])</visible>
                        <hitrect x="0" y="0" w="0" h="0" />
                        <include content="$PARAM[hidden_button]_OnFocus" condition="$PARAM[hidden_button_enabled]">
                            <param name="id">$PARAM[id]</param>
                            <param name="container">Container($PARAM[id]).</param>
                            <param name="prefix">$PARAM[hidden_button_prefix]</param>
                        </include>
                    </control>
                </focusedlayout>
                <nested />
            </control>
        </definition>
    </include>

    <include name="Categories_Selector">
        <param name="id">300</param>
        <param name="hidden_button" />
        <param name="hidden_button_enabled">false</param>
        <definition>
            <include content="Categories_Selector_ControlList">
                <param name="id">$PARAM[id]</param>
                <param name="altfocusid">$PARAM[altfocusid]</param>
                <param name="hidden_button">$PARAM[hidden_button]</param>
                <param name="hidden_button_prefix">$PARAM[hidden_button_prefix]</param>
                <param name="hidden_button_enabled">$PARAM[hidden_button_enabled]</param>
                <hitrect x="0" y="0" w="0" h="0" />
                <nested />
            </include>

            <include content="Categories_Selector_OverlayList">
                <param name="id">$PARAM[id]</param>
                <param name="altfocusid">$PARAM[altfocusid]</param>
                <nested />
            </include>

        </definition>
    </include>
</includes>