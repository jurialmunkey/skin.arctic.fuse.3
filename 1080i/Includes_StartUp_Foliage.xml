<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="Background_StartUp_FoliageParticle">
        <param name="size">36</param>
        <param name="travel">1640,440</param>
        <param name="time">48000</param>
        <param name="fadeout">45500</param>
        <param name="lilt_time">4200</param>
        <param name="flutter_time">2900</param>
        <param name="fadein_time">1800</param>
        <param name="fadeout_time">2500</param>
        <param name="lilt_start">-22,-32</param>
        <param name="lilt_end">22,32</param>
        <param name="rotation_start">-38</param>
        <param name="rotation_end">42</param>
        <param name="flipx">false</param>
        <definition>
            <control type="group">
                <left>$PARAM[left]</left>
                <top>$PARAM[top]</top>
                <!-- Independent of flutter: diagonal travel with a separate gust and tumble.
                     Fade before wrapping so an on-screen starting point never jumps. -->
                <animation type="Conditional" condition="true" reversible="false" loop="true">
                    <effect type="slide" start="0,0" end="$PARAM[travel]" time="$PARAM[time]" />
                    <effect type="fade" start="0" end="100" time="$PARAM[fadein_time]" />
                    <effect type="fade" start="100" end="0" time="$PARAM[fadeout_time]" delay="$PARAM[fadeout]" />
                </animation>
                <control type="group">
                    <!-- Lilt can lift the particle against its travel; unequal periods
                         keep the broad sway and small flutter from moving in lockstep. -->
                    <animation effect="slide" start="$PARAM[lilt_start]" end="$PARAM[lilt_end]" time="$PARAM[lilt_time]" tween="sine" easing="inout" pulse="true" condition="true" reversible="false">Conditional</animation>
                    <control type="image">
                        <width>$PARAM[size]</width>
                        <height>$PARAM[size]</height>
                        <aspectratio>keep</aspectratio>
                        <texture flipx="$PARAM[flipx]">special://home/addons/resource.images.arctic.splash/resources/effects/foliage/$PARAM[season]/$PARAM[hour].png</texture>
                        <fadetime>background_fadetime</fadetime>
                        <animation effect="rotate" start="$PARAM[rotation_start]" end="$PARAM[rotation_end]" center="auto" time="$PARAM[lilt_time]" tween="sine" easing="inout" pulse="true" condition="true" reversible="false">Conditional</animation>
                        <animation effect="rotatey" start="-58" end="58" center="auto" time="$PARAM[flutter_time]" tween="sine" easing="inout" pulse="true" condition="true" reversible="false">Conditional</animation>
                    </control>
                </control>
            </control>
        </definition>
    </include>

