<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="Vert_Line">
        <param name="colordiffuse">44ff0000</param>
        <definition>
            <control type="image">
                <top>-1</top>
                <height>1</height>
                <texture colordiffuse="$PARAM[colordiffuse]">common/white.png</texture>
            </control>
        </definition>
    </include>

    <include name="Vert_Line_5">
        <include>Vert_Line</include>
        <include>Vert_Line</include>
        <include>Vert_Line</include>
        <include>Vert_Line</include>
        <include>Vert_Line</include>
    </include>

    <include name="Horz_Red_Line">
        <control type="image">
            <left>-1</left>
            <width>1</width>
            <texture colordiffuse="44ff0000">common/white.png</texture>
        </control>
    </include>

    <include name="Horz_Red_Line_5">
        <include>Horz_Red_Line</include>
        <include>Horz_Red_Line</include>
        <include>Horz_Red_Line</include>
        <include>Horz_Red_Line</include>
        <include>Horz_Red_Line</include>
    </include>

    <variable name="Overlay_InfoLabel_HasModal">
        <value condition="System.HasActiveModalDialog">True</value>
        <value>False</value>
    </variable>

    <variable name="Overlay_IsUpdating">
        <value condition="!String.IsEmpty(Window(Home).Property(TMDBHelper.IsUpdating))">$VAR[_Overlay_IsUpdating_Details,,  ]$VAR[_Overlay_IsUpdating_Ratings,,  ]$VAR[_Overlay_IsUpdating_Artwork,,  ]</value>
        <value>DONE</value>
    </variable>

    <variable name="_Overlay_IsUpdating_Details">
        <value condition="!String.IsEmpty(Window(Home).Property(TMDBHelper.IsUpdatingDetails))">Details</value>
    </variable>
    <variable name="_Overlay_IsUpdating_Ratings">
        <value condition="!String.IsEmpty(Window(Home).Property(TMDBHelper.IsUpdatingRatings))">Ratings</value>
    </variable>
    <variable name="_Overlay_IsUpdating_Artwork">
        <value condition="!String.IsEmpty(Window(Home).Property(TMDBHelper.IsUpdatingArtwork))">Artwork</value>
    </variable>

    <include name="Overlay_InfoLabel">
        <definition>
            <control type="button" id="$PARAM[id]">
                <nested />
                <texturenofocus colordiffuse="shadow_full">common/white.png</texturenofocus>
                <textoffsetx>0</textoffsetx>
                <aligny>center</aligny>
                <height>40</height>
                <font>font_tiny</font>
                <align>left</align>
                <textcolor>magenta</textcolor>
                <width>auto</width>
            </control>
        </definition>
    </include>

    <include name="Overlay_DebugGrid">
        <control type="group">

            <!-- Vertical 40 px lines -->
            <control type="grouplist">
                <itemgap>40</itemgap>
                <orientation>vertical</orientation>
                <include>Vert_Line_5</include>
                <include>Vert_Line_5</include>
                <include>Vert_Line_5</include>
                <include>Vert_Line_5</include>
                <include>Vert_Line_5</include>
                <include>Vert_Line</include>
                <include>Vert_Line</include>
            </control>

            <!-- Horizontal 40 px lines -->
            <control type="grouplist">
                <itemgap>40</itemgap>
                <orientation>horizontal</orientation>
                <include>Horz_Red_Line_5</include>
                <include>Horz_Red_Line_5</include>
                <include>Horz_Red_Line_5</include>
                <include>Horz_Red_Line_5</include>
                <include>Horz_Red_Line_5</include>
                <include>Horz_Red_Line_5</include>
                <include>Horz_Red_Line_5</include>
                <include>Horz_Red_Line_5</include>
                <include>Horz_Red_Line_5</include>
                <include>Horz_Red_Line</include>
                <include>Horz_Red_Line</include>
                <include>Horz_Red_Line</include>
            </control>

            <!-- Screen Padding Lines -->
            <control type="image">
                <top>80</top>
                <height>1</height>
                <texture colordiffuse="red">common/white.png</texture>
            </control>
            <control type="image">
                <bottom>80</bottom>
                <height>1</height>
                <texture colordiffuse="red">common/white.png</texture>
            </control>
            <control type="image">
                <left>80</left>
                <width>1</width>
                <texture colordiffuse="red">common/white.png</texture>
            </control>
            <control type="image">
                <right>80</right>
                <width>1</width>
                <texture colordiffuse="red">common/white.png</texture>
            </control>

            <!-- Outer Border Lines -->
            <control type="image">
                <top>120</top>
                <height>1</height>
                <texture colordiffuse="red">common/white.png</texture>
            </control>
            <control type="image">
                <bottom>120</bottom>
                <height>1</height>
                <texture colordiffuse="red">common/white.png</texture>
            </control>
            <control type="image">
                <left>120</left>
                <width>1</width>
                <texture colordiffuse="red">common/white.png</texture>
            </control>

            <!-- Inner Border Lines -->
            <control type="image">
                <top>view_top</top>
                <height>1</height>
                <texture colordiffuse="red">common/white.png</texture>
            </control>
            <control type="image">
                <bottom>view_top</bottom>
                <height>1</height>
                <texture colordiffuse="red">common/white.png</texture>
            </control>
            <control type="image">
                <left>view_pad</left>
                <width>1</width>
                <texture colordiffuse="red">common/white.png</texture>
            </control>

            <control type="group">
                <top>240</top>
                <height>view_poster_item_h</height>
                <control type="image">
                    <top>-40</top>
                    <height>1</height>
                    <texture colordiffuse="cyan">common/white.png</texture>
                </control>
                <control type="image">
                    <top>0</top>
                    <height>1</height>
                    <texture colordiffuse="cyan">common/white.png</texture>
                </control>
                <control type="image">
                    <bottom>0</bottom>
                    <height>1</height>
                    <texture colordiffuse="cyan">common/white.png</texture>
                </control>
            </control>

            <control type="group">
                <bottom>180</bottom>
                <height>view_poster_item_h</height>
                <control type="image">
                    <top>0</top>
                    <height>1</height>
                    <texture colordiffuse="cyan">common/white.png</texture>
                </control>
                <control type="image">
                    <bottom>0</bottom>
                    <height>1</height>
                    <texture colordiffuse="cyan">common/white.png</texture>
                </control>
            </control>

            <control type="image">
                <bottom>90</bottom>
                <height>1</height>
                <texture colordiffuse="cyan">common/white.png</texture>
            </control>
            <control type="image">
                <bottom>50</bottom>
                <height>1</height>
                <texture colordiffuse="cyan">common/white.png</texture>
            </control>

            <!-- Center Lines -->
            <control type="image">
                <centertop>50%</centertop>
                <height>1</height>
                <texture colordiffuse="blue">common/white.png</texture>
            </control>
            <control type="image">
                <centerleft>50%</centerleft>
                <width>1</width>
                <texture colordiffuse="blue">common/white.png</texture>
            </control>
            <control type="image">
                <centerleft>25%</centerleft>
                <width>1</width>
                <texture colordiffuse="550000ff">common/white.png</texture>
            </control>
            <control type="image">
                <centerleft>75%</centerleft>
                <width>1</width>
                <texture colordiffuse="550000ff">common/white.png</texture>
            </control>

        </control>
    </include>

    <variable name="Overlay_WidgetContainer">
        <value condition="Window.IsVisible(10000)">$INFO[Window(10000).Property(TMDbHelper.WidgetContainer),, ](10000)</value>
        <value condition="Window.IsVisible(11101)">$INFO[Window(11101).Property(TMDbHelper.WidgetContainer),, ](11101)</value>
        <value condition="Window.IsVisible(11102)">$INFO[Window(11102).Property(TMDbHelper.WidgetContainer),, ](11102)</value>
        <value condition="Window.IsVisible(11103)">$INFO[Window(11103).Property(TMDbHelper.WidgetContainer),, ](11103)</value>
        <value condition="Window.IsVisible(11104)">$INFO[Window(11104).Property(TMDbHelper.WidgetContainer),, ](11104)</value>
        <value condition="Window.IsVisible(11106)">$INFO[Window(11106).Property(TMDbHelper.WidgetContainer),, ](11106)</value>
        <value condition="Window.IsVisible(11107)">$INFO[Window(11107).Property(TMDbHelper.WidgetContainer),, ](11107)</value>
        <value condition="Window.IsVisible(11108)">$INFO[Window(11108).Property(TMDbHelper.WidgetContainer),, ](11108)</value>
        <value condition="Window.IsVisible(11109)">$INFO[Window(11109).Property(TMDbHelper.WidgetContainer),, ](11109)</value>
        <value condition="Window.IsVisible(videos)">$INFO[Window(videos).Property(TMDbHelper.WidgetContainer)],, (videos)</value>
        <value condition="Window.IsVisible(music)">$INFO[Window(music).Property(TMDbHelper.WidgetContainer),, ](music)</value>
        <value condition="Window.IsVisible(pictures)">$INFO[Window(pictures).Property(TMDbHelper.WidgetContainer)](p,, ictures)</value>
        <value condition="Window.IsVisible(programs)">$INFO[Window(programs).Property(TMDbHelper.WidgetContainer)](p,, rograms)</value>
        <value condition="Window.IsVisible(games)">$INFO[Window(games).Property(TMDbHelper.WidgetContainer),, ](games)</value>
        <value condition="Window.IsVisible(tvchannels)">$INFO[Window(tvchannels).Property(TMDbHelper.WidgetContainer)](tvc,, hannels)</value>
        <value condition="Window.IsVisible(tvsearch)">$INFO[Window(tvsearch).Property(TMDbHelper.WidgetContainer)](t,, vsearch)</value>
        <value condition="Window.IsVisible(tvguide)">$INFO[Window(tvguide).Property(TMDbHelper.WidgetContainer)](,, tvguide)</value>
        <value condition="Window.IsVisible(tvrecordings)">$INFO[Window(tvrecordings).Property(TMDbHelper.WidgetContainer)](tvrec,, ordings)</value>
        <value condition="Window.IsVisible(tvtimers)">$INFO[Window(tvtimers).Property(TMDbHelper.WidgetContainer)](t,, vtimers)</value>
    </variable>

    <include name="Overlay_DebugInfo">
        <control type="group">
            <control type="grouplist">
                <align>bottom</align>
                <orientation>vertical</orientation>
                <control type="grouplist">
                    <height>40</height>
                    <align>right</align>
                    <orientation>horizontal</orientation>
                    <include content="Overlay_InfoLabel">
                        <label>$INFO[Window(Home).Property(TMDbHelper.ListItem.base_title),title: , ]$INFO[Window(Home).Property(TMDbHelper.ListItem.base_year),year: , ]</label>
                        <textcolor>magenta</textcolor>
                    </include>
                </control>
                <control type="grouplist">
                    <height>40</height>
                    <align>right</align>
                    <orientation>horizontal</orientation>
                    <include content="Overlay_InfoLabel">
                        <label>$INFO[Window(Home).Property(TMDbHelper.ListItem.Title),title: , ]$INFO[Window(Home).Property(TMDbHelper.ListItem.Year),year: , ]</label>
                        <textcolor>cyan</textcolor>
                    </include>
                </control>
                <control type="grouplist">
                    <height>40</height>
                    <align>right</align>
                    <orientation>horizontal</orientation>
                    <include content="Overlay_InfoLabel">
                        <label>$INFO[Window(Home).Property(TMDbHelper.ListItem.base_tmdb_id),tmdb_id: , ]$INFO[Window(Home).Property(TMDbHelper.ListItem.base_imdb_id),imdb_id: , ]$INFO[Window(Home).Property(TMDbHelper.ListItem.base_tvdb_id),tvdb_id: , ]</label>
                        <textcolor>magenta</textcolor>
                    </include>
                </control>
                <control type="grouplist">
                    <height>40</height>
                    <align>right</align>
                    <orientation>horizontal</orientation>
                    <include content="Overlay_InfoLabel">
                        <label>$INFO[System.CurrentControl, , ]</label>
                        <textcolor>blueviolet</textcolor>
                    </include>
                </control>
            </control>
            <control type="grouplist">
                <align>top</align>
                <orientation>vertical</orientation>
                <include content="Overlay_InfoLabel">
                    <label> -system.currentcontrolid: $INFO[System.CurrentControlID,, | ]$INFO[System.CurrentControl,, | ]$INFO[System.CurrentWindow,, | ]$VAR[Overlay_InfoLabel_HasModal,has_modal: ,]</label>
                    <textcolor>yellowgreen</textcolor>
                </include>
                <include content="Overlay_InfoLabel">
                    <label> -tmdbhelper.windowmanager: $INFO[Window(Home).Property(TMDBHelper.ListItem.Monitor.TMDb_ID),TMDb_ID: , ]$INFO[Window(Home).Property(TMDBHelper.ListItem.Monitor.TMDb_Type),TMDb_Type: , ]$INFO[Window(Home).Property(TMDBHelper.ListItem.Monitor.Season),Season: , ]$INFO[Window(Home).Property(TMDBHelper.ListItem.Monitor.Episode),Episode: , ]$INFO[Window(Home).Property(TMDbHelper.Instance),instance: , ]$INFO[Window(Home).Property(TMDBHelper.Position),position: , ]</label>
                    <textcolor>yellowgreen</textcolor>
                </include>
                <include content="Overlay_InfoLabel">
                    <label> -tmdbhelper.isupdating: $INFO[Window(Home).Property(TMDBHelper.CurrentWindow),window: , ]$VAR[Overlay_WidgetContainer,widget: , ]$VAR[Overlay_IsUpdating,service: , ]</label>
                    <textcolor>yellowgreen</textcolor>
                </include>
            </control>
            <control type="grouplist">
                <align>bottom</align>
                <orientation>vertical</orientation>
                <include content="Overlay_InfoLabel">
                    <label> -content.dbtype:$INFO[Container.Content, container: , |]$INFO[ListItem.DBType, listitem: ,]$INFO[ListItem.Property(tmdb_type), (,)]$INFO[Window(Home).Property(TMDbHelper.ListItem.base_dbtype), | TMDbHelper: , ]$INFO[Window(Home).Property(TMDbHelper.ListItem.Monitor.TMDb_Type),(,)]</label>
                    <textcolor>cyan</textcolor>
                </include>
                <include content="Overlay_InfoLabel">
                    <label> -container.folderpath: $INFO[Container.FolderPath] </label>
                    <textcolor>magenta</textcolor>
                </include>
                <include content="Overlay_InfoLabel">
                    <label> -listitem.folderpath: $INFO[ListItem.FolderPath] </label>
                    <textcolor>blueviolet</textcolor>
                </include>
            </control>
        </control>
    </include>

</includes>