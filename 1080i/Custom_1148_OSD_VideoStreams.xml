<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1148">

    <defaultcontrol always="true">6008</defaultcontrol>
    <!-- Runs after the open animation is queued, so a switch from another stream dialog still skips it -->
    <onload>ClearProperty(OSD.StreamSwitch,home)</onload>

    <controls>

        <control type="group">
            <include>OSD_HideControls</include>
            <left>view_pad</left>
            <right>view_pad</right>

            <visible>!Window.IsActive(DialogPlayerProcessInfo.xml)</visible>

            <control type="group">
                <include content="OSD_Stream_Row">
                    <param name="id">6208</param>
                    <param name="buttonid">6008</param>
                    <content>
                        <!-- Speed row: laid out like the offset rows (slider property), opening the playback speed ruler -->
                        <item>
                            <label>$VAR[Label_OSD_PlaybackSpeed]</label>
                            <label2>$LOCALIZE[31071]</label2>
                            <icon>special://skin/extras/icons/gauge.png</icon>
                            <property name="slider">true</property>
                            <property name="detail">$INFO[Player.Process(videofps),, $LOCALIZE[31259]]</property>
                            <onclick>ActivateWindow(1149)</onclick>
                        </item>
                        <item>
                            <label>$INFO[VideoPlayer.VideoResolution]</label>
                            <label2>$LOCALIZE[31207]</label2>
                            <icon>special://skin/extras/icons/video.png</icon>
                            <property name="tags">$INFO[VideoPlayer.VideoCodec,&#x2002;,&#x2000;&#x2005;&#x2005;&#x2005;]$VAR[Label_VideoHDRCodec,&#x2002;,&#x2000;&#x2005;&#x2005;&#x2005;]$INFO[VideoPlayer.VideoAspect,&#x2002;,:1&#x2000;]</property>
                            <onclick>Action(PlayerProcessInfo)</onclick>
                        </item>
                    </content>
                </include>
            </control>

            <include content="OSD_Stream_Spotlight">
                <param name="header">$LOCALIZE[157]</param>
            </include>

            <control type="group">
                <visible>!$EXP[Exp_OSD_SliderVisible]</visible>
                <include content="OSD_CustomDialog_GroupList">
                    <param name="onclick">ActivateWindow(osdvideosettings)</param>
                    <param name="onup">SetFocus(6208)</param>
                    <param name="icon">special://skin/extras/icons/video.png</param>
                    <param name="button_8">true</param>
                </include>
            </control>
        </control>

    </controls>
</window>
