                <param name="visible">$PARAM[visible] + !$PARAM[is_8k] + !$PARAM[is_4k] + !$PARAM[is_fd] + !$PARAM[is_hd] + !$PARAM[is_sd]</param>
                <param name="width">60</param>
            </include>
        </definition>
    </include>

    <include name="Info_Line_VideoQuality_HDRType_U3k">
        <param name="visible">true</param>
        <definition>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Dolby Vision</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[container]$PARAM[listitem].HdrType,dolbyvision) + !String.IsEqual($PARAM[container]$PARAM[listitem].AudioCodec,ac3) + !String.IsEqual($PARAM[container]$PARAM[listitem].AudioCodec,dolbydigital) + !String.IsEqual($PARAM[container]$PARAM[listitem].AudioCodec,eac3) + !String.IsEqual($PARAM[container]$PARAM[listitem].AudioCodec,eac3_ddp_atmos) + !String.IsEqual($PARAM[container]$PARAM[listitem].AudioCodec,truehd) + !String.IsEqual($PARAM[container]$PARAM[listitem].AudioCodec,truehd_atmos)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
