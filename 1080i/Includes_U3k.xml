            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">SDR</param>
                <param name="visible">$PARAM[visible] + [String.IsEmpty($PARAM[container]$PARAM[listitem].HdrType) + [[!String.IsEmpty($PARAM[container]$PARAM[listitem].VideoResolution)] | [Integer.IsEqual($PARAM[container]$PARAM[listitem].VideoResolution,720)] | [Integer.IsGreater($PARAM[container]$PARAM[listitem].VideoResolution,720)] | Integer.IsGreater($PARAM[container]$PARAM[listitem].VideoResolution,1080) | Integer.IsEqual($PARAM[container]$PARAM[listitem].VideoResolution,4K)]]</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Dolby Vision • TrueHD</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[container]$PARAM[listitem].HdrType,dolbyvision) + String.IsEqual($PARAM[container]$PARAM[listitem].AudioCodec,truehd)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Dolby Vision • TrueHD (Atmos)</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[container]$PARAM[listitem].HdrType,dolbyvision) + String.IsEqual($PARAM[container]$PARAM[listitem].AudioCodec,truehd_atmos)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Dolby Vision • Digital</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[container]$PARAM[listitem].HdrType,dolbyvision) + String.IsEqual($PARAM[container]$PARAM[listitem].AudioCodec,ac3) + String.IsEqual($PARAM[container]$PARAM[listitem].AudioCodec,dolbydigital)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Dolby Vision • Digital Plus</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[container]$PARAM[listitem].HdrType,dolbyvision) + String.IsEqual($PARAM[container]$PARAM[listitem].AudioCodec,eac3)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Dolby Vision • Digital Plus (Atmos)</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[container]$PARAM[listitem].HdrType,dolbyvision) + String.IsEqual($PARAM[container]$PARAM[listitem].AudioCodec,eac3_ddp_atmos)</param>
                <param name="width">auto</param>
            </include>
        </definition>
