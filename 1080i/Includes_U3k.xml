            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">HLG</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[container]$PARAM[listitem].HdrType,hlg)</param>
                <param name="width">auto</param>
