    <include name="Info_Line_TwoRow_U3k">
        <param name="visible">true</param>
        <param name="left">40</param>
        <param name="listitem">ListItem</param>
        <param name="override">false</param>
        <definition>
            <control type="group">
                <visible>$PARAM[visible] + Skin.HasSetting(InfoBar.TwoRow)</visible>
                <left>$PARAM[left]</left>
                <height>105</height>

                <visible>[String.IsEqual($PARAM[container]$PARAM[listitem].DBType,movie) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,tvshow) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,season) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,episode) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,video) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,album) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,song) | $PARAM[override]]</visible>


                <control type="grouplist">
                    <hitrect x="0" y="0" w="0" h="0" />
                    <orientation>horizontal</orientation>
                    <itemgap>10</itemgap>
                    <left>-20</left>
                    <centertop>35</centertop>
                    <control type="group" description="Avoid grouplist chop with spacer">
                        <left>-10</left>
                        <width>20</width>
                    </control>

                    <!-- Info Pill -->
                    <include content="Info_Line_VideoQuality_Resolution_U3k">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="is_8k">[Integer.IsGreater($PARAM[container]$PARAM[listitem].VideoResolution,2160) | String.IsEqual($PARAM[container]$PARAM[listitem].VideoResolution,8K)]</param>
                        <param name="is_4k">[Integer.IsGreater($PARAM[container]$PARAM[listitem].VideoResolution,1080) | String.IsEqual($PARAM[container]$PARAM[listitem].VideoResolution,4K)]</param>
                        <param name="is_fd">[Integer.IsGreater($PARAM[container]$PARAM[listitem].VideoResolution,720)]</param>
                        <param name="is_hd">[Integer.IsEqual($PARAM[container]$PARAM[listitem].VideoResolution,720)]</param>
                        <param name="is_sd">[!String.IsEmpty($PARAM[container]$PARAM[listitem].VideoResolution)]</param>
                    </include>
                    <include content="Info_Line_VideoQuality_HDRType_U3k" condition="Skin.HasSetting(InfoTags.EnableHDR)">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="container">$PARAM[container]</param>
                        <param name="listitem">$PARAM[listitem]</param>
                    </include>
                    <include content="Info_Line_AudioCodec" condition="Skin.HasSetting(InfoTags.EnableAudioCodec)">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="container">$PARAM[container]</param>
                        <param name="listitem">$PARAM[listitem]</param>
                    </include>
                    <include content="Info_Line_AudioChannels_Resolution" condition="Skin.HasSetting(InfoTags.EnableAudioChannels)">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="container">$PARAM[container]</param>
                        <param name="listitem">$PARAM[listitem]</param>
                    </include>
				</control>
                <control type="grouplist">
                    <hitrect x="0" y="0" w="0" h="0" />
                    <orientation>horizontal</orientation>
                    <itemgap>10</itemgap>
                    <left>-20</left>
					<centertop>75</centertop>
                    <control type="group" description="Avoid grouplist chop with spacer">
                        <left>-10</left>
                        <width>20</width>
                    </control>

                    <!-- Star Rating -->
                    <include content="Info_Line_StarRating" condition="!Skin.HasSetting(InfoTags.DisableStarRating)">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="rating">$PARAM[container]$PARAM[listitem].Rating</param>
                        <param name="visible">!String.IsEmpty($PARAM[container]$PARAM[listitem].Rating) + String.IsEmpty($PARAM[container]$PARAM[listitem].UserRating)</param>
                    </include>
                    <include content="Info_Line_StarRating" condition="!Skin.HasSetting(InfoTags.DisableStarRating)">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="rating">$PARAM[container]$PARAM[listitem].UserRating</param>
                        <param name="visible">!String.IsEmpty($PARAM[container]$PARAM[listitem].UserRating)</param>
                    </include>

                    <!-- ====== -->
                    <!-- Labels -->
                    <!-- ====== -->

                    <!-- Gender -->
                    <include content="Info_Line_Label">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="label">$INFO[$PARAM[container]ListItem.Property(gender)]</param>
                        <param name="visible">!String.IsEmpty($PARAM[container]$PARAM[listitem].Property(gender)) + [String.IsEqual($PARAM[container]$PARAM[listitem].DBType,actor) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,video)]</param>
                    </include>

                    <!-- Department -->
                    <include content="Info_Line_Label">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="label">$INFO[$PARAM[container]ListItem.Property(department)]</param>
                        <param name="visible">!String.IsEmpty($PARAM[container]$PARAM[listitem].Property(department)) + [String.IsEqual($PARAM[container]$PARAM[listitem].DBType,actor) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,video)]</param>
                    </include>

                    <!-- Age -->
                    <include content="Info_Line_Label">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="label">$INFO[$PARAM[container]ListItem.Property(Age),, $LOCALIZE[31057]]</param>
                        <param name="visible">!String.IsEmpty($PARAM[container]$PARAM[listitem].Property(age)) + [String.IsEqual($PARAM[container]$PARAM[listitem].DBType,actor) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,video)]</param>
                    </include>

                    <!-- Premiered -->
                    <include content="Info_Line_Label">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="label">$INFO[$PARAM[container]$PARAM[listitem].Premiered]</param>
                        <param name="visible">!String.IsEmpty($PARAM[container]$PARAM[listitem].Premiered) + [String.IsEqual($PARAM[container]$PARAM[listitem].DBType,movie) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,tvshow) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,episode) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,season) | $PARAM[override]]</param>
                    </include>

                    <!-- MPAA -->
                    <include content="Info_Line_Label">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="label">$INFO[$PARAM[container]$PARAM[listitem].MPAA]</param>
                        <param name="visible">!String.IsEmpty($PARAM[container]$PARAM[listitem].MPAA) + [String.IsEqual($PARAM[container]$PARAM[listitem].DBType,movie) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,tvshow) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,episode) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,season) | $PARAM[override]]</param>
                    </include>

                    <!-- Year -->
                    <include content="Info_Line_Label">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="label">$INFO[$PARAM[container]$PARAM[listitem].Year]</param>
                        <param name="visible">!String.IsEmpty($PARAM[container]$PARAM[listitem].Year) + [String.IsEqual($PARAM[container]$PARAM[listitem].DBType,album) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,song)]</param>
                    </include>

                    <!-- Album Label -->
                    <include content="Info_Line_Label">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="label">$INFO[$PARAM[container]$PARAM[listitem].Property(album_label)]</param>
                        <param name="visible">!String.IsEmpty($PARAM[container]$PARAM[listitem].Property(album_label)) + [String.IsEqual($PARAM[container]$PARAM[listitem].DBType,album) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,song)]</param>
                    </include>

                    <!-- Duration -->
                    <include content="Info_Line_Label">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="label">$INFO[$PARAM[container]$PARAM[listitem].Duration]</param>
                        <param name="visible">!String.IsEmpty($PARAM[container]$PARAM[listitem].Duration) + [String.IsEqual($PARAM[container]$PARAM[listitem].DBType,album) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,song)]</param>
                    </include>
                    <include content="Info_Line_Label">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="label">$INFO[$PARAM[container]$PARAM[listitem].Duration(h),, $LOCALIZE[31074] ]$INFO[$PARAM[container]$PARAM[listitem].Duration(m),, $LOCALIZE[31073]]</param>
                        <param name="visible">!String.IsEmpty($PARAM[container]$PARAM[listitem].Duration) + !Integer.IsEqual($PARAM[container]$PARAM[listitem].Duration(h),0) + [String.IsEqual($PARAM[container]$PARAM[listitem].DBType,movie) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,tvshow) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,episode) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,season) | $PARAM[override]]</param>
                    </include>
                    <include content="Info_Line_Label">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="label">$INFO[$PARAM[container]$PARAM[listitem].Duration(m),, $LOCALIZE[31073]]</param>
                        <param name="visible">!String.IsEmpty($PARAM[container]$PARAM[listitem].Duration) + Integer.IsEqual($PARAM[container]$PARAM[listitem].Duration(h),0) + [String.IsEqual($PARAM[container]$PARAM[listitem].DBType,movie) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,tvshow) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,episode) | String.IsEqual($PARAM[container]$PARAM[listitem].DBType,season) | $PARAM[override]]</param>
                    </include>

                </control>
            </control>
        </definition>
    </include>

    <include name="Info_Line_VideoQuality_Resolution_U3k">
        <param name="visible">true</param>
        <definition>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">8K</param>
                <param name="visible">$PARAM[visible] + $PARAM[is_8k]</param>
                <param name="width">60</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">4K Ultra HD</param>
                <param name="visible">$PARAM[visible] + !$PARAM[is_8k] + $PARAM[is_4k]</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Full HD</param>
                <param name="visible">$PARAM[visible] + !$PARAM[is_8k] + !$PARAM[is_4k] + $PARAM[is_fd]</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">HD</param>
                <param name="visible">$PARAM[visible] + !$PARAM[is_8k] + !$PARAM[is_4k] + !$PARAM[is_fd] + $PARAM[is_hd]</param>
                <param name="width">60</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">SD</param>
                <param name="visible">$PARAM[visible] + !$PARAM[is_8k] + !$PARAM[is_4k] + !$PARAM[is_fd] + !$PARAM[is_hd] + $PARAM[is_sd]</param>
