<?xml version="1.0" encoding="UTF-8"?>
<window>
    <onload>ClearProperty(OSDRelaunchFullscreen,Home)</onload>
    <!-- Scene Selection (Pavan mod): open the chapter picker once playback has started -->
    <onload condition="!String.IsEmpty(Window(Home).Property(AF3.SceneSelect))">CancelAlarm(af3scenes,true)</onload>
    <onload condition="!String.IsEmpty(Window(Home).Property(AF3.SceneSelect))">AlarmClock(af3scenes,ActivateWindow(videobookmarks),00:03,silent)</onload>
    <onload>ClearProperty(AF3.SceneSelect,Home)</onload>
    <controls>
        <control type="grouplist" id="0">
            <orientation>vertical</orientation>
            <centertop>100</centertop>
            <height>120</height>
            <left>80</left>
            <include content="Overlay_InfoLabel">
                <param name="id">10</param>
                <textcolor>panel_fg_100</textcolor>
                <textoffsetx>10</textoffsetx>
                <font>font_mini</font>
            </include>
            <include content="Overlay_InfoLabel">
                <param name="id">11</param>
                <textcolor>panel_fg_100</textcolor>
                <textoffsetx>10</textoffsetx>
                <font>font_mini</font>
            </include>
            <include content="Overlay_InfoLabel">
                <param name="id">12</param>
                <textcolor>panel_fg_100</textcolor>
                <textoffsetx>10</textoffsetx>
                <font>font_mini</font>
            </include>
        </control>
    </controls>
</window>