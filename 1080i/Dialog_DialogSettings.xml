<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <include name="DialogSettings">
        <include content="Object_Hidden_Button">
            <param name="id">30</param>
        </include>
        <include content="Object_Hidden_Button">
            <param name="id">29</param>
        </include>
        <include content="Object_Hidden_Button">
            <param name="id">28</param>
        </include>
        <!-- Over fullscreen video (the OSD video, audio and subtitle settings) the list floats on the right instead of a panel -->
        <include condition="Window.IsVisible(fullscreenvideo)">DialogSettings_OSD</include>
        <include condition="!Window.IsVisible(fullscreenvideo)">DialogSettings_Panel</include>
    </include>

    <include name="DialogSettings_Panel">
        <include>DialogSettings_Button_Templates</include>
        <include content="Part_Dim_Overlay">
            <param name="visible">!Window.IsVisible(DialogSlider.xml)</param>
        </include>
        <include>DialogSettings_Main</include>
    </include>

    <!-- OSD layout: the settings list on the right, then the dialog heading large with the key hints,
         ending above the OSD seekbar so the OSD buttons stay clear below -->
    <include name="DialogSettings_OSD">
        <include content="DialogSettings_Button_Templates">
            <param name="fg">main_fg</param>
            <param name="fill">main_fg_12</param>
            <param name="slider_focus">true</param>
        </include>
        <control type="group">
            <right>view_pad</right>
            <width>1200</width>
            <visible>!$EXP[Exp_OSD_DialogSelect] + !$EXP[Exp_OSD_DialogSubtitles]</visible>
            <include>Animation_SlideIn_Dialog</include>
            <include>DialogSettings_OSD_Heading</include>
            <include>DialogSettings_OSD_List</include>
        </control>
        <!-- Kept out of the list's group with no Visible animation, so it stays put when a slider opens and DialogSlider shows the same spotlight in its place -->
        <control type="group">
            <right>view_pad</right>
            <width>1200</width>
            <visible>!Window.IsVisible(DialogSlider.xml) + !$EXP[Exp_OSD_DialogSelect] + !$EXP[Exp_OSD_DialogSubtitles]</visible>
            <include content="Animation_SlideIn_Dialog">
                <param name="visible_condition">false</param>
            </include>
            <include>DialogSettings_OSD_Spotlight</include>
        </control>
    </include>

    <!-- Right side fade behind the OSD layout, or a full dim for the full width subtitles layout. Drawn in the seekbar layer so the seekbar and clock sit above it -->
    <include name="DialogSettings_OSD_Background">
        <control type="image">
            <right>0</right>
            <width>1040</width>
            <visible>$EXP[Exp_OSD_SpotlightList] + !$EXP[Exp_OSD_DialogSubtitles]</visible>
            <include>Animation_FadeIn</include>
            <include>Animation_FadeOut</include>
            <texture colordiffuse="shadow_back" border="0,4,0,4">common/gradient-h.png</texture>
        </control>
        <include content="Part_Dim_Overlay">
            <param name="visible">$EXP[Exp_OSD_DialogSubtitles]</param>
        </include>
    </include>

    <!-- Small label above the list with its item count. list: the list's control id -->
    <include name="DialogSettings_OSD_Heading">
        <param name="list">5</param>
        <param name="visible">true</param>
        <definition>
            <control type="label">
                <top>120</top>
                <height>40</height>
                <align>right</align>
                <font>font_hint_bold</font>
                <textcolor>main_fg_50</textcolor>
                <label>$INFO[Container($PARAM[list]).NumItems,, $LOCALIZE[31022]]</label>
                <visible>$PARAM[visible]</visible>
            </control>
        </definition>
    </include>

    <!-- Grouplist 5 shows five 80px rows. It overhangs by the controls' 40px text offset so their labels align with the heading and spotlight; scrollbar 61 sits just outside it -->
    <include name="DialogSettings_OSD_List">
        <control type="group">
            <right>-80</right>
            <width>840</width>
            <top>180</top>
            <height>400</height>
            <control type="grouplist" id="5">
                <right>40</right>
                <pagecontrol>61</pagecontrol>
                <onright>61</onright>
            </control>
            <include content="DialogSettings_OSD_Scrollbar">
                <top>0</top>
                <bottom>0</bottom>
                <centerright>20</centerright>
                <onleft>5</onleft>
            </include>
        </control>
    </include>

    <include name="DialogSettings_OSD_Scrollbar">
        <param name="id">61</param>
        <definition>
            <include content="Part_Scrollbar">
                <param name="id">$PARAM[id]</param>
                <nested />
                <texturesliderbar colordiffuse="main_fg_30" border="4">scrollbar/scrollv_line.png</texturesliderbar>
            </include>
        </definition>
    </include>

    <!-- Right aligned spotlight: a short divider, the name large, and the key hints under it, 180 tall from its bottom.
         Defaults to label 2, the heading Kodi fills in DialogSettings. DialogSlider passes id 10 for Kodi to fill, and custom windows pass id 0 with their own label -->
    <include name="DialogSettings_OSD_Spotlight">
        <param name="id">2</param>
        <param name="label" />
        <param name="hint">&#9650;&#9660;  $LOCALIZE[424]</param>
        <param name="bottom">280</param>
        <definition>
            <control type="group">
                <bottom>$PARAM[bottom]</bottom>
                <height>180</height>
                <control type="image">
                    <top>0</top>
                    <right>0</right>
                    <width>80</width>
                    <height>2</height>
                    <texture colordiffuse="main_fg_30">common/white.png</texture>
                </control>
                <control type="label" id="$PARAM[id]">
                    <top>20</top>
                    <height>120</height>
                    <align>right</align>
                    <font>font_title_midi</font>
                    <textcolor>main_fg_100</textcolor>
                    <label>$PARAM[label]</label>
                </control>
                <control type="label">
                    <top>120</top>
                    <height>40</height>
                    <align>right</align>
                    <font>font_mini</font>
                    <textcolor>main_fg_70</textcolor>
                    <label>$PARAM[hint]</label>
                </control>
            </control>
        </definition>
    </include>

    <include name="DialogSettings_Main">
        <param name="items">DialogSettings_Items</param>
        <param name="visible">!Window.IsVisible(DialogSlider.xml)</param>
        <param name="grouplist_id">5</param>
        <param name="header_id">2</param>
        <param name="has_itemline">false</param>
        <definition>
            <control type="group">
                <visible>$PARAM[visible]</visible>
                <include>Dimension_DialogHugeMenu</include>
                <include>Animation_BounceIn_Dialog</include>
                <include content="Part_Background_Panel">
                    <param name="dialog_size">Dimension_DialogHugeMenu</param>
                </include>
                <control type="group">
                    <!-- Content -->
                    <control type="group" id="8000">
                        <include>Size_Dialog_Pad</include>
                        <!-- Left -->
                        <control type="group">
                            <include>Size_LeftGroup_Main</include>
                            <control type="group">
                                <include>Size_Group_Head</include>
                                <include content="Part_HeadText">
                                    <param name="id">$PARAM[header_id]</param>
                                </include>
                                <include condition="![$PARAM[has_itemline]]">Part_Line</include>
                                <include content="Part_ItemLine" condition="$PARAM[has_itemline]">
                                    <param name="label">$PARAM[itemline_label]</param>
                                </include>
                                <include>Part_CloseButton</include>
                            </control>
                            <control type="group">
                                <include>Size_Group_Body</include>
                                <control type="grouplist" id="$PARAM[grouplist_id]">
                                    <onright>61</onright>
                                    <pagecontrol>61</pagecontrol>
                                    <include>Size_Grouplist_Pad</include>
                                </control>
                                <include content="Part_Scrollbar_Max">
                                    <param name="id">61</param>
                                    <param name="inset">false</param>
                                    <onleft>$PARAM[grouplist_id]</onleft>
                                    <onright>9000</onright>
                                </include>
                            </control>
                        </control>
                        <!-- Right -->
                        <include content="Part_Button_Grouplist">
                            <param name="onleft">61</param>
                            <param name="items">$PARAM[items]</param>
                        </include>
                    </control>
                </control>
            </control>
        </definition>
    </include>

    <include name="DialogAddonSettings">
        <include content="Settings_Button">
            <param name="id">10</param>
            <param name="control">button</param>
            <param name="dialog">true</param>
            <width>constant_addonsettings_category_w</width>
            <description>Default Category Button</description>
            <onclick>SendClick(30)</onclick>
        </include>
        <include content="Object_Hidden_Button">
            <param name="id">30</param>
        </include>
        <include content="Object_Hidden_Button">
            <param name="id">20</param>
        </include>
        <include>DialogSettings_Button_Templates</include>
        <include>Part_Dim_Overlay</include>
        <control type="group">
            <include>Dimension_DialogFullMenu</include>
            <include>Animation_BounceIn_Dialog</include>
            <include content="Part_Background_Panel">
                <param name="dialog_size">Dimension_DialogFullMenu</param>
                <param name="topline">false</param>
            </include>

            <!-- Content -->
            <control type="group" id="8000">
                <include>Size_Dialog_Pad</include>

                <!-- Left -->
                <control type="group">
                    <include>Size_Group_AddonSettings_Left</include>
                    <control type="group">
                        <include>Size_Group_Head</include>
                        <include content="Part_HeadText">
                            <param name="id">9999</param>
                            <param name="label">$LOCALIZE[33063]</param>
                            <param name="right">constant_dialog_pad</param>
                        </include>
                        <include content="Part_ItemPage">
                            <param name="id">3</param>
                            <param name="items_label">$LOCALIZE[31150]</param>
                        </include>
                    </control>
                    <control type="group">
                        <include>Size_Group_Body</include>
                        <control type="grouplist" id="3">
                            <onright>5</onright>
                            <include>Size_Grouplist_Pad</include>
                        </control>
                    </control>
                </control>

                <!-- Mid -->
                <control type="group">
                    <include>Size_Group_AddonSettings_Middle</include>
                    <include>Part_Panel_Middle</include>
                    <control type="group">
                        <include>Size_Group_Head</include>
                        <include content="Part_HeadText">
                            <param name="id">2</param>
                        </include>
                        <include content="Part_ItemPage">
                            <param name="id">5</param>
                        </include>
                        <include>Part_CloseButton</include>
                    </control>
                    <control type="group">
                        <include>Size_Group_Body</include>
                        <control type="group">
                            <bottom>80</bottom>
                            <control type="grouplist" id="5">
                                <onleft>3</onleft>
                                <onright>61</onright>
                                <pagecontrol>61</pagecontrol>
                                <include>Size_Grouplist_Pad</include>
                            </control>
                            <include content="Part_Scrollbar_Max">
                                <param name="id">61</param>
                                <param name="inset">false</param>
                                <onleft>5</onleft>
                                <onright>9000</onright>
                            </include>
                        </control>
                        <include content="Part_InfoText">
                            <param name="label">$INFO[Control.GetLabel(6)]</param>
                        </include>
                    </control>
                </control>

                <!-- Right -->
                <include content="Part_Button_Grouplist">
                    <param name="onleft">61</param>
                    <param name="items">DialogAddonSettings_Items</param>
                </include>

            </control>
        </control>
    </include>

    <!-- Focus textures and colours that drop to the unfocused look while DialogSlider is open -->
    <include name="DialogSettings_Button_SliderFocus">
        <include content="Texture_FocusStyle">
            <param name="include">Object_TextureFocus</param>
            <param name="colordiffuse">$VAR[ColorDialogSettingsFocus]</param>
        </include>
        <focusedcolor>$VAR[ColorDialogSettingsFocusText]</focusedcolor>
        <textureradioonfocus colordiffuse="$VAR[ColorDialogSettingsFocusText]">buttons/check-on.png</textureradioonfocus>
        <textureradioofffocus colordiffuse="$VAR[ColorDialogSettingsFocusText]">buttons/check-off.png</textureradioofffocus>
        <textureupfocus flipy="true" colordiffuse="$VAR[ColorDialogSettingsFocusArrow]">buttons/triangle-down.png</textureupfocus>
        <texturedownfocus colordiffuse="$VAR[ColorDialogSettingsFocusArrow]">buttons/triangle-down.png</texturedownfocus>
        <include content="Texture_Slider_NibFocus">
            <param name="colordiffuse">$VAR[ColorDialogSettingsFocusNib]</param>
        </include>
    </include>

    <!-- Button Definitions. fg and fill: the dialog colours, or main_fg and main_fg_12 over fullscreen video. slider_focus: hide the focus look under DialogSlider -->
    <include name="DialogSettings_Button_Templates">
        <param name="fg">dialog_fg</param>
        <param name="fill">dialog_fg_06</param>
        <param name="slider_focus">false</param>
        <definition>
            <include content="Settings_Button">
                <param name="id">7</param>
                <param name="control">button</param>
                <param name="dialog">true</param>
                <param name="fg">$PARAM[fg]</param>
                <param name="fill">$PARAM[fill]</param>
                <include condition="$PARAM[slider_focus]">DialogSettings_Button_SliderFocus</include>
                <description>Default Setting Button</description>
            </include>

            <include content="Settings_Button">
                <param name="id">8</param>
                <param name="control">radiobutton</param>
                <param name="dialog">true</param>
                <param name="fg">$PARAM[fg]</param>
                <param name="fill">$PARAM[fill]</param>
                <include condition="$PARAM[slider_focus]">DialogSettings_Button_SliderFocus</include>
                <description>Default Setting Button</description>
            </include>

            <include content="Settings_Button">
                <param name="id">9</param>
                <param name="control">spincontrolex</param>
                <param name="dialog">true</param>
                <param name="fg">$PARAM[fg]</param>
                <param name="fill">$PARAM[fill]</param>
                <include condition="$PARAM[slider_focus]">DialogSettings_Button_SliderFocus</include>
                <description>Default Setting Button</description>
            </include>

            <control type="image" id="11">
                <visible>false</visible>
            </control>

            <control type="label" id="6">
                <visible>false</visible>
            </control>

            <include content="Settings_Button">
                <param name="id">12</param>
                <param name="control">edit</param>
                <param name="dialog">true</param>
                <param name="fg">$PARAM[fg]</param>
                <param name="fill">$PARAM[fill]</param>
                <include condition="$PARAM[slider_focus]">DialogSettings_Button_SliderFocus</include>
                <description>Default Setting Button</description>
            </include>

            <include content="Settings_Button">
                <param name="id">13</param>
                <param name="control">sliderex</param>
                <param name="dialog">true</param>
                <param name="fg">$PARAM[fg]</param>
                <param name="fill">$PARAM[fill]</param>
                <include condition="$PARAM[slider_focus]">DialogSettings_Button_SliderFocus</include>
                <description>Default Setting Button</description>
                <textwidth>settings_slider_text_w</textwidth>
            </include>

            <include content="Settings_Label">
                <param name="id">14</param>
                <param name="control">label</param>
                <param name="dialog">true</param>
                <param name="fg">$PARAM[fg]</param>
                <description>Default Setting Label</description>
            </include>

            <include content="Settings_Button">
                <param name="id">15</param>
                <param name="control">colorbutton</param>
                <param name="dialog">true</param>
                <param name="fg">$PARAM[fg]</param>
                <param name="fill">$PARAM[fill]</param>
                <include condition="$PARAM[slider_focus]">DialogSettings_Button_SliderFocus</include>
                <description>Default Setting Button</description>
            </include>
        </definition>
    </include>

    <!-- Items -->
    <include name="DialogAddonSettings_Items">
        <definition>
            <include content="Button_Dialog">
                <param name="id">9028</param>
                <param name="groupid">9328</param>
                <label>$LOCALIZE[31032]</label>
                <param name="icon">special://skin/extras/icons/circle-check.png</param>
                <onclick>SendClick(28)</onclick>
            </include>
            <include content="Button_Dialog">
                <param name="id">9029</param>
                <param name="groupid">9329</param>
                <label>$LOCALIZE[15067]</label>
                <param name="icon">special://skin/extras/icons/circle-xmark.png</param>
                <onclick>SendClick(29)</onclick>
            </include>
            <include content="Button_Dialog">
                <param name="id">04</param>
                <param name="groupid">9304</param>
                <label>$INFO[Control.GetLabel(20)]</label>
                <param name="icon">$VAR[Image_Settings_Level]</param>
                <visible>Control.IsEnabled(20)</visible>
                <onclick>settingslevelchange</onclick>
            </include>
        </definition>
    </include>

    <include name="DialogSettings_Items">
        <include content="Button_Dialog">
            <param name="id">9001</param>
            <param name="groupid">9101</param>
            <label>$INFO[Control.GetLabel(28)]</label>
            <param name="icon">special://skin/extras/icons/circle-check.png</param>
            <visible>Control.IsEnabled(28) + Control.IsVisible(28)</visible>
            <onclick>SendClick(28)</onclick>
        </include>
        <include content="Button_Dialog">
            <param name="id">9002</param>
            <param name="groupid">9102</param>
            <label>$LOCALIZE[15067]</label>
            <param name="icon">special://skin/extras/icons/circle-xmark.png</param>
            <visible>Control.IsEnabled(29) + Control.IsVisible(29)</visible>
            <onclick>SendClick(29)</onclick>
        </include>
        <include content="Button_Dialog">
            <param name="id">9003</param>
            <param name="groupid">9103</param>
            <label>$INFO[Control.GetLabel(30)]</label>
            <param name="icon">special://skin/extras/icons/triangle-exclamation.png</param>
            <visible>Control.IsEnabled(30) + Control.IsVisible(30)</visible>
            <onclick>SendClick(30)</onclick>
        </include>
    </include>
</includes>
