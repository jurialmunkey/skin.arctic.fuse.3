<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">6000</defaultcontrol>
    <views>50</views>
    <menucontrol>30000</menucontrol>
    <include>Action_Blur_Onload</include>
    <include>Action_BlurImage_SimpleBackground_Onload</include>
    <onload>AlarmClock(refocus,SetFocus(6000,0,absolute),00:00,silent)</onload>

    <controls>
        <include>Background</include>

        <include content="Settings_Dialog">

            <include content="Settings_Main_Group">
                <include content="Settings_Left_Group">

                    <include content="List_AddonCategories">
                        <param name="id">6000</param>
                        <param name="altfocus">Control.HasFocus(50) | Control.HasFocus(6100) | Control.HasFocus(6200)</param>
                        <param name="width">settings_category_w</param>
                        <param name="control">fixedlist</param>
                        <param name="textcolor">main_fg</param>
                        <focusposition>4</focusposition>
                        <movement>4</movement>
                        <!-- Moving to the categories clears the search, which restores the normal panel -->
                        <onfocus condition="!String.IsEmpty(Control.GetLabel(6100).index(1))">RunScript(script.skinvariables,set_editcontrol=6100,setfocus=6000)</onfocus>
                        <onright condition="String.IsEmpty(Container(6000).ListItem.Property(folderpath))">Container.Update($INFO[Container(6000).ListItem.FolderPath],replace)</onright>
                        <onright condition="!String.IsEmpty(Container(6000).ListItem.Property(folderpath))">Container.Update($INFO[Container(6000).ListItem.Property(folderpath)],replace)</onright>
                        <onright>50</onright>
                        <onclick condition="String.IsEmpty(Container(6000).ListItem.Property(skipupdate))">SendClick(9)</onclick>
                        <left>40</left>
                        <right>-100</right>
                        <top>180</top>
                        <bottom>180</bottom>
                        <onback>SetFocus(6000,0,absolute)</onback>
                        <content>
                            <item>
                                <label>$LOCALIZE[24998]</label>
                                <property name="folderpath">addons://</property>
                                <!-- <property name="folderpath">addons://user/</property> -->
                                <icon>DefaultAddonsInstalled.png</icon>
                            </item>
                            <item>
                                <label>$LOCALIZE[24004]</label>
                                <property name="folderpath">addons://recently_updated/</property>
                                <icon>DefaultAddonsRecentlyUpdated.png</icon>
                            </item>
                            <item>
                                <label>$LOCALIZE[24043]$INFO[System.AddonUpdateCount, (,)]</label>
                                <property name="folderpath">addons://outdated/</property>
                                <icon>DefaultAddonsUpdates.png</icon>
                                <visible>!Integer.IsEqual(Container(6301).NumItems,0)</visible>
                            </item>
                            <item>
                                <label>$LOCALIZE[24996]</label>
                                <property name="folderpath">addons://dependencies/</property>
                                <icon>DefaultAddonService.png</icon>
                            </item>
                            <item>
                                <label>$LOCALIZE[31152]</label>
                                <property name="folderpath">addons://running/</property>
                                <icon>DefaultScript.png</icon>
                            </item>
                            <!-- <item>
                                <label>$LOCALIZE[31375]</label>
                                <property name="folderpath">addons://user/</property>
                                <property name="skipupdate">true</property>
                                <icon>DefaultAddonsZip.png</icon>
                                <onclick>InstallFromZip</onclick>
                            </item>
                            <item>
                                <label>$LOCALIZE[137]</label>
                                <property name="folderpath">addons://user/</property>
                                <property name="skipupdate">true</property>
                                <icon>DefaultAddonsSearch.png</icon>
                                <onclick>SetFocus(50)</onclick>
                                <onclick>Container.Update(addons://search/,replace)</onclick>
                            </item> -->
                        </content>
                        <content sortby="label">addons://repos/</content>
                    </include>
                </include>
                <include content="Settings_Right_Group">
                    <include content="AddonBrowser_Panel">
                        <param name="id">50</param>
                        <param name="scrollbar">60</param>
                        <onback condition="String.IsEqual(Container.FolderPath,Container(6000).ListItem.FolderPath) | String.IsEqual(Container.FolderPath,Container(6000).ListItem.Property(folderpath)) | String.IsEqual(Container.FolderPath,addons://)">6000</onback>
                        <visible>!$EXP[Exp_AddonBrowser_HasSearchResults]</visible>
                    </include>

                    <include content="AddonBrowser_Panel">
                        <param name="id">6200</param>
                        <param name="scrollbar">6201</param>
                        <onback>6000</onback>
                        <onclick>Action(Info)</onclick>
                        <content>$VAR[Path_AddonBrowser_Search]</content>
                        <!-- Kodi only updates a hidden container's content when it allows hidden focus -->
                        <visible allowhiddenfocus="true">$EXP[Exp_AddonBrowser_HasSearchResults]</visible>
                    </include>

                    <include content="Settings_SearchBox">
                        <param name="buttonid">6100</param>
                        <param name="icon">special://skin/extras/icons/search.png</param>
                        <include content="Settings_SearchBox_Button">
                            <param name="id">6100</param>
                            <param name="control">edit</param>
                            <onleft>6000</onleft>
                            <ondown condition="$EXP[Exp_AddonBrowser_HasSearchResults]">6200</ondown>
                            <ondown condition="!$EXP[Exp_AddonBrowser_HasSearchResults]">50</ondown>
                            <onback>6000</onback>
                        </include>
                    </include>
                </include>
            </include>

        </include>

        <control type="list" id="6301">
            <width>1</width>
            <height>1</height>
            <left>-1000</left>
            <itemlayout width="1" height="1" />
            <focusedlayout width="1" height="1" />
            <content>addons://outdated/</content>
        </control>

    </controls>

</window>
