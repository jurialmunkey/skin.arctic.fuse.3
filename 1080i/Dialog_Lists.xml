<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="List_Dialog">
        <param name="item_height">80</param>
        <param name="itemlayout_include">List_Layout_Dialog_SimpleCheckmark</param>
        <param name="control">list</param>
        <param name="misc">ListItem.IsSelected</param>
        <param name="icon">$INFO[ListItem.Icon]</param>
        <definition>
            <include content="List_Core">
                <param name="orientation">vertical</param>
                <param name="control">$PARAM[control]</param>
                <param name="id">$PARAM[id]</param>
                <param name="altfocus">$PARAM[altfocus]</param>
                <param name="item_h">$PARAM[item_height]</param>
                <param name="itemlayout_h">$PARAM[item_height]</param>
                <param name="itemlayout_include">$PARAM[itemlayout_include]</param>
                <param name="detailed">$PARAM[detailed]</param>
                <param name="offset_x">0</param>
                <param name="offset_y">0</param>
                <param name="misc">$PARAM[misc]</param>
                <param name="icon">$PARAM[icon]</param>
                <nested />
            </include>
        </definition>
    </include>

    <include name="List_Layout_Dialog_SimpleCheckmark">
        <param name="selected">false</param>
        <definition>
            <include condition="$PARAM[selected]">Part_List_Highlight</include>
            <control type="group">
                <left>40</left>
                <right>40</right>
                <include content="Part_List_Checkmark" condition="!$PARAM[selected]">
                    <param name="selected">$PARAM[misc]</param>
                </include>
                <include content="Part_List_Checkmark" condition="$PARAM[selected]">
                    <param name="selected">$PARAM[misc]</param>
                    <param name="colordiffuse_off">$VAR[ColorSelected]</param>
                    <param name="colordiffuse_on">$VAR[ColorSelected]</param>
                </include>
                <control type="label">
                    <include condition="$PARAM[selected]">Color_SelectedText</include>
                    <textcolor>dialog_fg_70</textcolor>
                    <selectedcolor>dialog_fg_70</selectedcolor>
                    <disabledcolor>dialog_fg_30</disabledcolor>
                    <label>$INFO[ListItem.Label]</label>
                    <left>40</left>
                </control>
            </control>
        </definition>
    </include>

    <include name="List_Layout_Dialog_Labels">
        <param name="label">$INFO[ListItem.Label]</param>
        <param name="label2">$INFO[ListItem.Label2]</param>
        <param name="label2_visible">!String.IsEmpty(ListItem.Label2)</param>
        <param name="align">left</param>
        <definition>
            <control type="group">
                <left>$PARAM[item_h]</left>
                <height>60</height>
                <centertop>50%</centertop>
                <control type="label">
                    <left>-10</left>
                    <include condition="$PARAM[selected]">Color_SelectedText</include>
                    <textcolor>dialog_fg_70</textcolor>
                    <selectedcolor>dialog_fg_70</selectedcolor>
                    <disabledcolor>dialog_fg_30</disabledcolor>
                    <label fallback="$PARAM[fallback]">$PARAM[label]</label>
                    <visible>![$PARAM[label2_visible]]</visible>
                    <align>$PARAM[align]</align>
                </control>
                <control type="label">
                    <left>-10</left>
                    <include condition="$PARAM[selected]">Color_SelectedText</include>
                    <textcolor>dialog_fg_70</textcolor>
                    <selectedcolor>dialog_fg_70</selectedcolor>
                    <disabledcolor>dialog_fg_30</disabledcolor>
                    <font>font_main_bold</font>
                    <label fallback="$PARAM[fallback]">$PARAM[label]</label>
                    <visible>$PARAM[label2_visible]</visible>
                    <height>30</height>
                    <top>0</top>
                    <align>$PARAM[align]</align>
                </control>
                <control type="label">
                    <left>-10</left>
                    <include condition="$PARAM[selected]">Color_SelectedText</include>
                    <textcolor>dialog_fg_70</textcolor>
                    <selectedcolor>dialog_fg_70</selectedcolor>
                    <disabledcolor>dialog_fg_30</disabledcolor>
                    <font>font_tiny</font>
                    <label>$PARAM[label2]</label>
                    <visible>$PARAM[label2_visible]</visible>
                    <height>30</height>
                    <bottom>0</bottom>
                    <align>$PARAM[align]</align>
                </control>
            </control>
        </definition>
    </include>

    <include name="List_Layout_Dialog_FourLabels">
        <param name="label">$INFO[ListItem.Label]</param>
        <param name="label2">$INFO[ListItem.Label2]</param>
        <param name="label3" />
        <param name="label4" />
        <definition>
            <control type="group">
                <left>$PARAM[item_h]</left>
                <height>60</height>
                <centertop>50%</centertop>
                <control type="group">
                    <height>30</height>
                    <top>0</top>
                    <left>-10</left>
                    <control type="label">
                        <include condition="$PARAM[selected]">Color_SelectedText</include>
                        <textcolor>dialog_fg_70</textcolor>
                        <selectedcolor>dialog_fg_70</selectedcolor>
                        <disabledcolor>dialog_fg_30</disabledcolor>
                        <font>font_main_bold</font>
                        <label>$PARAM[label]</label>
                        <align>left</align>
                    </control>
                    <control type="label">
                        <include condition="$PARAM[selected]">Color_SelectedText</include>
                        <textcolor>dialog_fg_70</textcolor>
                        <selectedcolor>dialog_fg_70</selectedcolor>
                        <disabledcolor>dialog_fg_30</disabledcolor>
                        <font>font_main_bold</font>
                        <label>$PARAM[label3]</label>
                        <align>right</align>
                    </control>
                </control>

                <control type="group">
                    <left>-10</left>
                    <height>30</height>
                    <bottom>0</bottom>
                    <control type="label">
                        <include condition="$PARAM[selected]">Color_SelectedText</include>
                        <textcolor>dialog_fg_70</textcolor>
                        <selectedcolor>dialog_fg_70</selectedcolor>
                        <disabledcolor>dialog_fg_30</disabledcolor>
                        <font>font_tiny</font>
                        <label>$PARAM[label2]</label>
                        <align>left</align>
                    </control>
                    <control type="label">
                        <include condition="$PARAM[selected]">Color_SelectedText</include>
                        <textcolor>dialog_fg_70</textcolor>
                        <selectedcolor>dialog_fg_70</selectedcolor>
                        <disabledcolor>dialog_fg_30</disabledcolor>
                        <font>font_tiny</font>
                        <label>$PARAM[label4]</label>
                        <align>right</align>
                    </control>
                </control>
            </control>
        </definition>
    </include>

    <include name="List_Layout_Dialog_DetailedCheckmark">
        <param name="selected">false</param>
        <param name="detailed">false</param>
        <definition>
            <include condition="$PARAM[selected]">Part_List_Highlight</include>
            <control type="group">
                <left>40</left>
                <right>40</right>
                <include content="Part_List_Checkmark" condition="![$PARAM[selected]] + [$PARAM[detailed]]">
                    <param name="selected">$PARAM[misc]</param>
                </include>
                <include content="Part_List_Checkmark" condition="[$PARAM[selected]] + [$PARAM[detailed]]">
                    <param name="selected">$PARAM[misc]</param>
                    <param name="colordiffuse_off">$VAR[ColorSelected]</param>
                    <param name="colordiffuse_on">$VAR[ColorSelected]</param>
                </include>
                <control type="group">
                    <include content="Object_Left" condition="$PARAM[detailed]">
                        <param name="left">40</param>
                    </include>
                    <include content="Part_List_Icon" condition="![$PARAM[selected]]">
                        <param name="item_h">$PARAM[item_h]</param>
                        <param name="icon">$PARAM[icon]</param>
                        <param name="fallback">$PARAM[fallback]</param>
                        <param name="is_defaulticon">$PARAM[is_defaulticon]</param>
                    </include>
                    <include content="Part_List_Icon" condition="$PARAM[selected]">
                        <param name="item_h">$PARAM[item_h]</param>
                        <param name="colordiffuse">$VAR[ColorSelected]</param>
                        <param name="icon">$PARAM[icon]</param>
                        <param name="fallback">$PARAM[fallback]</param>
                        <param name="is_defaulticon">$PARAM[is_defaulticon]</param>
                    </include>
                    <include content="List_Layout_Dialog_Labels">
                        <param name="item_h">$PARAM[item_h]</param>
                        <param name="selected">$PARAM[selected]</param>
                        <param name="label">$PARAM[label]</param>
                        <param name="label2">$PARAM[label2]</param>
                        <param name="label2_visible">$PARAM[label2_visible]</param>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <include name="List_Layout_Dialog_GameDiscs">
        <param name="selected">false</param>
        <param name="detailed">false</param>
        <definition>
            <include content="List_Layout_Dialog_DetailedCheckmark">
                <param name="detailed">$PARAM[detailed]</param>
                <param name="selected">$PARAM[selected]</param>
                <param name="misc">$PARAM[misc]</param>
                <param name="item_h">$PARAM[item_h]</param>
                <param name="fallback">special://skin/extras/icons/floppy-disk.png</param>
                <param name="icon">$INFO[ListItem.Icon]</param>
                <param name="is_defaulticon">[String.IsEmpty(ListItem.Icon) | String.StartsWith(ListItem.Icon,Default)]</param>
                <param name="label">$INFO[ListItem.Label]</param>
                <param name="label2">$INFO[ListItem.Label2]</param>
                <param name="label2_visible">!String.IsEmpty(ListItem.Label2)</param>
            </include>
        </definition>
    </include>

    <include name="List_Layout_Dialog_GameSaves">
        <param name="selected">false</param>
        <param name="detailed">false</param>
        <definition>
            <include content="List_Layout_Dialog_DetailedCheckmark">
                <param name="detailed">$PARAM[detailed]</param>
                <param name="selected">$PARAM[selected]</param>
                <param name="misc">$PARAM[misc]</param>
                <param name="item_h">$PARAM[item_h]</param>
                <param name="fallback">$INFO[ListItem.Icon]</param>
                <param name="icon">$INFO[ListItem.Art(screenshot)]</param>
                <param name="is_defaulticon">[String.IsEmpty(ListItem.Art(screenshot)) + [String.StartsWith(ListItem.Icon,Default) | String.StartsWith(ListItem.Icon,special://skin/extras/icons/)]]</param>
                <param name="label">$VAR[Label_GameSave_Top]</param>
                <param name="label2">$VAR[Label_GameSave_Sub]</param>
                <param name="label2_visible">true</param>
            </include>
        </definition>
    </include>

    <include name="List_Layout_GameController">
        <param name="selected">false</param>
        <param name="detailed">false</param>
        <definition>
            <include condition="$PARAM[selected]">Part_List_Highlight</include>
            <control type="group">
                <left>40</left>
                <right>40</right>
                <control type="group">
                    <include content="Part_List_GameController" condition="![$PARAM[selected]]">
                        <param name="item_h">$PARAM[item_h]</param>
                    </include>
                    <include content="Part_List_GameController" condition="$PARAM[selected]">
                        <param name="item_h">$PARAM[item_h]</param>
                        <param name="colordiffuse">$VAR[ColorSelected]</param>
                    </include>
                    <include content="List_Layout_Dialog_Labels">
                        <param name="item_h">$PARAM[item_h]</param>
                        <param name="selected">$PARAM[selected]</param>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <include name="List_Layout_GameAgents">
        <param name="selected">false</param>
        <param name="detailed">false</param>
        <definition>
            <include condition="$PARAM[selected]">Part_List_Highlight</include>
            <control type="group">
                <left>40</left>
                <right>40</right>
                <control type="group">
                    <width>300</width>
                    <include content="List_Layout_Dialog_Labels">
                        <param name="item_h">$PARAM[item_h]</param>
                        <param name="selected">$PARAM[selected]</param>
                        <param name="label">$INFO[ListItem.CurrentItem,$LOCALIZE[31175] #,]</param>
                        <param name="label2">$INFO[ListItem.Label]</param>
                        <param name="label2_visible">true</param>
                    </include>
                </control>
                <control type="group">
                    <include content="Part_List_GameAgents" condition="![$PARAM[selected]]">
                        <param name="item_h">88</param>
                    </include>
                    <include content="Part_List_GameAgents" condition="$PARAM[selected]">
                        <param name="item_h">88</param>
                        <param name="colordiffuse">$VAR[ColorSelected]</param>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <include name="List_Layout_Leaderboards">
        <param name="selected">false</param>
        <param name="detailed">false</param>
        <definition>
            <include condition="$PARAM[selected]">Part_List_Highlight</include>
            <control type="group">
                <left>40</left>
                <right>40</right>
                <control type="group">
                    <include content="List_Layout_Dialog_Labels">
                        <param name="label">$INFO[ListItem.Property(TopScore)]</param>
                        <param name="label2">$INFO[ListItem.Property(Format)]</param>
                        <param name="label2_visible">true</param>
                        <param name="fallback">10006</param>
                        <param name="selected">$PARAM[selected]</param>
                        <param name="align">left</param>
                    </include>
                    <include content="List_Layout_Dialog_FourLabels">
                        <param name="item_h">200</param>
                        <param name="selected">$PARAM[selected]</param>
                        <param name="label4">$INFO[ListItem.Property(TotalEntries)]</param>
                        <param name="label3">$INFO[ListItem.Property(TopUsername)]$INFO[ListItem.Property(PlayerStanding), (,)]$INFO[ListItem.Property(PlayerScore), - ,]</param>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <include name="List_Layout_LeaderboardEntries">
        <param name="selected">false</param>
        <param name="detailed">false</param>
        <definition>
            <include condition="$PARAM[selected]">Part_List_Highlight</include>
            <control type="group">
                <left>40</left>
                <right>40</right>
                <control type="group">
                    <height>60</height>
                    <width>60</width>
                    <left>-20</left>
                    <centertop>50%</centertop>
                    <control type="image">
                        <texture colordiffuse="$VAR[Color_Medals]">special://skin/extras/icons/trophy.png</texture>
                        <bordersize>-10</bordersize>
                        <visible>!String.IsEmpty(ListItem.Property(medal))</visible>
                    </control>
                    <control type="label">
                        <include condition="$PARAM[selected]">Color_SelectedText</include>
                        <textcolor>dialog_fg_70</textcolor>
                        <selectedcolor>dialog_fg_70</selectedcolor>
                        <disabledcolor>dialog_fg_30</disabledcolor>
                        <font>font_main_bold</font>
                        <label>$INFO[ListItem.Property(RankLabel)]</label>
                        <align>center</align>
                        <aligny>center</aligny>
                        <visible>String.IsEmpty(ListItem.Property(medal))</visible>
                    </control>
                </control>
                <control type="group">
                    <left>60</left>
                    <include content="Part_List_Icon">
                        <param name="item_h">$PARAM[item_h]</param>
                        <param name="selected">$PARAM[selected]</param>
                        <param name="fallback">DefaultUser.png</param>
                    </include>
                    <include content="List_Layout_Dialog_FourLabels">
                        <param name="item_h">$PARAM[item_h]</param>
                        <param name="selected">$PARAM[selected]</param>
                        <param name="label4">$INFO[ListItem.Property(Date)]</param>
                        <param name="label3">$INFO[ListItem.Property(DateRelative)]</param>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <include name="List_Layout_GameAchievements">
        <param name="selected">false</param>
        <param name="detailed">false</param>
        <definition>
            <control type="group">
                <animation effect="fade" start="100" end="70" condition="String.IsEmpty(ListItem.Property(achievement.earned))">Conditional</animation>
                <include condition="$PARAM[selected]">Part_List_Highlight</include>
            </control>
            <control type="progress">
                <description>Progressbar</description>
                <info>ListItem.Property(achievement.measuredpercent)</info>
                <texturebg colordiffuse="00ffffff" border="40,0,40,0">common/menu.png</texturebg>
                <midtexture colordiffuse="$VAR[ColorHighlight]" border="40,40,40,40">common/menu.png</midtexture>
                <visible>Integer.IsGreater(ListItem.Property(achievement.measuredpercent),1)</visible>
                <visible>!String.IsEmpty(ListItem.Property(achievement.measured))</visible>
                <visible>$PARAM[selected]</visible>
            </control>
            <control type="group">
                <left>40</left>
                <right>40</right>
                <control type="group">
                    <height>60</height>
                    <width>60</width>
                    <left>-20</left>
                    <centertop>50%</centertop>
                    <control type="group">
                        <height>30</height>
                        <top>1</top>
                        <control type="image">
                            <height>60</height>
                            <centertop>50%</centertop>
                            <texture>$VAR[Image_GameAchievementEarned]</texture>
                            <include condition="$PARAM[selected]">Color_SelectedImage</include>
                            <colordiffuse>dialog_fg_70</colordiffuse>
                        </control>
                    </control>
                    <control type="group">
                        <height>30</height>
                        <bottom>-1</bottom>
                        <control type="label">
                            <include condition="$PARAM[selected]">Color_SelectedText</include>
                            <textcolor>dialog_fg_70</textcolor>
                            <selectedcolor>dialog_fg_70</selectedcolor>
                            <disabledcolor>dialog_fg_30</disabledcolor>
                            <font>font_tiny</font>
                            <label>$INFO[ListItem.Property(achievement.raritystars)]</label>
                            <align>center</align>
                            <left>-20</left>
                            <right>-20</right>
                        </control>
                    </control>
                </control>
                <control type="group">
                    <left>60</left>
                    <include content="Part_List_Icon">
                        <param name="item_h">$PARAM[item_h]</param>
                        <param name="selected">$PARAM[selected]</param>
                        <param name="fallback">DefaultPicture.png</param>
                    </include>
                    <include content="List_Layout_Dialog_FourLabels">
                        <param name="item_h">$PARAM[item_h]</param>
                        <param name="selected">$PARAM[selected]</param>
                        <param name="label">$INFO[ListItem.Label]$INFO[ListItem.Property(achievement.measuredprogress), (,)]</param>
                        <param name="label4">$INFO[ListItem.Property(achievement.unlockeddate),, - ]$INFO[ListItem.Property(achievement.raritycategory)]</param>
                        <param name="label3">$INFO[ListItem.Property(achievement.points)]</param>
                    </include>
                </control>
            </control>
        </definition>
    </include>


    <include name="List_Layout_Dialog_VideoVersions">
        <param name="selected">false</param>
        <definition>
            <control type="group">
                <animation effect="fade" start="100" end="50" condition="!Control.HasFocus($PARAM[id])">Conditional</animation>
                <include condition="$PARAM[selected]">Part_List_Highlight</include>
            </control>
            <control type="group">
                <left>40</left>
                <right>40</right>
                <control type="group">
                    <include content="Part_List_Icon" condition="!$PARAM[selected]">
                        <param name="item_h">$PARAM[item_h]</param>
                        <param name="icon">$VAR[Image_Poster]</param>
                        <param name="is_defaulticon">[False]</param>
                    </include>
                    <include content="Part_List_Icon" condition="$PARAM[selected]">
                        <param name="item_h">$PARAM[item_h]</param>
                        <param name="colordiffuse">$VAR[ColorSelected]</param>
                        <param name="icon">$VAR[Image_Poster]</param>
                        <param name="is_defaulticon">[False]</param>
                    </include>
                    <control type="group">
                        <include content="List_Layout_Dialog_Labels">
                            <param name="item_h">$PARAM[item_h]</param>
                            <param name="selected">$PARAM[selected]</param>
                            <param name="label">$VAR[Label_Version_Title]</param>
                            <param name="label2">[UPPERCASE]$VAR[Label_VideoQuality]$INFO[ListItem.VideoCodec, • ,]$INFO[ListItem.HdrType, • ,]$INFO[ListItem.VideoAspect, • ,:1]$INFO[ListItem.AudioCodec, • ,]$VAR[Label_ListItem_AudioChannels, • ,][/UPPERCASE]</param>
                            <param name="label2_visible">!String.IsEmpty(ListItem.VideoCodec)</param>
                        </include>
                        <animation effect="slide" start="0" end="0,-20" condition="!String.IsEmpty(ListItem.Property(AudioLanguage.1)) | !String.IsEmpty(ListItem.Property(SubtitleLanguage.1))">Conditional</animation>
                    </control>
                    <control type="group">
                        <left>$PARAM[item_h]</left>
                        <height>60</height>
                        <centertop>50%</centertop>
                        <visible>!String.IsEmpty(ListItem.Property(AudioLanguage.1)) | !String.IsEmpty(ListItem.Property(SubtitleLanguage.1))</visible>
                        <animation effect="slide" start="0" end="0,20" condition="true">Conditional</animation>
                        <control type="label">
                            <left>-10</left>
                            <include condition="$PARAM[selected]">Color_SelectedText</include>
                            <textcolor>dialog_fg_70</textcolor>
                            <selectedcolor>dialog_fg_70</selectedcolor>
                            <disabledcolor>dialog_fg_30</disabledcolor>
                            <font>font_tiny</font>
                            <label>$VAR[Label_AudioLanguages,,  ]$VAR[Label_SubtitleLanguages]</label>
                            <height>30</height>
                            <bottom>0</bottom>
                        </control>
                    </control>
                </control>
            </control>
        </definition>
    </include>
</includes>
