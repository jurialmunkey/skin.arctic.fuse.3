<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <expression name="Exp_Weather_Trend_Has_UV">[Weather.IsFetched + String.IsEqual(Weather.Plugin,weather.ozweather) + String.IsEqual(Control.GetLabel(8052),Window(weather).Property(Weather.Trend.UV.Source)) + !String.IsEmpty(Window(weather).Property(Weather.Trend.UV.First))]</expression>
    <expression name="Exp_Weather_Trend_UV_Page">[$EXP[Exp_Weather_Trend_Has_UV] + String.IsEqual(Window(weather).Property(Weather.Trend.Page),UV)]</expression>

    <include name="Weather_Trend_UV_Source">
        <control type="label" id="8052">
            <include>Object_Hidden_Item_Definition</include>
            <visible>false</visible>
            <label>uv-scale-12:$INFO[Weather.Plugin]:$INFO[Window(weather).Property(Daily.1.UVIndex)]:$INFO[Window(weather).Property(Daily.2.UVIndex)]:$INFO[Window(weather).Property(Daily.3.UVIndex)]:$INFO[Window(weather).Property(Daily.4.UVIndex)]</label>
        </control>
    </include>

    <include name="Weather_Trend_UV_Forecast">
        <control type="group">
            <left>60</left>
            <right>60</right>
            <top>500</top>
            <visible>$EXP[Exp_Weather_Trend_UV_Page]</visible>
            <include>Weather_Trend_UV_Plot</include>
        </control>
    </include>

    <include name="Weather_Trend_UV_Plot">
        <control type="group">
            <top>84</top>
            <height>314</height>
            <include content="Weather_Trend_UV_Title">
                <param name="left">20</param>
                <param name="width">160</param>
                <param name="align">left</param>
                <param name="label">$LOCALIZE[403]</param>
            </include>
            <!-- Draw the fills first so their edges never cover the markers. -->
            <include content="Weather_Trend_UV_Cap">
                <param name="day">0</param>
                <param name="left">20</param>
                <param name="flipx">true</param>
            </include>
            <include content="Weather_Trend_UV_Cap">
                <param name="day">3</param>
                <param name="left">1428</param>
            </include>
            <include content="Weather_Trend_UV_Fill">
                <param name="day">0</param>
                <param name="next">1</param>
                <param name="left">372</param>
            </include>
            <include content="Weather_Trend_UV_Fill">
                <param name="day">1</param>
                <param name="next">2</param>
                <param name="left">724</param>
            </include>
            <include content="Weather_Trend_UV_Fill">
                <param name="day">2</param>
                <param name="next">3</param>
                <param name="left">1076</param>
            </include>
            <include>Weather_Trend_UV_Levels</include>
            <include content="Weather_Trend_UV_Day">
                <param name="day">0</param>
                <param name="left">372</param>
                <param name="title">$LOCALIZE[33006]</param>
            </include>
            <include content="Weather_Trend_UV_Day">
                <param name="day">1</param>
                <param name="left">724</param>
                <param name="title">$INFO[Window(weather).Property(Day1.Title)]</param>
            </include>
            <include content="Weather_Trend_UV_Day">
                <param name="day">2</param>
                <param name="left">1076</param>
                <param name="title">$INFO[Window(weather).Property(Day2.Title)]</param>
            </include>
            <include content="Weather_Trend_UV_Day">
                <param name="day">3</param>
                <param name="left">1428</param>
                <param name="title">$INFO[Window(weather).Property(Day3.Title)]</param>
            </include>
        </control>
    </include>

    <include name="Weather_Trend_UV_Title">
        <param name="top">-84</param>
        <param name="height">40</param>
        <param name="font">font_main_bold</param>
        <param name="color">main_fg_100</param>
        <definition>
            <control type="label">
                <left>$PARAM[left]</left>
                <top>$PARAM[top]</top>
                <width>$PARAM[width]</width>
                <height>$PARAM[height]</height>
                <align>$PARAM[align]</align>
                <aligny>center</aligny>
                <font>$PARAM[font]</font>
                <textcolor>$PARAM[color]</textcolor>
                <shadowcolor>shadow_hard</shadowcolor>
                <label>$PARAM[label]</label>
            </control>
        </definition>
    </include>

    <!-- The level lines are baked into the UV textures at these same heights. -->
    <include name="Weather_Trend_UV_Levels">
        <include content="Weather_Trend_UV_Level">
            <param name="top">52</param>
            <param name="color">ee154a</param>
            <param name="label">$LOCALIZE[31887]</param>
        </include>
        <include content="Weather_Trend_UV_Level">
            <param name="top">131</param>
            <param name="color">f66b34</param>
            <param name="label">$LOCALIZE[393]</param>
        </include>
        <include content="Weather_Trend_UV_Level">
            <param name="top">183</param>
            <param name="color">fcbd22</param>
            <param name="label">$LOCALIZE[31888]</param>
        </include>
        <include content="Weather_Trend_UV_Level">
            <param name="top">262</param>
            <param name="color">67be4d</param>
            <param name="label">$LOCALIZE[391]</param>
        </include>
    </include>

    <include name="Weather_Trend_UV_Level">
        <definition>
            <control type="group">
                <top>$PARAM[top]</top>
                <include content="Weather_Trend_UV_Title">
                    <param name="left">20</param>
                    <param name="top">-28</param>
                    <param name="width">320</param>
                    <param name="height">26</param>
                    <param name="align">left</param>
                    <param name="font">font_hint_bold</param>
                    <param name="color">ff$PARAM[color]</param>
                    <param name="label">$PARAM[label]</param>
                </include>
            </control>
        </definition>
    </include>

    <include name="Weather_Trend_UV_Day">
        <definition>
            <control type="group">
                <left>$PARAM[left]</left>
                <include content="Weather_Trend_UV_Title">
                    <param name="left">-160</param>
                    <param name="width">320</param>
                    <param name="align">center</param>
                    <param name="label">$PARAM[title]</param>
                </include>
                <include content="Weather_Trend_Point">
                    <param name="day">Day$PARAM[day]</param>
                    <param name="kind">UV</param>
                    <param name="left">0</param>
                    <param name="top">0</param>
                    <param name="plot_height">314</param>
                    <param name="position_include">Weather_Trend_UV_Position</param>
                    <param name="label_top">-42</param>
                    <param name="label">$INFO[Window(weather).Property(Weather.Trend.Day$PARAM[day].UV.Label)]</param>
                    <param name="visible">!String.IsEmpty(Window(weather).Property(Weather.Trend.Day$PARAM[day].UV.Label))</param>
                    <param name="color">main_fg_100</param>
                    <param name="dot_color">$INFO[Window(weather).Property(Weather.Trend.Day$PARAM[day].UV.Color)]</param>
                    <param name="connect">false</param>
                </include>
                <control type="label">
                    <left>-80</left>
                    <top>142</top>
                    <width>160</width>
                    <height>30</height>
                    <font>font_mini_bold</font>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>main_fg_30</textcolor>
                    <label>—</label>
                    <visible>String.IsEmpty(Window(weather).Property(Weather.Trend.Day$PARAM[day].UV.Label))</visible>
                </control>
            </control>
        </definition>
    </include>

    <!-- Caps run between a dot and UV 0, ending 80px from the screen edge. -->
    <include name="Weather_Trend_UV_Cap">
        <param name="flipx">false</param>
        <definition>
            <control type="group">
                <left>$PARAM[left]</left>
                <include content="Weather_Trend_Segment">
                    <param name="top">0</param>
                    <param name="width">352</param>
                    <param name="height">314</param>
                    <param name="color">ffffffff</param>
                    <param name="flipx">$PARAM[flipx]</param>
                    <param name="visible">!String.IsEmpty(Window(weather).Property(Weather.Trend.Day$PARAM[day].UV.Label))</param>
                    <param name="texture">weather/trend/uv/$INFO[Window(weather).Property(Weather.Trend.Day$PARAM[day].UV.Position)]-12.png</param>
                </include>
            </control>
        </definition>
    </include>

    <include name="Weather_Trend_UV_Fill">
        <definition>
            <control type="group">
                <left>$PARAM[left]</left>
                <visible>!String.IsEmpty(Window(weather).Property(Weather.Trend.Day$PARAM[day].UV.Label)) + !String.IsEmpty(Window(weather).Property(Weather.Trend.Day$PARAM[next].UV.Label))</visible>
                <!-- The 2px translucent edge is baked into the fill to keep them aligned. -->
                <include content="Weather_Trend_Segment">
                    <param name="top">0</param>
                    <param name="width">352</param>
                    <param name="height">314</param>
                    <param name="color">ffffffff</param>
                    <param name="visible">!Integer.IsLess(Window(weather).Property(Weather.Trend.Day$PARAM[next].UV.Position),Window(weather).Property(Weather.Trend.Day$PARAM[day].UV.Position))</param>
                    <param name="texture">weather/trend/uv/$INFO[Window(weather).Property(Weather.Trend.Day$PARAM[day].UV.Position)]-$INFO[Window(weather).Property(Weather.Trend.Day$PARAM[next].UV.Position)].png</param>
                </include>
                <include content="Weather_Trend_Segment">
                    <param name="top">0</param>
                    <param name="width">352</param>
                    <param name="height">314</param>
                    <param name="color">ffffffff</param>
                    <param name="flipx">true</param>
                    <param name="visible">Integer.IsLess(Window(weather).Property(Weather.Trend.Day$PARAM[next].UV.Position),Window(weather).Property(Weather.Trend.Day$PARAM[day].UV.Position))</param>
                    <param name="texture">weather/trend/uv/$INFO[Window(weather).Property(Weather.Trend.Day$PARAM[next].UV.Position)]-$INFO[Window(weather).Property(Weather.Trend.Day$PARAM[day].UV.Position)].png</param>
                </include>
            </control>
        </definition>
    </include>

    <!-- Each step is one UV index point over a fixed 0–12 scale. -->
    <include name="Weather_Trend_UV_Position">
        <definition>
            <animation effect="slide" end="0,26.166667" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],1)">Conditional</animation>
            <animation effect="slide" end="0,52.333333" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],2)">Conditional</animation>
            <animation effect="slide" end="0,78.5" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],3)">Conditional</animation>
            <animation effect="slide" end="0,104.666667" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],4)">Conditional</animation>
            <animation effect="slide" end="0,130.833333" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],5)">Conditional</animation>
            <animation effect="slide" end="0,157" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],6)">Conditional</animation>
            <animation effect="slide" end="0,183.166667" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],7)">Conditional</animation>
            <animation effect="slide" end="0,209.333333" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],8)">Conditional</animation>
            <animation effect="slide" end="0,235.5" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],9)">Conditional</animation>
            <animation effect="slide" end="0,261.666667" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],10)">Conditional</animation>
            <animation effect="slide" end="0,287.833333" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],11)">Conditional</animation>
            <animation effect="slide" end="0,314" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],12)">Conditional</animation>
        </definition>
    </include>
</includes>
