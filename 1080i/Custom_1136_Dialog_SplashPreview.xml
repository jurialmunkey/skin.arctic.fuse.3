<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1136">
    <defaultcontrol always="true">9000</defaultcontrol>
    <controls>
        <include content="Hub_Widget_Splash">
            <param name="condition">true</param>
            <param name="label">$LOCALIZE[1000]</param>
            <param name="busyspinner">false</param>
        </include>

        <!-- Any key closes the preview. Back closes the dialog by default -->
        <control type="button" id="9000">
            <texturefocus />
            <texturenofocus />
            <left>-1000</left>
            <width>1</width>
            <height>1</height>
            <onclick>Close</onclick>
            <onup>Close</onup>
            <ondown>Close</ondown>
            <onleft>Close</onleft>
            <onright>Close</onright>
        </control>

        <!-- Moving the mouse focuses the fullscreen button which closes the preview -->
        <control type="button" id="9001">
            <texturefocus />
            <texturenofocus />
            <onfocus>Close</onfocus>
            <onclick>Close</onclick>
        </control>
    </controls>
</window>
