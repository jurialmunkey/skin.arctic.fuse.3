    <include name="View_Combined_Selector_HiddenButton_OnFocus">
        <definition>
            <!-- Commit the category only after it has kept focus for 400 ms. -->
            <animation effect="fade" start="100" end="100" time="400" reversible="false">Focus</animation>
            <onfocus condition="Control.HasFocus($PARAM[id]) + Container($PARAM[id]).ListItem.IsFolder">SetProperty(ViewCombined.$PARAM[id].Path,$ESCINFO[Container($PARAM[id]).ListItem.FolderPath])</onfocus>
            <onfocus condition="Control.HasFocus($PARAM[id]) + !Container($PARAM[id]).ListItem.IsFolder">ClearProperty(ViewCombined.$PARAM[id].Path)</onfocus>
            <onfocus condition="Control.HasFocus($PARAM[id])">SetProperty(ViewCombined.$PARAM[id].Directory,$ESCINFO[Container.FolderPath])</onfocus>
        </definition>
    </include>

