<?xml version="1.0" encoding="UTF-8"?>
<window>
    <controls>
        <control type="image">
            <description>
                The page is read against a plain dark background rather than the game,
                which is still running underneath and would show through scanned paper.
            </description>
            <left>0</left>
            <top>0</top>
            <width>100%</width>
            <height>100%</height>
            <texture colordiffuse="main_bg_100">common/white.png</texture>
        </control>

        <control type="group">
            <animation effect="fade" time="200">WindowOpen</animation>
            <animation effect="fade" time="200">WindowClose</animation>

            <control type="image" id="100">
                <description>
                    The page itself. script.game.manuals fits the page to this area,
                    which stops short of the labels and leaves room either side for
                    the page-turn hints, then moves and resizes it to zoom and pan.
                </description>
                <left>240</left>
                <top>0</top>
                <width>1440</width>
                <height>960</height>
                <aspectratio>stretch</aspectratio>
                <fadetime>150</fadetime>
            </control>

            <control type="group">
                <description>Which buttons turn the page, until the page is zoomed into</description>
                <visible>String.IsEmpty(Window.Property(zoomed))</visible>
                <animation effect="fade" time="200">VisibleChange</animation>
                <control type="group">
                    <left>40</left>
                    <centertop>480</centertop>
                    <width>140</width>
                    <height>80</height>
                    <control type="image">
                        <left>0</left>
                        <width>80</width>
                        <aspectratio>keep</aspectratio>
                        <texture colordiffuse="main_fg_90">special://skin/extras/icons/gamepad-bumper-left.png</texture>
                    </control>
                    <control type="image">
                        <left>100</left>
                        <centertop>50%</centertop>
                        <width>40</width>
                        <height>40</height>
                        <aspectratio>keep</aspectratio>
                        <texture colordiffuse="main_fg_90">special://skin/extras/icons/circle-arrow-left.png</texture>
                    </control>
                </control>
                <control type="group">
                    <right>40</right>
                    <centertop>480</centertop>
                    <width>140</width>
                    <height>80</height>
                    <control type="image">
                        <left>0</left>
                        <centertop>50%</centertop>
                        <width>40</width>
                        <height>40</height>
                        <aspectratio>keep</aspectratio>
                        <texture colordiffuse="main_fg_90">special://skin/extras/icons/circle-arrow-right.png</texture>
                    </control>
                    <control type="image">
                        <left>60</left>
                        <width>80</width>
                        <aspectratio>keep</aspectratio>
                        <texture colordiffuse="main_fg_90">special://skin/extras/icons/gamepad-bumper-right.png</texture>
                    </control>
                </control>
            </control>

            <control type="image">
                <description>
                    A zoomed page fills the screen and passes under the labels, so they are
                    given something to sit on rather than being read against the paper.
                </description>
                <left>0</left>
                <top>960</top>
                <width>100%</width>
                <height>120</height>
                <texture colordiffuse="main_bg_90">common/white.png</texture>
            </control>

            <control type="label">
                <left>60</left>
                <top>1000</top>
                <width>1260</width>
                <height>40</height>
                <aligny>center</aligny>
                <font>font_mini</font>
                <textcolor>main_fg_90</textcolor>
                <label>$INFO[Window.Property(title)]</label>
            </control>

            <control type="label">
                <left>1380</left>
                <right>60</right>
                <top>1000</top>
                <height>40</height>
                <align>right</align>
                <aligny>center</aligny>
                <font>font_mini</font>
                <textcolor>main_fg_70</textcolor>
                <label>$INFO[Window.Property(page)]</label>
            </control>
        </control>
    </controls>
</window>
