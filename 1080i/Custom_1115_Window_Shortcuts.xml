<?xml version="1.0" encoding="UTF-8"?>
<window type="window" id="1115">
    <defaultcontrol always="true">30000</defaultcontrol>
    <onload>ClearProperty(url)</onload>
    <onload>ClearProperty(forced)</onload>
    <onload>ClearProperty(menu)</onload>
    <onload>ClearProperty(mode)</onload>
    <onload>ClearProperty(guid)</onload>
    <onload>ClearProperty(list_id)</onload>
    <onload>ClearProperty(widgetonly_menu)</onload>
    <!-- Migrate existing hub settings into the hubs menu before the hubs list can create it from the defaults -->
    <onload>RunScript(script.skinvariables,run_executebuiltin=special://skin/shortcuts/skinvariables-migrate.json,use_rules=True)</onload>
    <include>Action_Blur_Onload</include>
    <include content="Hub_Onload_Window">
        <param name="window">1109</param>
    </include>
    <onload>SetFocus(30000,1,absolute)</onload>
    <include>Action_BuildShortcuts_OnUnLoad</include>
    <controls>


        <include>Background</include>

        <include content="Settings_Dialog">
            <include content="Settings_Main_Group">
                <param name="label">$LOCALIZE[31114]</param>
                <include content="Settings_Left_Group">
                    <include content="Settings_Left_Content">

                        <!-- Search, Home, the enabled hubs with a divider between the two sides of the horizontal hubs menu (menu slots 0-3 left, 4-7 right) and Power,
                             then Add hub (opens 1133 to enable a disabled item). Focus goes to the row buttons 30910, moved off the divider when a refresh leaves it selected.
                             Moves still work with disabled hubs left out as they offset to the neighbour's menu index -->
                        <include content="List_DialogSelect">
                            <param name="id">30000</param>
                            <param name="itemlayout_include">Layout_ShortcutCategories</param>
                            <param name="textcolor">main_fg</param>
                            <param name="altfocus">!Control.HasFocus(20)</param>
                            <right>40</right>
                            <bottom>80</bottom>
                            <onfocus condition="String.IsEqual(Container(30000).ListItem.Property(divider),True)">Control.Move(30000,1)</onfocus>
                            <onfocus>SetFocus(30910)</onfocus>
                            <include>DialogShortcuts_Hubs_StaticTop</include>
                            <include content="HubsWindow_Hubs_Side">
                                <param name="operator">lt</param>
                            </include>
                            <include>HubsWindow_Hubs_Divider</include>
                            <include content="HubsWindow_Hubs_Side">
                                <param name="operator">ge</param>
                            </include>
                            <include>DialogShortcuts_Hubs_StaticBottom</include>
                        </include>

                        <include>HubsWindow_Disabled_Counter</include>
                        <include>HubsWindow_Slots_List</include>

                        <include content="HubsWindow_Menu_Counter">
                            <param name="id">30920</param>
                            <param name="suffix">submenu</param>
                        </include>
                        <include content="HubsWindow_Menu_Counter">
                            <param name="id">30921</param>
                            <param name="suffix">widgets</param>
                        </include>

                        <!-- Row buttons: the focus of the hubs list, placed over the focused row like the shortcuts editor (1116).
                             Up/down moves through the list, skipping the divider, and the buttons move the item.
                             Rows that cannot move have a blank button instead, which opens 1133 on Add hub -->
                        <control type="grouplist" id="30910">
                            <orientation>horizontal</orientation>
                            <itemgap>-20</itemgap>
                            <align>right</align>
                            <right>50</right>
                            <height>72</height>
                            <centertop>40</centertop>
                            <include>HubsWindow_Row_Positions</include>
                            <onup condition="!String.IsEmpty(Container(30000).ListItemNoWrap(-1).Label) + !$EXP[Exp_HubsWindow_DividerAbove]">Control.Move(30000,-1)</onup>
                            <onup condition="$EXP[Exp_HubsWindow_DividerAbove]">Control.Move(30000,-2)</onup>
                            <onup condition="String.IsEmpty(Container(30000).ListItemNoWrap(-1).Label)">SetFocus(30000,99999,absolute)</onup>
                            <ondown condition="!String.IsEmpty(Container(30000).ListItemNoWrap(1).Label) + !$EXP[Exp_HubsWindow_DividerBelow]">Control.Move(30000,1)</ondown>
                            <ondown condition="$EXP[Exp_HubsWindow_DividerBelow]">Control.Move(30000,2)</ondown>
                            <ondown condition="String.IsEmpty(Container(30000).ListItemNoWrap(1).Label)">SetFocus(30000,0,absolute)</ondown>
                            <onright>340</onright>
                            <include content="DialogShortcuts_MoveButton">
                                <param name="id">30911</param>
                                <param name="move">-1</param>
                                <param name="target">$VAR[Path_HubsWindow_Move_Up]</param>
                                <param name="texture">special://skin/extras/icons/circle-arrow-up.png</param>
                                <param name="container">30000</param>
                                <param name="onback" />
                                <param name="visible">$EXP[Exp_HubsWindow_CanMoveUp]</param>
                                <include content="HubsWindow_Move_Refocus_Onclick">
                                    <param name="condition">$EXP[Exp_HubsWindow_DividerAbove]</param>
                                </include>
                            </include>
                            <include content="DialogShortcuts_MoveButton">
                                <param name="id">30912</param>
                                <param name="move">1</param>
                                <param name="target">$VAR[Path_HubsWindow_Move_Down]</param>
                                <param name="texture">special://skin/extras/icons/circle-arrow-down.png</param>
                                <param name="container">30000</param>
                                <param name="onback" />
                                <param name="visible">$EXP[Exp_HubsWindow_CanMoveDown]</param>
                                <include content="HubsWindow_Move_Refocus_Onclick">
                                    <param name="condition">$EXP[Exp_HubsWindow_DividerBelow]</param>
                                </include>
                            </include>
                            <control type="button" id="30913">
                                <width>1</width>
                                <height>72</height>
                                <texturefocus />
                                <texturenofocus />
                                <font />
                                <onclick condition="$EXP[Exp_HubsWindow_Item_Add]">ActivateWindow(1133)</onclick>
                                <visible>!$EXP[Exp_HubsWindow_CanMoveUp] + !$EXP[Exp_HubsWindow_CanMoveDown]</visible>
                            </control>
                        </control>
                    </include>
                </include>


                <include content="Settings_Right_Group">
                    <param name="header_include">HubsWindow_Header</param>
                    <!-- Settings in the left half, the preview in the right half -->
                    <include content="Settings_Right_Scrollbar">
                        <centerright>50%</centerright>
                        <onleft>3000</onleft>
                    </include>

                    <control type="group" id="340">
                        <right>50%</right>
                        <include content="Settings_Right_Grouplist">
                            <param name="id">3000</param>
                            <onleft>30000</onleft>

                            <include content="DialogShortcuts_Items_Basic">
                                <param name="container">30000</param>
                                <param name="enabled">$EXP[Exp_HubsWindow_Item_Enabled]</param>
                                <param name="toggle_icon">$VAR[Image_HubsWindow_EnableDisable]</param>
                                <param name="toggle_label">$VAR[Label_HubsWindow_EnableDisable]</param>
                                <param name="static">$EXP[Exp_HubsWindow_Item_Static]</param>
                                <param name="static_home">$EXP[Exp_HubsWindow_Item_Home]</param>
                                <param name="widgets">false</param>
                                <param name="subgroups">false</param>
                                <param name="onback">30000</param>
                                <param name="window">shortcuts</param>
                                <param name="include_after_toggle">DialogShortcuts_Window_Settings_Hubs_Main</param>
                                <param name="shortcut_label">true</param>
                                <param name="item_label2">true</param>
                            </include>

                            <!-- Options label when the item has its own options: Search, Power, Next Aired, Live TV and Add-ons -->
                            <include content="Settings_Label">
                                <param name="id">9001</param>
                                <param name="window">shortcuts</param>
                                <label>$LOCALIZE[33063]</label>
                                <visible>$EXP[Exp_HubsWindow_Item_Enabled] | String.IsEqual(Container(30000).ListItem.Property(static),power)</visible>
                                <visible>String.IsEqual(Container(30000).ListItem.Property(editmenu),menu=search) | String.IsEqual(Container(30000).ListItem.Property(editmenu),menu=power) | $EXP[Exp_HubsWindow_Type_NextAired] | $EXP[Exp_HubsWindow_Type_LiveTV] | $EXP[Exp_HubsWindow_Type_Addons]</visible>
                            </include>
                            <include>DialogShortcuts_Window_Settings_Search</include>
                            <include>DialogShortcuts_Window_Settings_Hubs</include>
                            <include>DialogShortcuts_Window_Settings_Power</include>
                        </include>
                    </control>

                    <include>HubsWindow_Preview</include>

                    <include>Settings_Right_InfoText</include>
                </include>
            </include>



        </include>

    </controls>
</window>
