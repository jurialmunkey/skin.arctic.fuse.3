            <param name="items">DialogProcessInfo_Items_LiveTV</param>
            <param name="onleft">7</param>
            <param name="onright">5</param>
        </include>
    </include>

    <!-- One category list. Hidden lists keep hidden focus so left and right can still reach them, and switch without animating -->
    <include name="DialogProcessInfo_Category">
        <param name="onleft">noop</param>
        <param name="onright">noop</param>
        <definition>
            <control type="group">
                <visible allowhiddenfocus="true">Control.HasFocus($PARAM[id])</visible>
                <include content="OSD_Stream_Row">
                    <param name="id">$PARAM[id]</param>
                    <param name="buttonid">noop</param>
                    <param name="scrollbar">$PARAM[id]1</param>
                    <param name="visible_animation">false</param>
                    <param name="onleft">$PARAM[onleft]</param>
                    <param name="onright">$PARAM[onright]</param>
                    <onclick>RunScript(script.skinvariables,run_dialog=ok,"heading=$INFO[Container($PARAM[id]).ListItem.Label]","message=$INFO[Container($PARAM[id]).ListItem.Property(hint)]$INFO[Container($PARAM[id]).ListItem.Property(sub),[CR],]")</onclick>
                    <include>$PARAM[items]</include>
                </include>
            </control>
        </definition>
    </include>

    <!-- A process row: the value over its hint and detail, with short codec values as tags on the right.
         Hidden while its info is empty or unknown -->
    <include name="DialogProcessInfo_Node">
        <param name="sub" />
        <param name="tags" />
        <definition>
            <item>
                <label>$PARAM[value]</label>
                <icon>special://skin/extras/icons/$PARAM[icon].png</icon>
                <property name="hint">$PARAM[hint]</property>
                <property name="sub">$PARAM[sub]</property>
                <property name="tags">$PARAM[tags]</property>
                <visible>!String.IsEmpty($PARAM[info])</visible>
                <visible>!String.IsEqual($PARAM[info],$LOCALIZE[13205])</visible>
            </item>
        </definition>
    </include>

