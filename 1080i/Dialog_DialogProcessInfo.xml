        <include content="DialogProcessInfo_Category">
            <param name="id">5</param>
            <param name="items">DialogProcessInfo_Items_Video</param>
            <param name="onleft">SetFocus($VAR[Action_PlayerProcess_Wrap])</param>
            <param name="onright">6</param>
        </include>
