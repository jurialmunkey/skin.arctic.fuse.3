<?xml version="1.0" encoding="UTF-8"?>
<!-- Window for SkinVariables run_multisearch with the mediatype_lists and tmdbhelper_container params. The script searches the shortcuts
     searchwidgets menu with the text of edit 100 using the paths in shortcuts/skinvariables-multisearch-paths.json.
     It lists all results in the container for their most common widget style from
     shortcuts/skinvariables-multisearch-containers.json, with landscape 50 as the fallback for other styles, and the
     results of each content type in lists 501 to 510. Results count towards the style of their content type from
     shortcuts/skinvariables-multisearch-styles.json, or the style of their source when the type has none. The script
     sets the local TMDbHelper.WidgetContainer to the shown all results container. -->
<window>
    <onload>ClearProperty(Background.ShowOverlay,Home)</onload>
    <include>Action_Blur_Onload</include>

    <menucontrol>300</menucontrol>
    <include content="Object_DefaultControl">
        <param name="defaultcontrol">3001</param>
        <param name="always">false</param>
    </include>

    <controls>
        <!-- Kodi only fills a nested tag at the top of an include, so the results containers are in MultiSearch -->
        <include>MultiSearch</include>
    </controls>
</window>
