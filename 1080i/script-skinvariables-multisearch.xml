<?xml version="1.0" encoding="UTF-8"?>
<!-- Window for SkinVariables run_multisearch. The script searches the shortcuts searchwidgets menu with the text of edit 100
     using the paths in shortcuts/skinvariables-multisearch-paths.json and lists the combined results in 50. -->
<window>
    <onload>ClearProperty(Background.ShowOverlay,Home)</onload>
    <include>Action_Blur_Onload</include>

    <menucontrol>300</menucontrol>
    <include content="Object_DefaultControl">
        <param name="defaultcontrol">3001</param>
        <param name="always">false</param>
    </include>

    <controls>
        <include>MultiSearch</include>

        <!-- The script reads grouplist 200 and button template 201 from this file, so they are not in an include -->
        <include content="MultiSearch_Sources">
            <param name="id">200</param>
            <include content="MultiSearch_Source_Button">
                <param name="id">201</param>
            </include>
        </include>
    </controls>
</window>
