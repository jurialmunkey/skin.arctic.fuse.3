<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <include name="Search_Bar_Defs">
        <left>-20</left>
        <width>800</width>
        <height>80</height>
        <centertop>50%</centertop>
    </include>

    <!-- Multisearch edit 100 with its quick keyboard 101 below it, the hub buttons and the header -->
    <include name="Search_Bar">
        <definition>
            <control type="group">
                <animation effect="slide" start="0" end="0,-70" condition="Skin.HasSetting(HomeSwitcher.DisableHeader) | Skin.HasSetting(HomeSwitcher.Vertical)">Conditional</animation>
                <control type="group">
                    <include>Home_Group_Definition</include>
                    <control type="group">
                        <include>Search_Bar_Defs</include>
                        <include>Search_Bar_Edit</include>
                        <include>Search_Bar_Icon</include>
                        <include>Search_Bar_Keys</include>
                    </control>
                    <include condition="!Skin.HasSetting(HomeSwitcher.Vertical)">Home_Switcher_Right_Buttons</include>
                </control>

                <include content="Furniture_Header" condition="!Skin.HasSetting(HomeSwitcher.DisableHeader) + !Skin.HasSetting(HomeSwitcher.Vertical)">
                    <param name="label">$VAR[Home_Header_Label]</param>
                </include>
                <nested />
            </control>
        </definition>
    </include>

    <include name="Search_Bar_Edit">
        <definition>

            <!-- Backing Panel -->
            <control type="image">
                <texture colordiffuse="main_fg_12" border="40">common/menu-outlined.png</texture>
                <visible>!Control.HasFocus(100)</visible>
            </control>
            <control type="image">
                <include>Texture_Menu_Highlight_H</include>
                <visible>Control.HasFocus(100)</visible>
            </control>

            <!-- Edit Control -->
            <control type="button" id="3001">

                <onfocus condition="Skin.HasSetting(HomeSwitcher.Vertical)">ClearProperty(HomeSwitcher.IsVisible,Home)</onfocus>
                <onfocus condition="!Skin.HasSetting(HomeSwitcher.Vertical)">SetProperty(HomeSwitcher.IsVisible,True,Home)</onfocus>

                <onfocus condition="String.IsEmpty(Window.Property(RefocusMenu))">SetFocus(100)</onfocus>
                <onfocus condition="!String.IsEmpty(Window.Property(RefocusMenu))">SetFocus(300)</onfocus>
                <onfocus>ClearProperty(RefocusMenu)</onfocus>

                <onleft>100</onleft>
                <onright>100</onright>
                <onup>100</onup>
                <ondown>100</ondown>

                <include>Object_Hidden_Button_Definition</include>
            </control>
            <control type="edit" id="100">
                <left>40</left>
                <font>font_main</font>
                <textcolor>main_fg_30</textcolor>
                <focusedcolor>$VAR[ColorSelected]</focusedcolor>
                <align>left</align>

                <onleft condition="Skin.HasSetting(HomeSwitcher.Vertical)">SetProperty(RefocusMenu,True)</onleft>
                <onleft condition="Skin.HasSetting(HomeSwitcher.Vertical)">3001</onleft>

                <onright condition="Skin.HasSetting(HomeSwitcher.Vertical)">SetProperty(Bumper.Direction,Right,Home)</onright>
                <onright condition="Skin.HasSetting(HomeSwitcher.Vertical)">ActivateWindow(1180)</onright>


                <!-- The window opens from Home so moving to the next hub closes it. Moving right is the only way the
                     skin closes it, through the script's hidden close button 109 -->
                <onleft condition="!Skin.HasSetting(HomeSwitcher.Vertical)">$INFO[Container(399).ListItem(-1).Property(action)]</onleft>
                <onright condition="!Skin.HasSetting(HomeSwitcher.Vertical)">SendClick(109)</onright>

                <ondown>101</ondown>

                <texturefocus />
                <texturenofocus />
            </control>
        </definition>
    </include>

    <include name="Search_Bar_Icon">
        <definition>
            <control type="group">
                <left>0</left>
                <width>80</width>
                <control type="image">
                    <include>Home_Grouplist_Icon_Definition</include>
                    <texture background="true" colordiffuse="main_fg_30">special://skin/extras/icons/search.png</texture>
                    <visible>!Control.HasFocus(100)</visible>
                </control>
                <control type="image">
                    <include>Home_Grouplist_Icon_Definition</include>
                    <texture background="true" colordiffuse="$VAR[ColorSelected]">special://skin/extras/icons/search.png</texture>
                    <visible>Control.HasFocus(100)</visible>
                </control>
            </control>
        </definition>
    </include>

    <!-- Quick keyboard that the window script fills with keys -->
    <include name="Search_Bar_Keys">
        <definition>
            <control type="panel" id="101">
                <orientation>vertical</orientation>
                <onunfocus condition="Skin.HasSetting(HomeSwitcher.Vertical)">ClearProperty(HomeSwitcher.IsVisible,Home)</onunfocus>
                <onfocus condition="!Skin.HasSetting(HomeSwitcher.Vertical)">SetProperty(HomeSwitcher.IsVisible,True,Home)</onfocus>
                <!-- <onup>3000</onup> -->
                <onup>ClearProperty(RefocusMenu)</onup>
                <onup>3001</onup>
                <include content="MultiSearch_OnBack" />
                <ondown>102</ondown>
                <width>700</width>
                <!-- <width>750</width>
                <focusposition>7</focusposition> -->
                <centerleft>50%</centerleft>
                <height>100</height>
                <top>95</top>

                <onfocus>ClearProperty(Background.ShowOverlay,Home)</onfocus>

                <itemlayout width="50" height="50">
                    <control type="label">
                        <font>font_main</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>dialog_fg_30</textcolor>
                        <align>center</align>
                        <height>35</height>
                    </control>
                </itemlayout>

                <focusedlayout width="50" height="50">

                    <control type="label">
                        <visible>!Control.HasFocus(101)</visible>
                        <font>font_main</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>dialog_fg_30</textcolor>
                        <align>center</align>
                        <height>35</height>
                    </control>

                    <control type="group">
                        <visible>Control.HasFocus(101)</visible>
                        <control type="label">
                            <font>font_main_bold</font>
                            <label>$INFO[ListItem.Label]</label>
                            <textcolor>dialog_fg_100</textcolor>
                            <align>center</align>
                            <height>35</height>
                        </control>
                        <control type="image">
                            <include>Texture_Highlight_Scrollbar_H</include>
                            <height>scrollbar_w</height>
                            <bottom>5</bottom>
                            <width>75%</width>
                            <centerleft>50%</centerleft>
                        </control>
                    </control>
                </focusedlayout>
            </control>
        </definition>
    </include>

    <!-- SkinVariables multisearch window. The script searches the text of edit 100, fills keys 101 and the results of
         group 49 and opens the source and sort selections from buttons 102 and 103. Group 49 holds the results of the
         standard or combined layout, and the combined layout adds the source list of the id param.
         The script never closes the window on back. SendClick(109) asks it to close so it stores the search text -->
    <include name="MultiSearch">
        <include>Hub_Window_Background</include>
        <include content="Object_Hidden_Button">
            <param name="id">109</param>
        </include>
        <include content="Home_Control">
            <param name="window">MultiSearch</param>
            <param name="overlay">[false]</param>
            <param name="fade_visible">$EXP[Exp_MultiSearch_Searchbar_IsVisible]</param>
            <param name="multisearch">true</param>
            <onfocus condition="!Skin.HasSetting(HomeSwitcher.Vertical)">SetFocus(3001)</onfocus>
        </include>

        <control type="group">
            <include>Animation_Group_Bumper</include>

            <control type="group">
                <include condition="Skin.HasSetting(HomeSwitcher.Vertical)">Hub_Window_Side_Slide</include>

                <!-- Content -->
                <control type="group" id="400">
                    <include>Animation_View_WindowChange</include>
                    <include content="Search_Bar">
                        <visible allowhiddenfocus="true">$EXP[Exp_MultiSearch_Searchbar_IsVisible]</visible>
                        <include>Home_Animation</include>
                        <include>MultiSearch_Buttons</include>
                    </include>
                    <control type="group" id="49">
                        <include condition="!Skin.HasSetting(HomeSwitcher.Search.Combined)">MultiSearch_Results_Standard</include>
                        <include content="MultiSearch_Results_Combined" condition="Skin.HasSetting(HomeSwitcher.Search.Combined)">
                            <param name="id">$PARAM[id]</param>
                        </include>
                    </control>
                    <include>MultiSearch_Empty</include>
                </control>

                <include>MultiSearch_Info</include>

                <include condition="Skin.HasSetting(HomeSwitcher.Vertical)">Hub_VertMenu</include>
            </control>
        </control>
    </include>

    <!-- Info panel of the focused result. Shown in place of the search bar while the results list has focus -->
    <include name="MultiSearch_Info">
        <control type="group">
            <visible>!$EXP[Exp_MultiSearch_Searchbar_IsVisible]</visible>
            <include>Info_Panel_Dimensions</include>
            <include>Home_Info_Animation</include>
            <include content="Info_Panel">
                <!-- Without a container the panel reads the focused results container -->
                <param name="visible">!$EXP[Exp_InfoDialogs]</param>
            </include>
        </control>
    </include>

    <!-- Chosen content type, genre and decade filters, or the script's Any label when no filter is set.
         The content type filter is a DBType so it is shown with the same Kodi labels as the script's select dialog -->
    <variable name="MultiSearch_DBType_Label">
        <value condition="String.IsEqual(Window.Property(SkinVariables.MultiSearch.DBType),movie)">$LOCALIZE[20338]</value>
        <value condition="String.IsEqual(Window.Property(SkinVariables.MultiSearch.DBType),set)">$LOCALIZE[20434]</value>
        <value condition="String.IsEqual(Window.Property(SkinVariables.MultiSearch.DBType),tvshow)">$LOCALIZE[36903]</value>
        <value condition="String.IsEqual(Window.Property(SkinVariables.MultiSearch.DBType),season)">$LOCALIZE[20373]</value>
        <value condition="String.IsEqual(Window.Property(SkinVariables.MultiSearch.DBType),episode)">$LOCALIZE[20359]</value>
        <value condition="String.IsEqual(Window.Property(SkinVariables.MultiSearch.DBType),musicvideo)">$LOCALIZE[20391]</value>
        <value condition="String.IsEqual(Window.Property(SkinVariables.MultiSearch.DBType),artist)">$LOCALIZE[557]</value>
        <value condition="String.IsEqual(Window.Property(SkinVariables.MultiSearch.DBType),album)">$LOCALIZE[558]</value>
        <value condition="String.IsEqual(Window.Property(SkinVariables.MultiSearch.DBType),song)">$LOCALIZE[179]</value>
        <value condition="!String.IsEmpty(Window.Property(SkinVariables.MultiSearch.DBType))">$INFO[Window.Property(SkinVariables.MultiSearch.DBType)]</value>
        <value>$ADDON[script.skinvariables 32100]</value>
    </variable>
    <!-- The script gives All or the labels of the enabled sources, so several enabled sources are shown as Custom -->
    <variable name="MultiSearch_Sources_Label">
        <value condition="Integer.IsGreater(Window.Property(SkinVariables.MultiSearch.Sources.Enabled),1) + !String.IsEqual(Window.Property(SkinVariables.MultiSearch.Sources.Label),$LOCALIZE[593])">$LOCALIZE[31639]</value>
        <value condition="!String.IsEmpty(Window.Property(SkinVariables.MultiSearch.Sources.Label))">$INFO[Window.Property(SkinVariables.MultiSearch.Sources.Label)]</value>
        <value>$LOCALIZE[593]</value>
    </variable>
    <variable name="MultiSearch_Genre_Label">
        <value condition="!String.IsEmpty(Window.Property(SkinVariables.MultiSearch.Genre))">$INFO[Window.Property(SkinVariables.MultiSearch.Genre)]</value>
        <value>$ADDON[script.skinvariables 32100]</value>
    </variable>
    <variable name="MultiSearch_Decade_Label">
        <value condition="!String.IsEmpty(Window.Property(SkinVariables.MultiSearch.Decade))">$INFO[Window.Property(SkinVariables.MultiSearch.Decade)]</value>
        <value>$ADDON[script.skinvariables 32100]</value>
    </variable>

    <!-- Row of search option buttons below the keyboard -->
    <include name="MultiSearch_Button_Row">
        <control type="grouplist">
            <left>view_pad</left>
            <right>view_pad</right>
            <top>$PARAM[top]</top>
            <height>57</height>
            <itemgap>40</itemgap>
            <orientation>horizontal</orientation>
            <onup>$PARAM[onup]</onup>
            <ondown>$PARAM[ondown]</ondown>
            <include>Hub_Grouplist_OnLeftRight</include>
            <nested />
        </control>
    </include>

    <!-- Back from any multisearch control returns to the search edit through 3001 -->
    <include name="MultiSearch_OnBack">
        <param name="condition">true</param>
        <definition>
            <onback condition="$PARAM[condition]">ClearProperty(RefocusMenu)</onback>
            <onback condition="$PARAM[condition]">3001</onback>
        </definition>
    </include>

    <!-- Search option button -->
    <include name="MultiSearch_Button">
        <include content="Button_Underline_Switcher">
            <param name="id">$PARAM[id]</param>
            <param name="control">button</param>
            <include content="MultiSearch_OnBack" />
            <nested />
        </include>
    </include>

    <!-- Sources, content type and reset, then sort and the genre and decade filters on their own row so long values have room -->
    <include name="MultiSearch_Buttons">
        <include content="MultiSearch_Button_Row">
            <param name="top">350</param>
            <param name="onup">101</param>
            <param name="ondown">103</param>
            <include content="MultiSearch_Button">
                <param name="id">102</param>
                <label>$LOCALIZE[31851]: $VAR[MultiSearch_Sources_Label] ⌄</label>
            </include>
            <include content="MultiSearch_Button">
                <param name="id">107</param>
                <label>$LOCALIZE[467]: $VAR[MultiSearch_DBType_Label] ⌄</label>
            </include>
            <include content="MultiSearch_Button">
                <param name="id">106</param>
                <label>$LOCALIZE[13007]</label>
            </include>
        </include>
        <include content="MultiSearch_Button_Row">
            <param name="top">410</param>
            <param name="onup">102</param>
            <param name="ondown">$VAR[MultiSearch_Action_Reset]</param>
            <include content="MultiSearch_Button">
                <param name="id">103</param>
                <label>$LOCALIZE[31016]$INFO[Window.Property(SkinVariables.MultiSearch.SortBy),: ,] ⌄</label>
            </include>
            <include content="MultiSearch_Button">
                <param name="id">104</param>
                <label>$LOCALIZE[515]: $VAR[MultiSearch_Genre_Label] ⌄</label>
            </include>
            <include content="MultiSearch_Button">
                <param name="id">105</param>
                <label>$LOCALIZE[31852]: $VAR[MultiSearch_Decade_Label] ⌄</label>
            </include>
        </include>
    </include>

    <!-- Standard layout, laid out like a standard hub widget set with a row for each content type -->
    <include name="MultiSearch_Results_Standard">
        <include content="Hub_Widgets_Grouplist">
            <param name="onup">103</param>
            <param name="bumper">false</param>
            <include content="MultiSearch_Results_All_Row">
                <param name="id">50</param>
                <param name="include">List_Landscape_Row</param>
            </include>
            <include content="MultiSearch_Results_All_Row">
                <param name="id">51</param>
                <param name="include">List_Poster_Row</param>
            </include>
            <include content="MultiSearch_Results_All_Row">
                <param name="id">52</param>
                <param name="include">List_Square_Row</param>
            </include>
            <include>MultiSearch_Results_MediaType_Rows</include>
        </include>
    </include>

    <!-- Combined layout, positioned like a combined hub: the source list above the all results containers -->
    <include name="MultiSearch_Results_Combined">
        <include content="MultiSearch_Combined_Source_List">
            <param name="id">$PARAM[id]</param>
        </include>
        <include content="MultiSearch_Combined_Container">
            <param name="id">50</param>
            <param name="sourceid">$PARAM[id]</param>
            <param name="include">List_Landscape_Row</param>
        </include>
        <include content="MultiSearch_Combined_Container">
            <param name="id">51</param>
            <param name="sourceid">$PARAM[id]</param>
            <param name="include">List_Poster_Row</param>
        </include>
        <include content="MultiSearch_Combined_Container">
            <param name="id">52</param>
            <param name="sourceid">$PARAM[id]</param>
            <param name="include">List_Square_Row</param>
        </include>
    </include>

    <!-- Source list that the script fills with all results, then each content type or each source with results as set
         by the source_buttons param. The selected item decides the results of the all
         results container. Placed like the combined hub widget switcher.
         The script reads the actions of the focused list, so the list keeps focus instead of a select button -->
    <include name="MultiSearch_Combined_Source_List">
        <control type="group">
            <top>520</top>
            <height>40</height>
            <visible>!$EXP[Exp_MultiSearch_IsEmpty]</visible>
            <control type="group">
                <left>view_pad</left>
                <include>View_Line_Divider</include>
            </control>
            <include content="Categories_Selector">
                <param name="id">$PARAM[id]</param>
                <param name="altfocusid">$PARAM[id]</param>
                <centertop>0</centertop>
                <height>80</height>
                <left>40</left>
                <onup>103</onup>
                <ondown>SetFocus($INFO[Window.Property(SkinVariables.MultiSearch.Container)])</ondown>
                <include>Hub_Grouplist_OnLeftRight</include>
                <onfocus>ClearProperty(HomeSwitcher.IsVisible,Home)</onfocus>
                <onfocus>ClearProperty(InfoPanel.FullSwitch,Home)</onfocus>
                <include content="MultiSearch_OnBack" />
            </include>
        </control>
    </include>

    <!-- All results container for one widget style, placed like a combined hub widget. Only the container the script
         chose is shown, and it shows the loading placeholders while the script searches -->
    <include name="MultiSearch_Combined_Container">
        <param name="visible">String.IsEqual(Window.Property(SkinVariables.MultiSearch.Container),$PARAM[id]) + !$EXP[Exp_MultiSearch_IsEmpty]</param>
        <definition>
            <include content="$PARAM[include]">
                <param name="id">$PARAM[id]</param>
                <param name="hidden_button_enabled">false</param>
                <top>510</top>
                <bottom>-40</bottom>
                <onup>$PARAM[sourceid]</onup>
                <include>Hub_Grouplist_OnLeftRight</include>
                <visible>$PARAM[visible]</visible>
                <include content="MultiSearch_Widget_Row_OnFocus">
                    <param name="id">$PARAM[id]</param>
                </include>
                <include content="MultiSearch_Widget_Row_OnBack">
                    <param name="id">$PARAM[id]</param>
                </include>
            </include>
            <include content="Widget_Busy">
                <param name="visible">$EXP[Exp_MultiSearch_IsBusy] + Integer.IsEqual(Container($PARAM[id]).NumItems,0)</param>
                <param name="include">$PARAM[include]</param>
                <top>510</top>
                <left>view_pad</left>
                <visible>$PARAM[visible]</visible>
            </include>
        </definition>
    </include>

    <!-- The script fills lists 501 to 510 with the results of each content type in the style set for it in
         shortcuts/skinvariables-multisearch-styles.json. The no_all_list param keeps the all results containers empty,
         so they only show the loading placeholders before the first results -->
    <include name="MultiSearch_Results_MediaType_Rows">
        <include content="MultiSearch_Results_Row">
            <param name="id">501</param>
            <param name="label">$LOCALIZE[342]</param>
            <param name="include">List_Poster_Row</param>
        </include>
        <include content="MultiSearch_Results_Row">
            <param name="id">502</param>
            <param name="label">$LOCALIZE[20434]</param>
            <param name="include">List_Poster_Row</param>
        </include>
        <include content="MultiSearch_Results_Row">
            <param name="id">503</param>
            <param name="label">$LOCALIZE[20343]</param>
            <param name="include">List_Poster_Row</param>
        </include>
        <include content="MultiSearch_Results_Row">
            <param name="id">504</param>
            <param name="label">$LOCALIZE[33054]</param>
            <param name="include">List_Poster_Row</param>
        </include>
        <include content="MultiSearch_Results_Row">
            <param name="id">505</param>
            <param name="label">$LOCALIZE[20360]</param>
            <param name="include">List_Landscape_Row</param>
        </include>
        <include content="MultiSearch_Results_Row">
            <param name="id">506</param>
            <param name="label">$LOCALIZE[20389]</param>
            <param name="include">List_Landscape_Row</param>
        </include>
        <include content="MultiSearch_Results_Row">
            <param name="id">507</param>
            <param name="label">$LOCALIZE[133]</param>
            <param name="include">List_Square_Row</param>
        </include>
        <include content="MultiSearch_Results_Row">
            <param name="id">508</param>
            <param name="label">$LOCALIZE[132]</param>
            <param name="include">List_Square_Row</param>
        </include>
        <include content="MultiSearch_Results_Row">
            <param name="id">509</param>
            <param name="label">$LOCALIZE[134]</param>
            <param name="include">List_Square_Row</param>
        </include>
        <include content="MultiSearch_Results_Row">
            <param name="id">510</param>
            <param name="label">$ADDON[script.skinvariables 32103]</param>
            <param name="include">List_Square_Row</param>
        </include>
    </include>

    <!-- Shown in place of the results rows while there are no results, laid out like a widget label and its items.
         Kept outside the results grouplist so it is not part of its navigation. The groups repeat the grouplist top,
         slide and bumper, then the label and items offsets of a widget row, so it sits where the first row would be -->
    <include name="MultiSearch_Empty">
        <control type="group">
            <top>widget_grouplist_t_detailed</top>
            <animation effect="slide" start="0" end="0,-440" condition="true">Conditional</animation>
            <visible>$EXP[Exp_MultiSearch_IsEmpty]</visible>
            <control type="group">
                <top>widget_tbump_h_detailed</top>
                <control type="group">
                    <top>widget_label_t</top>
                    <left>view_pad</left>
                    <right>view_pad</right>
                    <include content="View_Line">
                        <param name="label">$LOCALIZE[31861]</param>
                        <param name="top">20</param>
                        <param name="left">0</param>
                    </include>
                    <control type="group">
                        <top>widget_label_h_detailed</top>
                        <control type="group">
                            <top>widget_items_t_detailed</top>
                            <include>MultiSearch_Empty_Welcome</include>
                        </control>
                    </control>
                </control>
            </control>
        </control>
    </include>

    <!-- Centered vertically on the poster items, which List_Core offsets by 80 within the row -->
    <include name="MultiSearch_Empty_Welcome">
        <control type="group">
            <top>80</top>
            <height>view_poster_item_h</height>
            <control type="group">
                <centertop>50%</centertop>
                <height>180</height>
                <control type="label">
                    <top>0</top>
                    <height>80</height>
                    <font>font_head_bold</font>
                    <textcolor>main_fg_90</textcolor>
                    <label>$LOCALIZE[31281]</label>
                </control>
                <control type="textbox">
                    <top>80</top>
                    <height>100</height>
                    <width>1200</width>
                    <font>font_main_plot</font>
                    <textcolor>main_fg_70</textcolor>
                    <label>$VAR[MultiSearch_Empty_Label]</label>
                </control>
            </control>
        </control>
    </include>

    <!-- The script gives All or the labels of the enabled sources -->
    <variable name="MultiSearch_Empty_Label">
        <value condition="String.IsEmpty(Window.Property(SkinVariables.MultiSearch.Sources.Label)) | String.IsEqual(Window.Property(SkinVariables.MultiSearch.Sources.Label),$LOCALIZE[593])">$LOCALIZE[31863] $LOCALIZE[31864].[CR]$LOCALIZE[31865]</value>
        <value>$LOCALIZE[31863] $INFO[Window.Property(SkinVariables.MultiSearch.Sources.Label)].[CR]$LOCALIZE[31865]</value>
    </variable>

    <!-- All results row for one widget style. The no_all_list param keeps it empty, so the container the script chose
         only shows the loading placeholders while the script searches and no content type row has results yet -->
    <include name="MultiSearch_Results_All_Row">
        <include content="MultiSearch_Results_Row">
            <param name="id">$PARAM[id]</param>
            <param name="label">$LOCALIZE[31850]</param>
            <param name="include">$PARAM[include]</param>
            <param name="visible">String.IsEqual(Window.Property(SkinVariables.MultiSearch.Container),$PARAM[id])</param>
            <param name="altvisible">$EXP[Exp_MultiSearch_IsBusy] + !$EXP[Exp_MultiSearch_HasResults]</param>
        </include>
    </include>

    <!-- Results row that the script fills. Shown while it has results, like a standard hub widget row -->
    <include name="MultiSearch_Results_Row">
        <param name="visible">true</param>
        <param name="altvisible">false</param>
        <definition>
            <include content="MultiSearch_Widget_Row">
                <param name="id">$PARAM[id]</param>
                <param name="label">$PARAM[label]$INFO[Container($PARAM[id]).NumItems, (,)]</param>
                <param name="include">$PARAM[include]</param>
                <param name="visible">$PARAM[visible]</param>
                <param name="altvisible">$PARAM[altvisible]</param>
            </include>
        </definition>
    </include>

    <!-- Widget row for the script filled results. The script fills the lists so they never report IsUpdating and the
         busy property shows the loading placeholders instead -->
    <include name="MultiSearch_Widget_Row">
        <definition>
            <include content="Widget_Label">
                <param name="groupid">7$PARAM[id]</param>
                <param name="id">$PARAM[id]</param>
                <param name="label">$PARAM[label]</param>
                <param name="include">$PARAM[include]</param>
                <param name="labelheight">widget_label_h_detailed</param>
                <param name="visible">$PARAM[visible] + [!Integer.IsEqual(Container($PARAM[id]).NumItems,0) | $PARAM[altvisible]]</param>
                <param name="busy_visible">$EXP[Exp_MultiSearch_IsBusy] + Integer.IsEqual(Container($PARAM[id]).NumItems,0)</param>
                <param name="busy_spinner">$EXP[Exp_MultiSearch_IsBusy]</param>
                <include content="Animation_Widget_FadeOut">
                    <param name="condition">!Control.HasFocus($PARAM[id]) + !Integer.IsEqual(Window.Property(TMDbHelper.WidgetContainer),$PARAM[id])</param>
                </include>
            </include>
            <include content="$PARAM[include]">
                <param name="id">$PARAM[id]</param>
                <param name="detailed">false</param>
                <param name="hidden_button_enabled">false</param>
                <top>widget_items_t_detailed</top>
                <height>widget_items_h</height>
                <visible>$PARAM[visible] + [!Integer.IsEqual(Container($PARAM[id]).NumItems,0) | $PARAM[altvisible]]</visible>
                <include content="Object_HitRect">
                    <param name="x">0</param>
                    <param name="y">130</param>
                    <param name="w">1920</param>
                    <param name="h">view_poster_itemlayout_h</param>
                </include>
                <include content="Animation_Widget_FadeOut">
                    <param name="condition">!Control.HasFocus($PARAM[id]) + !Integer.IsEqual(Window.Property(TMDbHelper.WidgetContainer),$PARAM[id])</param>
                </include>
                <include content="MultiSearch_Widget_Row_OnFocus">
                    <param name="id">$PARAM[id]</param>
                </include>
                <include content="MultiSearch_Widget_Row_OnBack">
                    <param name="id">$PARAM[id]</param>
                </include>
            </include>
        </definition>
    </include>

    <include name="MultiSearch_Widget_Row_OnFocus">
        <onfocus>SetProperty(TMDbHelper.WidgetContainer,$PARAM[id])</onfocus>
        <onfocus>ClearProperty(Background.HideArtwork)</onfocus>
        <onfocus>ClearProperty(Background.ShowOverlay,Home)</onfocus>
        <onfocus>ClearProperty(HomeSwitcher.IsVisible,Home)</onfocus>
        <onfocus>ClearProperty(InfoPanel.FullSwitch,Home)</onfocus>
    </include>

    <!-- First visible results control: the combined source list, the all results container, then the content type rows -->
    <variable name="MultiSearch_Action_Reset">
        <value condition="Control.IsVisible(200)">SetFocus(200)</value>
        <value condition="Control.IsVisible(50)">SetFocus(50)</value>
        <value condition="Control.IsVisible(51)">SetFocus(51)</value>
        <value condition="Control.IsVisible(52)">SetFocus(52)</value>
        <value>$VAR[Hub_Action_Reset]</value>
    </variable>

    <!-- Back moves to the first item, then from the first item focuses the first row so the grouplist scrolls back to
         the top and returns to the search edit. Each branch focuses a raw control id so Kodi does not also close the window -->
    <include name="MultiSearch_Widget_Row_OnBack">
        <onback condition="$EXP[Exp_Navigation_OnPrevious] + !Integer.IsEqual(Container($PARAM[id]).CurrentItem,1)">$PARAM[id]</onback>
        <onback condition="$EXP[Exp_Navigation_OnPrevious] + !Integer.IsEqual(Container($PARAM[id]).CurrentItem,1)">SetFocus($PARAM[id],0,absolute)</onback>
        <onback condition="Integer.IsEqual(Container($PARAM[id]).CurrentItem,1) | $EXP[Exp_Navigation_OnParent]">$VAR[MultiSearch_Action_Reset]</onback>
        <include content="MultiSearch_OnBack">
            <param name="condition">Integer.IsEqual(Container($PARAM[id]).CurrentItem,1) | $EXP[Exp_Navigation_OnParent]</param>
        </include>
    </include>

</includes>
