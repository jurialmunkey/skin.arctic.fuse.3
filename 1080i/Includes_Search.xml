<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <include name="Search_Bar_Defs">
        <left>-20</left>
        <width>800</width>
        <height>80</height>
        <centertop>50%</centertop>
    </include>

    <!-- Multisearch edit 100 with its quick keyboard 101 below it, the hub buttons and the header -->
    <include name="Search_Bar">
        <definition>
            <control type="group">
                <animation effect="slide" start="0" end="0,-70" condition="Skin.HasSetting(HomeSwitcher.DisableHeader) | Skin.HasSetting(HomeSwitcher.Vertical)">Conditional</animation>
                <control type="group">
                    <include>Home_Group_Definition</include>
                    <control type="group">
                        <include>Search_Bar_Defs</include>
                        <include>Search_Bar_Edit</include>
                        <include>Search_Bar_Icon</include>
                        <include>Search_Bar_Keys</include>
                    </control>
                    <include condition="!Skin.HasSetting(HomeSwitcher.Vertical)">Home_Switcher_Right_Buttons</include>
                </control>

                <include content="Furniture_Header" condition="!Skin.HasSetting(HomeSwitcher.DisableHeader) + !Skin.HasSetting(HomeSwitcher.Vertical)">
                    <param name="label">$VAR[Home_Header_Label]</param>
                </include>
                <nested />
            </control>
        </definition>
    </include>

    <include name="Search_Bar_Edit">
        <definition>

            <!-- Backing Panel -->
            <control type="image">
                <texture colordiffuse="main_fg_12" border="40">common/menu-outlined.png</texture>
                <visible>!Control.HasFocus(100)</visible>
            </control>
            <control type="image">
                <include>Texture_Menu_Highlight_H</include>
                <visible>Control.HasFocus(100)</visible>
            </control>

            <!-- Edit Control -->
            <control type="button" id="3001">

                <onfocus condition="Skin.HasSetting(HomeSwitcher.Vertical)">ClearProperty(HomeSwitcher.IsVisible,Home)</onfocus>
                <onfocus condition="!Skin.HasSetting(HomeSwitcher.Vertical)">SetProperty(HomeSwitcher.IsVisible,True,Home)</onfocus>

                <onfocus condition="String.IsEmpty(Window.Property(RefocusMenu))">SetFocus(100)</onfocus>
                <onfocus condition="!String.IsEmpty(Window.Property(RefocusMenu))">SetFocus(300)</onfocus>
                <onfocus>ClearProperty(RefocusMenu)</onfocus>

                <onleft>100</onleft>
                <onright>100</onright>
                <onup>100</onup>
                <ondown>100</ondown>

                <include>Object_Hidden_Button_Definition</include>
            </control>
            <control type="edit" id="100">
                <left>40</left>
                <font>font_main</font>
                <textcolor>main_fg_30</textcolor>
                <focusedcolor>$VAR[ColorSelected]</focusedcolor>
                <align>left</align>

                <onleft condition="Skin.HasSetting(HomeSwitcher.Vertical)">SetProperty(RefocusMenu,True)</onleft>
                <onleft condition="Skin.HasSetting(HomeSwitcher.Vertical)">3001</onleft>

                <onright condition="Skin.HasSetting(HomeSwitcher.Vertical)">SetProperty(Bumper.Direction,Right,Home)</onright>
                <onright condition="Skin.HasSetting(HomeSwitcher.Vertical)">ActivateWindow(1180)</onright>


                <!-- The window opens from Home so moving to the next hub closes it -->
                <onleft condition="!Skin.HasSetting(HomeSwitcher.Vertical)">$INFO[Container(399).ListItem(-1).Property(action)]</onleft>
                <onright condition="!Skin.HasSetting(HomeSwitcher.Vertical)">Action(PreviousMenu)</onright>

                <ondown>101</ondown>

                <texturefocus />
                <texturenofocus />
            </control>
        </definition>
    </include>

    <include name="Search_Bar_Icon">
        <definition>
            <control type="group">
                <left>0</left>
                <width>80</width>
                <control type="image">
                    <include>Home_Grouplist_Icon_Definition</include>
                    <texture background="true" colordiffuse="main_fg_30">special://skin/extras/icons/search.png</texture>
                    <visible>!Control.HasFocus(100)</visible>
                </control>
                <control type="image">
                    <include>Home_Grouplist_Icon_Definition</include>
                    <texture background="true" colordiffuse="$VAR[ColorSelected]">special://skin/extras/icons/search.png</texture>
                    <visible>Control.HasFocus(100)</visible>
                </control>
            </control>
        </definition>
    </include>

    <!-- Quick keyboard that the window script fills with keys -->
    <include name="Search_Bar_Keys">
        <definition>
            <control type="panel" id="101">
                <orientation>vertical</orientation>
                <onunfocus condition="Skin.HasSetting(HomeSwitcher.Vertical)">ClearProperty(HomeSwitcher.IsVisible,Home)</onunfocus>
                <onfocus condition="!Skin.HasSetting(HomeSwitcher.Vertical)">SetProperty(HomeSwitcher.IsVisible,True,Home)</onfocus>
                <!-- <onup>3000</onup> -->
                <onup>ClearProperty(RefocusMenu)</onup>
                <onup>3001</onup>
                <onback>SetProperty(RefocusMenu,True)</onback>
                <onback>3001</onback>
                <ondown>102</ondown>
                <width>700</width>
                <!-- <width>750</width>
                <focusposition>7</focusposition> -->
                <centerleft>50%</centerleft>
                <height>100</height>
                <top>95</top>

                <onfocus>ClearProperty(Background.ShowOverlay,Home)</onfocus>

                <itemlayout width="50" height="50">
                    <control type="label">
                        <font>font_main</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>dialog_fg_30</textcolor>
                        <align>center</align>
                        <height>35</height>
                    </control>
                </itemlayout>

                <focusedlayout width="50" height="50">

                    <control type="label">
                        <visible>!Control.HasFocus(101)</visible>
                        <font>font_main</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>dialog_fg_30</textcolor>
                        <align>center</align>
                        <height>35</height>
                    </control>

                    <control type="group">
                        <visible>Control.HasFocus(101)</visible>
                        <control type="label">
                            <font>font_main_bold</font>
                            <label>$INFO[ListItem.Label]</label>
                            <textcolor>dialog_fg_100</textcolor>
                            <align>center</align>
                            <height>35</height>
                        </control>
                        <control type="image">
                            <include>Texture_Highlight_Scrollbar_H</include>
                            <height>scrollbar_w</height>
                            <bottom>5</bottom>
                            <width>75%</width>
                            <centerleft>50%</centerleft>
                        </control>
                    </control>
                </focusedlayout>
            </control>
        </definition>
    </include>

    <!-- SkinVariables multisearch window. The script searches the text of edit 100, fills keys 101 and results 50
         and opens the source and sort selections from buttons 102 and 103 -->
    <include name="MultiSearch">
        <include>Hub_Window_Background</include>
        <include content="Home_Control">
            <param name="window">MultiSearch</param>
            <param name="overlay">[false]</param>
            <param name="fade_visible">true</param>
            <param name="multisearch">true</param>
            <onfocus condition="!Skin.HasSetting(HomeSwitcher.Vertical)">SetFocus(3001)</onfocus>
        </include>

        <control type="group">
            <include>Animation_Group_Bumper</include>

            <control type="group">
                <include condition="Skin.HasSetting(HomeSwitcher.Vertical)">Hub_Window_Side_Slide</include>

                <!-- Content -->
                <control type="group" id="400">
                    <include content="Search_Bar">
                        <include>MultiSearch_Buttons</include>
                    </include>
                    <include>MultiSearch_Results</include>
                </control>

                <include condition="Skin.HasSetting(HomeSwitcher.Vertical)">Hub_VertMenu</include>
            </control>
        </control>
    </include>

    <include name="MultiSearch_Buttons">
        <control type="grouplist">
            <left>view_pad</left>
            <right>view_pad</right>
            <top>350</top>
            <height>57</height>
            <itemgap>40</itemgap>
            <orientation>horizontal</orientation>
            <onup>101</onup>
            <ondown>200</ondown>
            <include>Hub_Grouplist_OnLeftRight</include>
            <include content="Button_Underline_Switcher">
                <param name="id">102</param>
                <param name="control">button</param>
                <label>$LOCALIZE[31851] ⌄</label>
            </include>
            <include content="Button_Underline_Switcher">
                <param name="id">103</param>
                <param name="control">button</param>
                <label>$LOCALIZE[31016]$INFO[Window.Property(SkinVariables.MultiSearch.SortBy),: ,] ⌄</label>
            </include>
        </control>
    </include>

    <!-- Hidden source grouplist that the script fills with a button for all sources and a button for each source.
         Moving left and right through it changes the source shown by the results label.
         The window file passes the id and the button template so the script can find them -->
    <include name="MultiSearch_Sources">
        <control type="grouplist" id="$PARAM[id]">
            <include>Object_Hidden_Item_Definition</include>
            <orientation>horizontal</orientation>
            <onup>102</onup>
            <ondown>50</ondown>
            <include>Hub_Grouplist_OnLeftRight</include>
            <nested />
        </control>
    </include>

    <!-- The script adds the source label and visibility as nested tags -->
    <include name="MultiSearch_Source_Button">
        <include content="Object_Hidden_Button">
            <param name="id">$PARAM[id]</param>
            <nested />
        </include>
    </include>

    <variable name="MultiSearch_Results_Label">
        <value>$LOCALIZE[31850]$INFO[Window.Property(SkinVariables.MultiSearch.Source), · ,]$INFO[Window.Property(SkinVariables.MultiSearch.Count), (,)]</value>
    </variable>

    <variable name="MultiSearch_Results_ArrowColor">
        <value condition="ControlGroup(200).HasFocus()">main_fg_100</value>
        <value>main_fg_30</value>
    </variable>

    <!-- Results label of the hidden source grouplist. Arrows show the source can be changed and the label is underlined
         while the grouplist has focus. The underline is a button behind the label that is sized by the same text -->
    <include name="MultiSearch_Results_Line">
        <control type="group">
            <left>view_pad</left>
            <right>view_pad</right>
            <top>520</top>
            <height>40</height>

            <!-- Arrow and gap widths to the left so the label keeps the line's left edge and the arrows sit in the gutter -->
            <control type="group">
                <left>-60</left>
                <centertop>0</centertop>
                <height>80</height>
                <control type="grouplist">
                    <orientation>horizontal</orientation>
                    <itemgap>20</itemgap>
                    <control type="group">
                        <width>40</width>
                    </control>
                    <control type="button">
                        <width>auto</width>
                        <height>70</height>
                        <centertop>50%</centertop>
                        <aligny>center</aligny>
                        <textoffsetx>0</textoffsetx>
                        <include>Texture_Highlight_Underline_FakeFocus_H</include>
                        <font>font_main_bold</font>
                        <textcolor>00ffffff</textcolor>
                        <focusedcolor>00ffffff</focusedcolor>
                        <label>$VAR[MultiSearch_Results_Label]</label>
                        <hitrect x="0" y="0" w="0" h="0" />
                        <visible>ControlGroup(200).HasFocus()</visible>
                    </control>
                </control>
                <control type="grouplist">
                    <orientation>horizontal</orientation>
                    <itemgap>20</itemgap>
                    <control type="image">
                        <width>40</width>
                        <height>40</height>
                        <centertop>50%</centertop>
                        <texture colordiffuse="$VAR[MultiSearch_Results_ArrowColor]">special://skin/extras/icons/angle-left.png</texture>
                    </control>
                    <control type="label">
                        <width>auto</width>
                        <aligny>center</aligny>
                        <font>font_main_bold</font>
                        <textcolor>main_fg_100</textcolor>
                        <label>$VAR[MultiSearch_Results_Label]</label>
                    </control>
                    <control type="image">
                        <width>40</width>
                        <height>40</height>
                        <centertop>50%</centertop>
                        <texture colordiffuse="$VAR[MultiSearch_Results_ArrowColor]">special://skin/extras/icons/angle-right.png</texture>
                    </control>
                </control>
            </control>

            <include content="View_Line_Divider" />
        </control>
    </include>

    <include name="MultiSearch_Results">
        <include>MultiSearch_Results_Line</include>
        <include content="Hub_Combined_Widget">
            <param name="id">50</param>
            <param name="onup">200</param>
            <param name="dynamic">false</param>
        </include>
    </include>

</includes>
