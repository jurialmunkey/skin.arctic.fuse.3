        </control>
    </include>

    <include name="Weather_Trend_Day">
        <param name="title" />
        <param name="connect">true</param>
        <param name="has_name">false</param>
        <definition>
            <control type="group">
                <left>$PARAM[left]</left>
                <width>360</width>
                <include content="Weather_Trend_Point">
                    <param name="day">$PARAM[day]</param>
                    <param name="kind">High</param>
                    <param name="label_top">-40</param>
                    <param name="label">$INFO[Window(weather).Property($PARAM[day].HighTemp),,°]</param>
                    <param name="has_name">$PARAM[has_name]</param>
                    <param name="name">$LOCALIZE[393]</param>
                    <param name="color">fff9ebd9</param>
                    <param name="dot_color">fff9ebd9</param>
                    <param name="visible">$EXP[Exp_Weather_Trend_Ready] + !$EXP[Exp_Weather_Trend_Details_Page]</param>
                    <param name="connect">$PARAM[connect]</param>
                </include>
                <include content="Weather_Trend_Point">
                    <param name="day">$PARAM[day]</param>
                    <param name="kind">Low</param>
                    <param name="label_top">10</param>
                    <param name="label">$INFO[Window(weather).Property($PARAM[day].LowTemp),,°]</param>
                    <param name="has_name">$PARAM[has_name]</param>
                    <param name="name">$LOCALIZE[391]</param>
                    <param name="color">ffa4dcff</param>
                    <param name="dot_color">ffa4dcff</param>
                    <param name="diffuse">weather/trend/dashes.png</param>
                    <param name="visible">$EXP[Exp_Weather_Trend_Ready] + !$EXP[Exp_Weather_Trend_Details_Page]</param>
                    <param name="connect">$PARAM[connect]</param>
                </include>
                <control type="group">
                    <bottom>180</bottom>
                    <control type="label">
                        <height>40</height>
                        <align>center</align>
                        <aligny>center</aligny>
                        <font>font_main_bold</font>
                        <textcolor>main_fg_100</textcolor>
                        <shadowcolor>shadow_hard</shadowcolor>
                        <label>$PARAM[title]</label>
                    </control>
                    <include content="Weather_Trend_Icon">
                        <param name="day">$PARAM[day]</param>
                        <top>250</top>
                        <centerleft>50%</centerleft>
                        <width>120</width>
                        <height>120</height>
                        <visible>!String.IsEmpty(Window(weather).Property($PARAM[day].FanartCode))</visible>
                    </include>
                    <include content="Weather_Trend_Day_Text">
                        <param name="label">$INFO[Window(weather).Property($PARAM[day].Outlook)]</param>
                        <param name="visible">![$EXP[Exp_Weather_Trend_Details_Page] + !String.IsEmpty(Window(weather).Property(Weather.Trend.$PARAM[day].Range.Label))]</param>
                    </include>
                    <include content="Weather_Trend_Day_Text">
                        <param name="label">$INFO[Window(weather).Property(Weather.Trend.$PARAM[day].Range.Label)]</param>
                        <param name="visible">$EXP[Exp_Weather_Trend_Details_Page] + !String.IsEmpty(Window(weather).Property(Weather.Trend.$PARAM[day].Range.Label))</param>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <include name="Weather_Trend_Day_Text">
