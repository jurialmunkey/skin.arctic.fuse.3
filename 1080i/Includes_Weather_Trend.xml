                <height>80</height>
                <align>center</align>
                <aligny>top</aligny>
                <font>font_main</font>
                <textcolor>main_fg_90</textcolor>
                <shadowcolor>shadow_hard</shadowcolor>
                <label>$PARAM[label]</label>
                <visible>$PARAM[visible]</visible>
            </control>
        </definition>
    </include>

