<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <expression name="Exp_Weather_Is_Loading">[!Weather.IsFetched | [String.IsEqual(Weather.Plugin,weather.ozweather) + String.IsEmpty(Window(weather).Property(Weather.IsFetched))]]</expression>
    <expression name="Exp_Weather_Trend_Ready">String.IsEqual(Window(weather).Property(Weather.Trend.Ready),true) + String.IsEqual(Control.GetLabel(8050),Window(weather).Property(Weather.Trend.Source))</expression>
    <expression name="Exp_Weather_Trend_Has_Rain_Chance">!String.IsEmpty(Window(weather).Property(Weather.Trend.Chance.First))</expression>
    <expression name="Exp_Weather_Trend_Has_Precipitation_Amount">!String.IsEmpty(Window(weather).Property(Weather.Trend.Amount.First))</expression>
    <expression name="Exp_Weather_Trend_Has_Precipitation">[$EXP[Exp_Weather_Trend_Has_Rain_Chance] | $EXP[Exp_Weather_Trend_Has_Precipitation_Amount] | !String.IsEmpty(Window(weather).Property(Weather.Trend.Duration.First)) | !String.IsEmpty(Window(weather).Property(Weather.Trend.Range.First))]</expression>
    <expression name="Exp_Weather_Trend_Has_Details">[Weather.IsFetched + String.IsEqual(Control.GetLabel(8051),Window(weather).Property(Weather.Trend.Details.Source)) + $EXP[Exp_Weather_Trend_Has_Precipitation]]</expression>
    <expression name="Exp_Weather_Trend_Details_Page">[$EXP[Exp_Weather_Trend_Has_Details] + String.IsEqual(Window(weather).Property(Weather.Trend.Page),Details)]</expression>

    <expression name="Exp_Weather_Trend_Temperature_Page">[!$EXP[Exp_Weather_Trend_Details_Page] + !$EXP[Exp_Weather_Trend_UV_Page] + !$EXP[Exp_Weather_Trend_Radar_Page]]</expression>
    <expression name="Exp_Weather_Trend_Has_Pages">[$EXP[Exp_Weather_Trend_Has_Details] | $EXP[Exp_Weather_Trend_Has_UV] | $EXP[Exp_Weather_Trend_Has_Radar]]</expression>
    <expression name="Exp_Weather_Trend_Has_Two_Pages">[[$EXP[Exp_Weather_Trend_Has_Details] + !$EXP[Exp_Weather_Trend_Has_UV] + !$EXP[Exp_Weather_Trend_Has_Radar]] | [!$EXP[Exp_Weather_Trend_Has_Details] + $EXP[Exp_Weather_Trend_Has_UV] + !$EXP[Exp_Weather_Trend_Has_Radar]] | [!$EXP[Exp_Weather_Trend_Has_Details] + !$EXP[Exp_Weather_Trend_Has_UV] + $EXP[Exp_Weather_Trend_Has_Radar]]]</expression>

    <expression name="Exp_Weather_Trend_Next_Details">[$EXP[Exp_Weather_Trend_Temperature_Page] + $EXP[Exp_Weather_Trend_Has_Details]]</expression>
    <expression name="Exp_Weather_Trend_Next_UV">[$EXP[Exp_Weather_Trend_Has_UV] + [$EXP[Exp_Weather_Trend_Details_Page] | [$EXP[Exp_Weather_Trend_Temperature_Page] + !$EXP[Exp_Weather_Trend_Has_Details]]]]</expression>
    <expression name="Exp_Weather_Trend_Next_Radar">[$EXP[Exp_Weather_Trend_Has_Radar] + [$EXP[Exp_Weather_Trend_UV_Page] | [$EXP[Exp_Weather_Trend_Details_Page] + !$EXP[Exp_Weather_Trend_Has_UV]] | [$EXP[Exp_Weather_Trend_Temperature_Page] + !$EXP[Exp_Weather_Trend_Has_Details] + !$EXP[Exp_Weather_Trend_Has_UV]]]]</expression>
    <expression name="Exp_Weather_Trend_Next_Temperature">[$EXP[Exp_Weather_Trend_Radar_Page] | [$EXP[Exp_Weather_Trend_UV_Page] + !$EXP[Exp_Weather_Trend_Has_Radar]] | [$EXP[Exp_Weather_Trend_Details_Page] + !$EXP[Exp_Weather_Trend_Has_UV] + !$EXP[Exp_Weather_Trend_Has_Radar]]]</expression>

    <expression name="Exp_Weather_Trend_Prev_Radar">[$EXP[Exp_Weather_Trend_Temperature_Page] + $EXP[Exp_Weather_Trend_Has_Radar]]</expression>
    <expression name="Exp_Weather_Trend_Prev_UV">[$EXP[Exp_Weather_Trend_Has_UV] + [$EXP[Exp_Weather_Trend_Radar_Page] | [$EXP[Exp_Weather_Trend_Temperature_Page] + !$EXP[Exp_Weather_Trend_Has_Radar]]]]</expression>
    <expression name="Exp_Weather_Trend_Prev_Details">[$EXP[Exp_Weather_Trend_Has_Details] + [$EXP[Exp_Weather_Trend_UV_Page] | [$EXP[Exp_Weather_Trend_Radar_Page] + !$EXP[Exp_Weather_Trend_Has_UV]] | [$EXP[Exp_Weather_Trend_Temperature_Page] + !$EXP[Exp_Weather_Trend_Has_Radar] + !$EXP[Exp_Weather_Trend_Has_UV]]]]</expression>
    <expression name="Exp_Weather_Trend_Prev_Temperature">[$EXP[Exp_Weather_Trend_Details_Page] | [$EXP[Exp_Weather_Trend_UV_Page] + !$EXP[Exp_Weather_Trend_Has_Details]] | [$EXP[Exp_Weather_Trend_Radar_Page] + !$EXP[Exp_Weather_Trend_Has_UV] + !$EXP[Exp_Weather_Trend_Has_Details]]]</expression>

    <variable name="Label_Weather_Trend_Page_Next">
        <value condition="$EXP[Exp_Weather_Trend_Next_Details]">$LOCALIZE[33021]</value>
        <value condition="$EXP[Exp_Weather_Trend_Next_UV]">$LOCALIZE[403]</value>
        <value condition="$EXP[Exp_Weather_Trend_Next_Radar]">$LOCALIZE[31473]</value>
        <value>$LOCALIZE[1375]</value>
    </variable>

    <variable name="Label_Weather_Trend_Page_Prev">
        <value condition="$EXP[Exp_Weather_Trend_Prev_Radar]">$LOCALIZE[31473]</value>
        <value condition="$EXP[Exp_Weather_Trend_Prev_UV]">$LOCALIZE[403]</value>
        <value condition="$EXP[Exp_Weather_Trend_Prev_Details]">$LOCALIZE[33021]</value>
        <value>$LOCALIZE[1375]</value>
    </variable>

    <variable name="Label_Weather_Trend_Page_Hint">
        <value condition="$EXP[Exp_Weather_Trend_Has_Two_Pages]">‹ $VAR[Label_Weather_Trend_Page_Next] ›</value>
        <value>‹ $VAR[Label_Weather_Trend_Page_Prev]  ·  $VAR[Label_Weather_Trend_Page_Next] ›</value>
    </variable>

    <variable name="Label_Weather_Trend_Heading">
        <value condition="$EXP[Exp_Weather_Trend_Details_Page]">$LOCALIZE[33021]</value>
        <value>$LOCALIZE[1375]</value>
    </variable>

    <include name="Weather_Trend_Page_Hint">
        <control type="group">
            <include>Dimension_Bottombar</include>
            <include content="View_Furniture_Footer_ViewLine">
                <param name="visible">$EXP[Exp_Weather_Trend_Has_Pages]</param>
                <param name="label">$VAR[Label_Weather_Trend_Page_Hint]</param>
                <param name="align">left</param>
            </include>
        </control>
    </include>

    <include name="Weather_Trend_Source">
        <control type="label" id="8050">
            <include>Object_Hidden_Item_Definition</include>
            <visible>false</visible>
            <!-- Keep the chart cache key in sync with skinvariables-weather-trend.json. -->
            <label>range:$INFO[Window(weather).Property(Day0.HighTemp)]:$INFO[Window(weather).Property(Day0.LowTemp)]:$INFO[Window(weather).Property(Day1.HighTemp)]:$INFO[Window(weather).Property(Day1.LowTemp)]:$INFO[Window(weather).Property(Day2.HighTemp)]:$INFO[Window(weather).Property(Day2.LowTemp)]:$INFO[Window(weather).Property(Day3.HighTemp)]:$INFO[Window(weather).Property(Day3.LowTemp)]:$INFO[Window(weather).Property(Day4.HighTemp)]:$INFO[Window(weather).Property(Day4.LowTemp)]</label>
        </control>
        <control type="label" id="8051">
            <include>Object_Hidden_Item_Definition</include>
            <visible>false</visible>
            <!-- Track the raw fields read by the daily series rules, including empty values. -->
            <label>precipitation:$INFO[Weather.Plugin]:$INFO[Window(weather).Property(Daily.1.ChancePrecipitation)]:$INFO[Window(weather).Property(Daily.1.PrecipitationAmount)]:$INFO[Window(weather).Property(Daily.1.PrecipitationHours)]:$INFO[Window(weather).Property(Daily.1.RainAmount)]:$INFO[Window(weather).Property(Daily.1.Precipitation)]:$INFO[Window(weather).Property(Daily.2.ChancePrecipitation)]:$INFO[Window(weather).Property(Daily.2.PrecipitationAmount)]:$INFO[Window(weather).Property(Daily.2.PrecipitationHours)]:$INFO[Window(weather).Property(Daily.2.RainAmount)]:$INFO[Window(weather).Property(Daily.2.Precipitation)]:$INFO[Window(weather).Property(Daily.3.ChancePrecipitation)]:$INFO[Window(weather).Property(Daily.3.PrecipitationAmount)]:$INFO[Window(weather).Property(Daily.3.PrecipitationHours)]:$INFO[Window(weather).Property(Daily.3.RainAmount)]:$INFO[Window(weather).Property(Daily.3.Precipitation)]:$INFO[Window(weather).Property(Daily.4.ChancePrecipitation)]:$INFO[Window(weather).Property(Daily.4.PrecipitationAmount)]:$INFO[Window(weather).Property(Daily.4.PrecipitationHours)]:$INFO[Window(weather).Property(Daily.4.RainAmount)]:$INFO[Window(weather).Property(Daily.4.Precipitation)]:$INFO[Window(weather).Property(Daily.5.ChancePrecipitation)]:$INFO[Window(weather).Property(Daily.5.PrecipitationAmount)]:$INFO[Window(weather).Property(Daily.5.PrecipitationHours)]:$INFO[Window(weather).Property(Daily.5.RainAmount)]:$INFO[Window(weather).Property(Daily.5.Precipitation)]</label>
        </control>
        <include>Weather_Trend_UV_Source</include>
        <include>Weather_Trend_Radar_Source</include>
    </include>

    <include name="Weather_Trend_Shading">
        <control type="image">
            <width>1080</width>
            <texture colordiffuse="shadow_hard" flipx="true" border="0,4,0,4">common/gradient-h.png</texture>
        </control>
        <control type="image">
            <bottom>0</bottom>
            <height>720</height>
            <texture colordiffuse="shadow_back" border="4,0,4,0">common/gradient-v.png</texture>
        </control>
    </include>

    <include name="Weather_Trend_Icon">
        <param name="day">Day0</param>
        <definition>
            <control type="image">
                <aspectratio>keep</aspectratio>
                <texture background="true" colordiffuse="main_fg_90">resource://resource.images.weathericons.white/$INFO[Window(weather).Property($PARAM[day].FanartCode)].png</texture>
                <nested />
            </control>
        </definition>
    </include>

    <include name="Weather_Trend_Header">
        <control type="group">
            <left>view_pad</left>
            <top>view_pad</top>
            <width>info_title_w</width>
            <height>info_title_h</height>
            <include content="Info_Title_Text">
                <param name="title">Weather.Location</param>
                <param name="colordiffuse">main_fg</param>
            </include>
        </control>
    </include>

    <include name="Weather_Trend_Today">
        <control type="group">
            <left>80</left>
            <top>240</top>
            <width>720</width>
            <visible>Weather.IsFetched + [!String.IsEmpty(Window(weather).Property(Day0.HighTemp)) | !String.IsEmpty(Window(weather).Property(Day0.Outlook))]</visible>
            <control type="label">
                <height>40</height>
                <font>font_head_bold</font>
                <aligny>center</aligny>
                <textcolor>main_fg_100</textcolor>
                <shadowcolor>shadow_hard</shadowcolor>
                <label>$INFO[Window(weather).Property(Current.Condition)]</label>
            </control>
            <control type="grouplist">
                <top>40</top>
                <height>100</height>
                <itemgap>20</itemgap>
                <orientation>horizontal</orientation>
                <usecontrolcoords>true</usecontrolcoords>
                <control type="label">
                    <width>auto</width>
                    <height>100</height>
                    <font>font_title_huge</font>
                    <aligny>center</aligny>
                    <textcolor>main_fg_100</textcolor>
                    <shadowcolor>shadow_hard</shadowcolor>
                    <label>$INFO[Window(weather).Property(Current.Temperature),,°]</label>
                    <visible>!String.IsEmpty(Window(weather).Property(Current.Temperature))</visible>
                </control>
                <include content="Weather_Trend_Icon">
                    <centertop>50%</centertop>
                    <width>120</width>
                    <height>120</height>
                    <visible>!String.IsEmpty(Window(weather).Property(Day0.FanartCode))</visible>
                </include>
            </control><!--
            <control type="label">
                <top>140</top>
                <width>auto</width>
                <height>40</height>
                <font>font_main</font>
                <aligny>center</aligny>
                <textcolor>main_fg_90</textcolor>
                <shadowcolor>shadow_hard</shadowcolor>
                <label>$INFO[Window(Weather).Property(Current.FeelsLike),$LOCALIZE[402] ,°]</label>
                <visible>!String.IsEmpty(Window(Weather).Property(Current.FeelsLike))</visible>
            </control> -->
            <control type="grouplist">
                <top>200</top>
                <include>Info_Meta_Grouplist_Definition</include>

                <include content="Info_Meta_Weather_Sun">
                    <param name="kind">Sunrise</param>
                    <param name="icon">special://skin/extras/icons/sunrise.png</param>
                    <param name="source">Window(Weather).Property</param>
                    <param name="property_prefix">Day0.</param>
                </include>
                <include content="Info_Meta_Weather_Sun">
                    <param name="kind">Sunset</param>
                    <param name="icon">special://skin/extras/icons/sunset.png</param>
                    <param name="source">Window(Weather).Property</param>
                    <param name="property_prefix">Day0.</param>
                </include>
                <include content="Info_Meta_Object">
                    <param name="bordersize">-12</param>
                    <param name="icon">special://skin/extras/icons/temperature-half.png</param>
                    <param name="label">$INFO[Window(Weather).Property(Current.FeelsLike),$LOCALIZE[402] ,°]</param>
                    <param name="visible">!String.IsEmpty(Window(Weather).Property(Current.FeelsLike))</param>
                </include>
            </control>
        </control>
    </include>

    <include name="Weather_Trend_Forecast">
        <control type="group">
            <left>60</left>
            <right>60</right>
            <top>420</top>
            <visible>Weather.IsFetched + !$EXP[Exp_Weather_Trend_UV_Page] + !$EXP[Exp_Weather_Trend_Radar_Page]</visible>
