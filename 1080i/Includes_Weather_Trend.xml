    <include name="Weather_Trend_Detail_Point">
        <param name="connect">true</param>
        <definition>
            <control type="group">
                <left>$PARAM[left]</left>
                <include content="Weather_Trend_Point">
                    <param name="day">Day$PARAM[index]</param>
                    <param name="kind">$PARAM[kind]</param>
                    <param name="top">0</param>
                    <param name="plot_height">160</param>
                    <param name="position_include">Weather_Trend_Detail_Position</param>
                    <param name="segment_top">-170</param>
                    <param name="segment_height">340</param>
                    <param name="label_top">-42</param>
                    <param name="label">$INFO[Window(weather).Property(Weather.Trend.Day$PARAM[index].$PARAM[kind].Label)]</param>
                    <param name="visible">!String.IsEmpty(Window(weather).Property(Weather.Trend.Day$PARAM[index].$PARAM[kind].Label))</param>
                    <param name="has_name">true</param>
                    <param name="name">$PARAM[name]</param>
                    <param name="name_visible">Integer.IsEqual(Window(weather).Property(Weather.Trend.$PARAM[kind].First),$PARAM[index])</param>
                    <param name="color">$PARAM[color]</param>
                    <param name="dot_color">$PARAM[color]</param>
                    <param name="diffuse">$PARAM[diffuse]</param>
                    <param name="connect">$PARAM[connect]</param>
                    <param name="line_visible">!String.IsEmpty(Window(weather).Property(Weather.Trend.Day$PARAM[next].$PARAM[kind].Label))</param>
                </include>
                <control type="label">
                    <left>100</left>
                    <top>65</top>
                    <width>160</width>
                    <height>30</height>
                    <font>font_mini_bold</font>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>main_fg_30</textcolor>
                    <label>—</label>
                    <visible>String.IsEmpty(Window(weather).Property(Weather.Trend.Day$PARAM[index].$PARAM[kind].Label))</visible>
                </control>
            </control>
        </definition>
    </include>

    <include name="Weather_Trend_Point">
        <param name="diffuse" />
        <param name="left">180</param>
        <param name="top">90</param>
        <param name="plot_height">120</param>
        <param name="position_include">Weather_Trend_Position</param>
        <param name="segment_top">-127.5</param>
        <param name="segment_height">255</param>
        <param name="has_name">false</param>
        <param name="name" />
        <param name="name_visible">true</param>
        <param name="line_visible">true</param>
        <definition>
            <control type="group">
                <left>$PARAM[left]</left>
                <top>$PARAM[top]</top>
                <width>360</width>
                <height>$PARAM[plot_height]</height>
                <visible>$PARAM[visible]</visible>
                <include content="$PARAM[position_include]">
                    <param name="position">Window(weather).Property(Weather.Trend.$PARAM[day].$PARAM[kind].Position)</param>
                </include>
                <include content="Weather_Trend_Line" condition="$PARAM[connect]">
                    <param name="delta">Window(weather).Property(Weather.Trend.$PARAM[day].$PARAM[kind].Delta)</param>
                    <param name="color">$PARAM[color]</param>
                    <param name="diffuse">$PARAM[diffuse]</param>
                    <param name="visible">$PARAM[line_visible]</param>
                    <param name="top">$PARAM[segment_top]</param>
                    <param name="height">$PARAM[segment_height]</param>
                    <param name="texture">weather/trend/segment-$INFO[Window(weather).Property(Weather.Trend.$PARAM[day].$PARAM[kind].Slope)].png</param>
                </include>
                <control type="image">
                    <left>-5</left>
                    <top>-5</top>
                    <width>10</width>
                    <height>10</height>
                    <texture colordiffuse="$PARAM[dot_color]">common/circle.png</texture>
                </control>
                <control type="label">
                    <left>-80</left>
                    <top>$PARAM[label_top]</top>
                    <width>160</width>
                    <height>30</height>
                    <font>font_mini_bold</font>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>$PARAM[color]</textcolor>
                    <shadowcolor>shadow_hard</shadowcolor>
                    <label>$PARAM[label]</label>
                </control>
                <include content="Weather_Trend_Line_Name" condition="$PARAM[has_name]">
                    <param name="label">$PARAM[name]</param>
                    <param name="color">$PARAM[dot_color]</param>
                    <param name="visible">$PARAM[name_visible]</param>
                </include>
            </control>
        </definition>
    </include>

    <include name="Weather_Trend_Line_Name">
        <definition>
            <control type="label">
                <left>-166</left>
                <top>-15</top>
                <width>150</width>
                <height>30</height>
                <font>font_hint_bold</font>
                <align>right</align>
                <aligny>center</aligny>
                <textcolor>$PARAM[color]</textcolor>
                <shadowcolor>shadow_hard</shadowcolor>
                <label>$PARAM[label]</label>
                <visible>$PARAM[visible]</visible>
            </control>
        </definition>
    </include>

    <!-- SkinVariables rounds 16 * (maximum - value) / spread to an index
         from 0 to 16, or uses index 8 for a flat forecast. Each step is 7.5px. -->
    <include name="Weather_Trend_Position">
        <definition>
            <animation effect="slide" end="0,7.5" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],1)">Conditional</animation>
            <animation effect="slide" end="0,15" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],2)">Conditional</animation>
            <animation effect="slide" end="0,22.5" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],3)">Conditional</animation>
            <animation effect="slide" end="0,30" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],4)">Conditional</animation>
            <animation effect="slide" end="0,37.5" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],5)">Conditional</animation>
            <animation effect="slide" end="0,45" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],6)">Conditional</animation>
            <animation effect="slide" end="0,52.5" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],7)">Conditional</animation>
            <animation effect="slide" end="0,60" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],8)">Conditional</animation>
            <animation effect="slide" end="0,67.5" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],9)">Conditional</animation>
            <animation effect="slide" end="0,75" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],10)">Conditional</animation>
            <animation effect="slide" end="0,82.5" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],11)">Conditional</animation>
            <animation effect="slide" end="0,90" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],12)">Conditional</animation>
            <animation effect="slide" end="0,97.5" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],13)">Conditional</animation>
            <animation effect="slide" end="0,105" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],14)">Conditional</animation>
            <animation effect="slide" end="0,112.5" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],15)">Conditional</animation>
            <animation effect="slide" end="0,120" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],16)">Conditional</animation>
        </definition>
    </include>

    <!-- The detail plot uses the same 16 steps at 10px each. -->
    <include name="Weather_Trend_Detail_Position">
        <definition>
            <animation effect="slide" end="0,10" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],1)">Conditional</animation>
            <animation effect="slide" end="0,20" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],2)">Conditional</animation>
            <animation effect="slide" end="0,30" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],3)">Conditional</animation>
            <animation effect="slide" end="0,40" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],4)">Conditional</animation>
            <animation effect="slide" end="0,50" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],5)">Conditional</animation>
            <animation effect="slide" end="0,60" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],6)">Conditional</animation>
            <animation effect="slide" end="0,70" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],7)">Conditional</animation>
            <animation effect="slide" end="0,80" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],8)">Conditional</animation>
            <animation effect="slide" end="0,90" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],9)">Conditional</animation>
            <animation effect="slide" end="0,100" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],10)">Conditional</animation>
            <animation effect="slide" end="0,110" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],11)">Conditional</animation>
            <animation effect="slide" end="0,120" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],12)">Conditional</animation>
            <animation effect="slide" end="0,130" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],13)">Conditional</animation>
            <animation effect="slide" end="0,140" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],14)">Conditional</animation>
            <animation effect="slide" end="0,150" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],15)">Conditional</animation>
            <animation effect="slide" end="0,160" time="0" reversible="false" condition="Integer.IsEqual($PARAM[position],16)">Conditional</animation>
        </definition>
    </include>

    <!-- Each segment starts at the centre of its texture and extends to the
         next column. Flip the texture for upward steps. -->
    <include name="Weather_Trend_Line">
        <definition>
            <include content="Weather_Trend_Segment">
                <param name="visible">$PARAM[visible] + !Integer.IsLess($PARAM[delta],0)</param>
                <param name="color">$PARAM[color]</param>
                <param name="diffuse">$PARAM[diffuse]</param>
                <param name="texture">$PARAM[texture]</param>
                <param name="top">$PARAM[top]</param>
                <param name="height">$PARAM[height]</param>
            </include>
            <include content="Weather_Trend_Segment">
                <param name="visible">$PARAM[visible] + Integer.IsLess($PARAM[delta],0)</param>
                <param name="flipy">true</param>
                <param name="color">$PARAM[color]</param>
                <param name="diffuse">$PARAM[diffuse]</param>
                <param name="texture">$PARAM[texture]</param>
                <param name="top">$PARAM[top]</param>
                <param name="height">$PARAM[height]</param>
            </include>
        </definition>
    </include>

    <include name="Weather_Trend_Segment">
        <param name="flipx">false</param>
        <param name="flipy">false</param>
        <param name="diffuse" />
        <param name="width">360</param>
        <definition>
            <control type="image">
                <left>0</left>
                <top>$PARAM[top]</top>
                <width>$PARAM[width]</width>
                <height>$PARAM[height]</height>
                <visible>$PARAM[visible]</visible>
                <aspectratio scalediffuse="true">stretch</aspectratio>
                <texture colordiffuse="$PARAM[color]" diffuse="$PARAM[diffuse]" flipx="$PARAM[flipx]" flipy="$PARAM[flipy]">$PARAM[texture]</texture>
            </control>
        </definition>
    </include>
</includes>
