<?xml version="1.0" encoding="UTF-8"?>
<window>
    <include content="Action_SettingsCategories_Onload">
        <param name="defaultcontrol">10001</param>
    </include>

    <onload condition="String.IsEmpty(Window(Home).Property(Settings.Skin.Category))">SetProperty(Settings.Skin.Category,0,Home)</onload>
    <onload>SetFocus($INFO[Window(Home).Property(Settings.Skin.Category),1001,])</onload>

    <!-- Set Some Profile Settings -->
    <onload condition="String.IsEmpty(Skin.String(Skin.SettingsLevel))">Skin.SetString(Skin.SettingsLevel,$NUMBER[1])</onload>

    <onunload>$VAR[Action_RatingsMonitor]</onunload>

    <controls>


        <include>Background</include>

        <include content="Settings_Dialog">
            <include content="Settings_Main_Group">
                <include content="Settings_Left_Group">
                    <include content="Settings_Left_Content">
                        <control type="grouplist" id="10000">
                            <orientation>vertical</orientation>
                            <onup>10000</onup>
                            <ondown>10000</ondown>
                            <onright>10001</onright>
                            <right>40</right>
                            <include content="Settings_Category_Button" description="Customise">
                                <param name="id">10010</param>
                                <param name="property">Settings.Skin.Category</param>
                                <param name="category">0</param>
                                <param name="label">$LOCALIZE[31444]</param>
                            </include>
                            <include content="Settings_Category_Button" description="Appearance">
                                <param name="id">10011</param>
                                <param name="property">Settings.Skin.Category</param>
                                <param name="category">1</param>
                                <param name="label">$LOCALIZE[480]</param>
                            </include>
                            <include content="Settings_Category_Button" description="Interface">
                                <param name="id">10012</param>
                                <param name="property">Settings.Skin.Category</param>
                                <param name="category">2</param>
                                <param name="label">$LOCALIZE[14206]</param>
                            </include>
                            <include content="Settings_Category_Button" description="Details">
                                <param name="id">10013</param>
                                <param name="property">Settings.Skin.Category</param>
                                <param name="category">3</param>
                                <param name="label">$LOCALIZE[33029]</param>
                            </include>
                            <include content="Settings_Category_Button" description="Layout">
                                <param name="id">10014</param>
                                <param name="property">Settings.Skin.Category</param>
                                <param name="category">4</param>
                                <param name="label">$LOCALIZE[31158]</param>
                            </include>
                            <include content="Settings_Category_Button" description="Behaviour">
                                <param name="id">10015</param>
                                <param name="property">Settings.Skin.Category</param>
                                <param name="category">5</param>
                                <param name="label">$LOCALIZE[31186]</param>
                            </include>
                            <include content="Settings_Category_Button" description="Other">
                                <param name="id">10016</param>
                                <param name="property">Settings.Skin.Category</param>
                                <param name="category">6</param>
                                <param name="label">$LOCALIZE[29921]</param>
                            </include>
                            <include content="Settings_Category_Button" description="Dependencies">
                                <param name="id">10017</param>
                                <param name="property">Settings.Skin.Category</param>
                                <param name="category">7</param>
                                <param name="label">$LOCALIZE[39024]</param>
                            </include>
                            <include content="Settings_Category_Button" description="Thanks">
                                <param name="id">10018</param>
                                <param name="property">Settings.Skin.Category</param>
                                <param name="category">8</param>
                                <param name="label">$VAR[Label_SkinSettings_Level]</param>
                                <param name="onclick">Skin.SetString(Skin.SettingsLevel,$VAR[Value_SkinSettings_NextLevel])</param>
                            </include>
                        </control>
                        <control type="group">
                            <height>80</height>
                            <width>80</width>
                            <right>50</right>
                            <bottom>80</bottom>
                            <control type="image">
                                <texture colordiffuse="main_fg_70">$VAR[Image_SkinSettings_Level]</texture>
                                <bordersize>10</bordersize>
                                <visible>!String.IsEqual(Window(Home).Property(Settings.Skin.Category),8)</visible>
                            </control>
                            <control type="image">
                                <texture colordiffuse="$VAR[ColorSelected]">$VAR[Image_SkinSettings_Level]</texture>
                                <bordersize>10</bordersize>
                                <visible>String.IsEqual(Window(Home).Property(Settings.Skin.Category),8)</visible>
                            </control>
                        </control>
                    </include>
                </include>
                <include content="Settings_Right_Group">

                    <control type="scrollbar" id="60">
                        <centerright>0</centerright>
                        <bottom>20</bottom>
                        <top>20</top>
                        <width>scrollbar_w</width>
                        <orientation>vertical</orientation>
                        <texturesliderbackground />
                        <texturesliderbar colordiffuse="main_logo" border="4">scrollbar/scrollv_line.png</texturesliderbar>
                        <include>Texture_Scrollbar_V</include>
                        <showonepage>false</showonepage>
                        <onleft>10001</onleft>
                    </control>

                    <include content="Settings_Right_Grouplist">
                        <param name="id">10001</param>
                        <onleft>SetFocus($INFO[Window(Home).Property(Settings.Skin.Category),1001,])</onleft>
                        <include content="SkinSettings_Items_Menus">
                            <param name="baseid">0</param>
                        </include>
                        <include content="Settings_Button" description="Top Menu Up Action">
                            <param name="dialog">false</param>
                            <param name="window">skinsettings</param>
                            <param name="baseid">0</param>
                            <param name="id">090</param>
                            <param name="control">button</param>
                            <label>$LOCALIZE[31349]</label>
                            <label2>$VAR[Label_Setting_TopMenuUpAction]</label2>
                            <onclick condition="String.IsEmpty(Skin.String(HomeSwitcher.OnUp))">Skin.SetString(HomeSwitcher.OnUp,options)</onclick>
                            <onclick condition="Skin.String(HomeSwitcher.OnUp,options)">Skin.Reset(HomeSwitcher.OnUp)</onclick>
                            <visible>!Skin.HasSetting(HomeSwitcher.Vertical)</visible>
                        </include>
                        <include content="SkinSettings_Items_Appearance">
                            <param name="baseid">1</param>
                        </include>
                        <include content="SkinSettings_Items_Interface">
                            <param name="baseid">2</param>
                        </include>
                        <include content="SkinSettings_Items_Details">
                            <param name="baseid">3</param>
                        </include>
                        <include content="SkinSettings_Items_Viewtypes">
                            <param name="baseid">4</param>
                        </include>
                        <include content="SkinSettings_Items_Behaviour">
                            <param name="baseid">5</param>
                        </include>
                        <include content="SkinSettings_Items_Other">
                            <param name="baseid">6</param>
                        </include>
                        <include content="SkinSettings_Items_Dependecies">
                            <param name="baseid">7</param>
                        </include>
                        <include content="SkinSettings_Items_Thanks">
                            <param name="baseid">8</param>
                        </include>
                    </include>
                </include>
                <include>Settings_InfoText</include>

            </include>

        </include>

    </controls>

</window>
