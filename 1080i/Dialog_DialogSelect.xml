    <include name="DialogSelect_Viewtype">
        <param name="id">3</param>
        <param name="itemlayout_include">Layout_ViewType</param>
        <param name="windowopen_delay">200</param>
        <definition>
            <include>Part_Dim_Overlay</include>
            <control type="group">
                <include>Dimension_DialogFullMenu</include>
                <include content="Animation_BounceIn_Dialog">
                    <param name="windowopen_delay">$PARAM[windowopen_delay]</param>
                </include>
                <include content="Part_Background_Panel">
                    <param name="dialog_size">Dimension_DialogFullMenu</param>
                    <param name="topline">false</param>
                </include>
                <!-- Content -->
                <control type="group" id="8000">
                    <include>Size_Dialog_Pad</include>
                    <control type="group">
                        <include>Part_Panel</include>
                        <control type="group">
                            <include>Size_Group_Head</include>
                            <include content="Part_HeadText">
                                <param name="id">1</param>
                                <param name="label">$PARAM[header]</param>
                            </include>
                            <include content="Part_ItemPage">
                                <param name="id">$PARAM[id]</param>
                            </include>
                            <include>Part_CloseButton</include>
                        </control>
                        <control type="group">
                            <include>Size_Group_Body</include>

                            <control type="group">
                                <left>0</left>
                                <right>0</right>
                                <top>20</top>
                                <bottom>20</bottom>

                                <control type="wraplist" id="$PARAM[id]">

                                    <animation effect="fade" start="100" end="50" condition="true">Conditional</animation>
                                    <orientation>horizontal</orientation>
                                    <focusposition>1</focusposition>
                                    <preloaditems>2</preloaditems>
                                    <itemlayout width="1000" height="580">
                                        <include content="$PARAM[itemlayout_include]">
                                            <param name="selected">false</param>
                                        </include>
                                    </itemlayout>

                                    <focusedlayout width="1000" height="580">
                                        <include content="$PARAM[itemlayout_include]">
                                            <param name="selected">false</param>
                                        </include>
                                    </focusedlayout>

                                    <include>$PARAM[include_content]</include>
                                </control>

                                <control type="grouplist">
                                    <orientation>horizontal</orientation>
                                    <itemgap>0</itemgap>
                                    <control type="group">
                                        <width>1000</width>
                                    </control>
                                    <control type="group">
                                        <width>1000</width>
                                        <height>580</height>
                                        <include content="$PARAM[itemlayout_include]">
                                            <param name="selected">true</param>
                                            <param name="icon">$INFO[Container($PARAM[id]).ListItem.Icon]</param>
                                            <param name="current">Container($PARAM[id]).ListItem.IsSelected</param>
                                        </include>
                                    </control>
                                </control>
                            </control>

                            <control type="group">
                                <height>105</height>
                                <bottom>-5</bottom>
                                <left>40</left>
                                <right>40</right>

                                <control type="button">
                                    <texturenofocus />
                                    <texturefocus />
                                    <width>400</width>
                                    <onclick>Control.Move($PARAM[id],-1)</onclick>
                                </control>
                                <control type="label">
                                    <left>40</left>
                                    <textcolor>dialog_fg_70</textcolor>
                                    <align>left</align>
                                    <font>font_mini</font>
                                    <label>$INFO[Container($PARAM[id]).ListItem(-1).Label]</label>
                                </control>
                                <control type="image">
                                    <centerleft>0</centerleft>
                                    <centertop>50%</centertop>
                                    <width>40</width>
                                    <height>40</height>
                                    <bordersize>-12</bordersize>
                                    <texture background="true" colordiffuse="dialog_fg_90">special://skin/extras/icons/circle-arrow-left.png</texture>
                                </control>

                                <control type="label">
                                    <left>400</left>
                                    <right>400</right>
                                    <textcolor>dialog_fg_90</textcolor>
                                    <align>center</align>
                                    <font>font_main_bold</font>
                                    <label>$INFO[Container($PARAM[id]).ListItem.Label]</label>
                                </control>

                                <control type="button">
                                    <texturenofocus />
                                    <texturefocus />
                                    <right>0</right>
                                    <width>400</width>
                                    <onclick>Control.Move($PARAM[id],1)</onclick>
                                </control>
                                <control type="label">
                                    <right>40</right>
                                    <textcolor>dialog_fg_70</textcolor>
                                    <align>right</align>
                                    <font>font_mini</font>
                                    <label>$INFO[Container($PARAM[id]).ListItem(1).Label]</label>
                                </control>
                                <control type="image">
                                    <centerright>0</centerright>
                                    <centertop>50%</centertop>
                                    <width>40</width>
                                    <height>40</height>
                                    <bordersize>-12</bordersize>
                                    <texture background="true" colordiffuse="dialog_fg_90">special://skin/extras/icons/circle-arrow-right.png</texture>
                                </control>
                            </control>
                        </control>
                    </control>
                </control>
            </control>
        </definition>
    </include>

