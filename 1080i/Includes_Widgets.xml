<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <include name="Widget_Label">
        <param name="usewidgetlabel">false</param>
        <param name="labelvisible">true</param>
        <param name="labeltop">widget_label_t</param>
        <param name="labelheight">widget_label_h</param>
        <definition>
            <control type="group" id="$PARAM[groupid]">
                <nested />
                <top>$PARAM[labeltop]</top>
                <height>$PARAM[labelheight]</height>
                <left>view_pad</left>
                <right>view_pad</right>
                <visible>$PARAM[visible]</visible>

                <include content="View_Line" condition="$PARAM[labelvisible] + ![$PARAM[usewidgetlabel]]">
                    <param name="label">$PARAM[label]</param>
                    <param name="label_fallback">31282</param>
                    <param name="top">20</param>
                    <param name="left">0</param>
                    <param name="visible">!Integer.IsEqual(Container($PARAM[id]).NumItems,0) | Container($PARAM[id]).IsUpdating | $PARAM[busy_visible]</param>
                    <param name="use_spinner">true</param>
                    <param name="run_spinner">Container($PARAM[id]).IsUpdating</param>
                </include>
                <include content="View_Line" condition="$PARAM[labelvisible] + [$PARAM[usewidgetlabel]]">
                    <param name="label">$INFO[Container($PARAM[id]).ListItem.Property(widget)]</param>
                    <param name="label_fallback">$PARAM[label]</param>
                    <param name="top">20</param>
                    <param name="left">0</param>
                    <param name="visible">!Integer.IsEqual(Container($PARAM[id]).NumItems,0) | Container($PARAM[id]).IsUpdating | $PARAM[busy_visible]</param>
                    <param name="use_spinner">true</param>
                    <param name="run_spinner">Container($PARAM[id]).IsUpdating</param>
                </include>

                <include content="Widget_Busy">
                    <param name="label">$PARAM[label]</param>
                    <param name="visible">$PARAM[busy_visible]</param>
                    <param name="include">$PARAM[include]</param>
                    <top>10</top>
                </include>

            </control>
        </definition>
    </include>

    <!-- Use as labelinclude with categoryid and categorycontent or
         categorycontentinclude; the widget can read the selected category. -->
    <include name="Widget_Categories">
        <param name="categorydebounce">false</param>
        <param name="categorytarget" />
        <param name="labeltop">widget_label_t</param>
        <param name="labelheight">widget_label_h</param>
        <param name="widgettop">widget_items_t</param>
        <param name="widgetheight">widget_items_h</param>
        <param name="categoryonback">5000</param>
        <param name="categoryonfocus">noop</param>
        <param name="categorycontentinclude">Widget_Categories_Content</param>
        <param name="categoryonclickinclude">Object_Null</param>
        <param name="categorynavigationinclude">Widget_Categories_Navigation</param>
        <definition>
            <include content="Widget_Label">
                <param name="groupid">$PARAM[groupid]</param>
                <param name="label">$PARAM[label]</param>
                <param name="id">$PARAM[id]</param>
                <param name="visible">$PARAM[visible]</param>
                <param name="busy_visible">$PARAM[busy_visible]</param>
                <param name="labelvisible">false</param>
                <param name="labeltop">$PARAM[labeltop]</param>
                <param name="labelheight">$PARAM[labelheight]</param>
                <param name="include">$PARAM[include]</param>
                <nested />

                <include content="View_Line">
                    <param name="label">$PARAM[label]</param>
                    <param name="label_fallback">31282</param>
                    <param name="top">20</param>
                    <param name="left">0</param>
                    <param name="visible">Integer.IsEqual(Container($PARAM[categoryid]).NumItems,0) + [Container($PARAM[categoryid]).IsUpdating | Container($PARAM[id]).IsUpdating]</param>
                    <param name="use_spinner">true</param>
                    <param name="run_spinner">Container($PARAM[categoryid]).IsUpdating | Container($PARAM[id]).IsUpdating</param>
                </include>

                <control type="group">
                    <top>20</top>
                    <height>40</height>
                    <visible>Integer.IsGreater(Container($PARAM[categoryid]).NumItems,0)</visible>
                    <include>View_Line_Divider</include>
                    <include content="Categories_Selector_OverlayList">
                        <param name="id">$PARAM[categoryid]</param>
                        <param name="altfocusid">$PARAM[categoryid]</param>
                        <left>-40</left>
                        <centertop>0</centertop>
                        <height>80</height>
                    </include>
                </control>
            </include>

            <!-- Match the widget's focus area so the grouplist scrolls the
                 selector to the same position when navigating from either side. -->
            <include content="Categories_Selector_ControlList">
                <param name="id">$PARAM[categoryid]</param>
                <param name="altfocusid">$PARAM[categoryid]</param>
                <param name="hidden_button">Widget_Combined_Categories_HiddenButton</param>
                <param name="hidden_button_enabled">$PARAM[categorydebounce]</param>
                <param name="hidden_button_prefix">WidgetCombined.$PARAM[categoryid].</param>
                <param name="focuscentertop">10</param>
                <param name="height">$PARAM[widgetheight]</param>
                <nested />
                <top>$PARAM[widgettop]</top>
                <left>40</left>
                <visible>$PARAM[visible]</visible>
                <hitrect x="0" y="0" w="0" h="0" />
                <onleft>$PARAM[categoryid]</onleft>
                <onright>$PARAM[categoryid]</onright>
                <include content="$PARAM[categorynavigationinclude]">
                    <param name="id">$PARAM[id]</param>
                    <param name="categoryid">$PARAM[categoryid]</param>
                </include>
                <onback>$PARAM[categoryonback]</onback>
                <include content="$PARAM[categoryonclickinclude]" />
                <onfocus>$PARAM[categoryonfocus]</onfocus>
                <include content="Widget_OnFocus">
                    <param name="widget_hideartwork">$PARAM[widget_hideartwork]</param>
                    <param name="widget_showoverlay">$PARAM[widget_showoverlay]</param>
                </include>
                <include content="$PARAM[categorycontentinclude]">
                    <param name="categorycontent">$PARAM[categorycontent]</param>
                    <param name="categorytarget">$PARAM[categorytarget]</param>
                </include>
            </include>

            <!-- Reclaim the selector's focus area so the content widget has
                 the same scroll offset and the following rows keep their spacing. -->
            <control type="group" id="59$PARAM[categoryid]">
                <top>-$PARAM[widgettop]</top>
                <height>-$PARAM[widgetheight]</height>
                <visible>$PARAM[visible]</visible>
            </control>
        </definition>
    </include>

    <include name="Widget_Categories_Content">
        <param name="categorytarget" />
        <definition>
            <content target="$PARAM[categorytarget]">$PARAM[categorycontent]</content>
        </definition>
    </include>

    <include name="Widget_Categories_Navigation">
        <ondown>$PARAM[id]</ondown>
    </include>

    <include name="Widget_Combined_Categories_Navigation">
        <ondown>SetProperty(WidgetCombined.$PARAM[categoryid].Path,$ESCINFO[Container($PARAM[categoryid]).ListItem.FolderPath])</ondown>
        <ondown>$PARAM[id]</ondown>
        <onfocus>ClearProperty(HomeSwitcher.IsVisible,Home)</onfocus>
        <onfocus>ClearProperty(InfoPanel.FullSwitch,Home)</onfocus>
    </include>

    <include name="Widget_Combined_Categories_HiddenButton_OnFocus">
        <definition>
            <!-- Kodi executes onfocus only after the focus animation finishes. -->
            <animation effect="fade" start="100" end="100" time="400" reversible="false">Focus</animation>
            <onfocus>SetProperty($PARAM[prefix]Path,$ESCINFO[$PARAM[container]ListItem.FolderPath])</onfocus>
        </definition>
    </include>

    <include name="Widget_OnFocus">
        <onfocus condition="!$EXP[Exp_InfoDialogs] + $PARAM[widget_hideartwork]">SetProperty(Background.HideArtwork,True)</onfocus>
        <onfocus condition="$EXP[Exp_InfoDialogs] + $PARAM[widget_hideartwork]">SetProperty(Background.DialogInfo.HideArtwork,True,Home)</onfocus>

        <onfocus condition="!$EXP[Exp_InfoDialogs] + ![$PARAM[widget_hideartwork]]">ClearProperty(Background.HideArtwork)</onfocus>
        <onfocus condition="$EXP[Exp_InfoDialogs] + ![$PARAM[widget_hideartwork]]">ClearProperty(Background.DialogInfo.HideArtwork,Home)</onfocus>

        <onfocus condition="!$EXP[Exp_InfoDialogs] + ![$PARAM[widget_showoverlay]]">ClearProperty(Background.ShowOverlay,Home)</onfocus>
        <onfocus condition="!$EXP[Exp_InfoDialogs] + $PARAM[widget_showoverlay]">SetProperty(Background.ShowOverlay,True,Home)</onfocus>
    </include>

    <include name="Widget_Content">
        <param name="categorydebounce">false</param>
        <param name="categorytarget" />
        <param name="visible">true</param>
        <param name="altvisible">false</param>
        <param name="include">List_Poster_Row</param>
        <param name="busy_visible">true</param>
        <param name="busy_isupdating">false</param>
        <param name="usewidgetlabel">false</param>
        <param name="widgettop">widget_items_t</param>
        <param name="widgetheight">widget_items_h</param>
        <param name="conditional_fade">false</param>
        <param name="widgetfade_include">false</param>
        <param name="widgetfade_disable">false</param>
        <param name="widget_hideartwork">false</param>
        <param name="widget_showoverlay">false</param>
        <param name="labelinclude">Widget_Label</param>
        <param name="categoryid">0</param>
        <definition>
            <include content="$PARAM[labelinclude]">
                <param name="groupid">$PARAM[groupid]</param>
                <param name="label">$PARAM[label]</param>
                <param name="id">$PARAM[id]</param>
                <param name="visible">[Container($PARAM[id]).IsUpdating | !Integer.IsEqual(Container($PARAM[id]).NumItems,0) | $PARAM[altvisible]] + $PARAM[visible]</param>
                <param name="busy_visible">[Container($PARAM[id]).IsUpdating | $PARAM[busy_isupdating]] + $PARAM[busy_visible]</param>
                <param name="usewidgetlabel">$PARAM[usewidgetlabel]</param>
                <param name="labelvisible">$PARAM[labelvisible]</param>
                <param name="labeltop">$PARAM[labeltop]</param>
                <param name="labelheight">$PARAM[labelheight]</param>
                <param name="widgettop">$PARAM[widgettop]</param>
                <param name="widgetheight">$PARAM[widgetheight]</param>
                <param name="include">$PARAM[include]</param>
                <param name="categoryid">$PARAM[categoryid]</param>
                <param name="categorydebounce">$PARAM[categorydebounce]</param>
                <param name="categorycontent">$PARAM[categorycontent]</param>
                <param name="categorytarget">$PARAM[categorytarget]</param>
                <param name="categorycontentinclude">$PARAM[categorycontentinclude]</param>
                <param name="categoryonback">$PARAM[categoryonback]</param>
                <param name="categoryonfocus">$PARAM[categoryonfocus]</param>
                <param name="categoryonclickinclude">$PARAM[categoryonclickinclude]</param>
                <param name="categorynavigationinclude">$PARAM[categorynavigationinclude]</param>
                <param name="widget_hideartwork">$PARAM[widget_hideartwork]</param>
                <param name="widget_showoverlay">$PARAM[widget_showoverlay]</param>
                <include content="Animation_ConditionalFade">
                    <param name="condition">$PARAM[conditional_fade]</param>
                </include>
                <include content="Animation_Widget_FadeOut" condition="$PARAM[widgetfade_include]">
                    <param name="condition">!Control.HasFocus($PARAM[id]) + !Control.HasFocus($PARAM[categoryid]) + !Integer.IsEqual(Window.Property(TMDBHelper.WidgetContainer),$PARAM[id]) + ![$PARAM[widgetfade_disable]]</param>
                </include>

            </include>
            <include content="$PARAM[include]">
                <param name="id">$PARAM[id]</param>
                <param name="icon">$PARAM[icon]</param>
                <param name="detailed">$PARAM[detailed]</param>
                <param name="item_h">$PARAM[item_h]</param>
                <param name="itemlayout_h">$PARAM[itemlayout_h]</param>
                <param name="item_w">$PARAM[item_w]</param>
                <param name="itemlayout_w">$PARAM[itemlayout_w]</param>
                <param name="hidden_button_enabled">true</param>
                <nested />
                <include content="Object_HitRect">
                    <param name="x">0</param>
                    <param name="y">130</param>
                    <param name="w">1920</param>
                    <param name="h">view_poster_itemlayout_h</param>
                </include>
                <top>$PARAM[widgettop]</top>
                <height>$PARAM[widgetheight]</height>
                <animation effect="fade" start="100" end="0" time="0" condition="[Container($PARAM[id]).IsUpdating | $PARAM[busy_isupdating]] + $PARAM[busy_visible] + ![$PARAM[categorydebounce]]">Conditional</animation>
                <!-- Allow Widget_Busy's 200 ms delay and 200 ms fade-in to finish before fading out combined content. -->
                <animation effect="fade" start="100" end="0" time="200" delay="400" reversible="false" condition="[Container($PARAM[id]).IsUpdating | $PARAM[busy_isupdating]] + $PARAM[busy_visible] + $PARAM[categorydebounce]">Conditional</animation>
                <visible>$PARAM[visible] + [Container($PARAM[id]).IsUpdating | !Integer.IsEqual(Container($PARAM[id]).NumItems,0) | $PARAM[altvisible]]</visible>

                <include content="Widget_OnFocus">
                    <param name="widget_hideartwork">$PARAM[widget_hideartwork]</param>
                    <param name="widget_showoverlay">$PARAM[widget_showoverlay]</param>
                </include>

                <include content="Animation_Widget_FadeOut" condition="$PARAM[widgetfade_include]">
                    <param name="condition">!Control.HasFocus($PARAM[id]) + !Control.HasFocus($PARAM[categoryid]) + !Integer.IsEqual(Window.Property(TMDBHelper.WidgetContainer),$PARAM[id]) + ![$PARAM[widgetfade_disable]]</param>
                </include>

                <include content="Animation_ConditionalFade">
                    <param name="condition">$PARAM[conditional_fade]</param>
                </include>
            </include>
        </definition>
    </include>

    <include name="Widget_End_Bumper">
        <param name="id">5097</param>
        <param name="widgets_only">true</param>
        <param name="visible">true</param>
        <definition>
