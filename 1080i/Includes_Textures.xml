    </include>

    <include name="Texture_Shadow_Provider">
        <include content="Dimension_Padding"><param name="pad">-40</param></include>
        <bordersize>40</bordersize>
        <bordertexture colordiffuse="shadow_soft">shadows/circle_provider.png</bordertexture>
    </include>

    <!-- Focus textures are resolved on window load; changing FocusStyle reloads the skin. -->
    <include name="Texture_FocusStyle">
        <param name="include">Object_Texture</param>
        <param name="directory">common</param>
        <param name="texture">menu</param>
        <param name="variant" />
        <param name="border">40</param>
        <param name="colordiffuse">$VAR[ColorHighlight]</param>
        <param name="flipx">false</param>
        <param name="diffuse"></param>
        <definition>
            <include content="$PARAM[include]" condition="!$EXP[Exp_FocusStyle_Outlined]">
                <param name="texture">$PARAM[directory]/$PARAM[texture].png</param>
                <param name="border">$PARAM[border]</param>
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="flipx">$PARAM[flipx]</param>
                <param name="flipy">false</param>
                <param name="diffuse">$PARAM[diffuse]</param>
                <param name="background">false</param>
            </include>
            <include content="$PARAM[include]" condition="$EXP[Exp_FocusStyle_Outlined]">
                <param name="texture">$PARAM[directory]/$PARAM[texture]$PARAM[variant]-focus-outlined.png</param>
                <param name="border">$PARAM[border]</param>
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="flipx">$PARAM[flipx]</param>
                <param name="flipy">false</param>
                <param name="diffuse">$PARAM[diffuse]</param>
                <param name="background">false</param>
            </include>
        </definition>
    </include>

    <include name="Texture_Highlight">
