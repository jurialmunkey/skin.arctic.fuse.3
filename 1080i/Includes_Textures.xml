<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <include name="Texture_FlixArt_Foreground_Sized">
        <param name="size">1280x720</param>
        <param name="variant">flixart</param>
        <definition>
            <texture background="true" diffuse="special://skin/extras/diffuse/flixart/$PARAM[size]/$PARAM[variant].png">$VAR[Image_Foreground]</texture>
        </definition>
    </include>

    <include name="Texture_FlixArt_Foreground">
        <param name="variant">flixart</param>
        <definition>
            <include content="Texture_FlixArt_Foreground_Sized" condition="Skin.String(Skin.FlixArt.Size,Large)">
                <param name="size">1440x810</param>
                <param name="variant">$PARAM[variant]</param>
            </include>
            <include content="Texture_FlixArt_Foreground_Sized" condition="Skin.String(Skin.FlixArt.Size,ExtraLarge)">
                <param name="size">1600x900</param>
                <param name="variant">$PARAM[variant]</param>
            </include>
            <include content="Texture_FlixArt_Foreground_Sized" condition="!Skin.String(Skin.FlixArt.Size,Large) + !Skin.String(Skin.FlixArt.Size,ExtraLarge)">
                <param name="variant">$PARAM[variant]</param>
            </include>
        </definition>
    </include>

    <include name="Texture_Shadow_20">
        <param name="colordiffuse">shadow_hard</param>
        <definition>
            <include content="Dimension_Padding"><param name="pad">-20</param></include>
            <bordersize>20</bordersize>
            <bordertexture border="40" colordiffuse="$PARAM[colordiffuse]">shadows/shadow-20.png</bordertexture>
        </definition>
    </include>

    <include name="Texture_Shadow_40">
        <param name="colordiffuse">shadow_hard</param>
        <definition>
            <include content="Dimension_Padding"><param name="pad">-40</param></include>
            <bordersize>40</bordersize>
            <bordertexture border="60" colordiffuse="$PARAM[colordiffuse]">shadows/shadow-40.png</bordertexture>
        </definition>
    </include>

    <include name="Texture_Shadow_80">
        <param name="colordiffuse">shadow_hard</param>
        <definition>
