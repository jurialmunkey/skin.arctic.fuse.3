    <include name="View_Combined_Wall_List_Horz_Selector_Movement">
        <include content="Action_View_Movement_OnUp">
            <param name="id">55$PARAM[id]</param>
        </include>
        <ondown condition="Container(55$PARAM[id]).ListItem.IsFolder">SetProperty(ViewCombined.55$PARAM[id].Path,$ESCINFO[Container(55$PARAM[id]).ListItem.FolderPath])</ondown>
        <ondown condition="!Container(55$PARAM[id]).ListItem.IsFolder">ClearProperty(ViewCombined.55$PARAM[id].Path)</ondown>
        <ondown>SetProperty(ViewCombined.55$PARAM[id].Directory,$ESCINFO[Container.FolderPath])</ondown>
        <ondown>56$PARAM[id]</ondown>
        <onleft>55$PARAM[id]</onleft>
        <onright>55$PARAM[id]</onright>
    </include>

    <include name="View_Combined_Wall_List_Horz_Selector_Content">
        <param name="overlay">true</param>
        <param name="include_movement">View_Combined_Wall_List_Horz_Selector_Movement</param>
        <definition>
            <include content="Action_View_Movement_OnBack">
                <param name="id">55$PARAM[id]</param>
                <param name="onback">[Integer.IsEqual(Container(55$PARAM[id]).CurrentItem,1)]</param>
                <param name="backid">63</param>
                <param name="menuid">300</param>
            </include>
            <include content="$PARAM[include_movement]">
                <param name="id">$PARAM[id]</param>
            </include>
            <left>40</left>
            <centertop>0</centertop>
            <height>80</height>
            <onfocus>ClearProperty(TMDbHelper.WidgetContainer)</onfocus>
            <onfocus condition="![$PARAM[overlay]]">ClearProperty(Background.ShowOverlay,Home)</onfocus>
            <onfocus condition="$PARAM[overlay]">SetProperty(Background.ShowOverlay,True,Home)</onfocus>
            <onfocus condition="![$PARAM[overlay]]">ClearProperty(InfoPanel.FullSwitch,Home)</onfocus>
            <onfocus condition="$PARAM[overlay]">SetProperty(InfoPanel.FullSwitch,Wall,Home)</onfocus>
            <visible>$PARAM[visible]</visible>
            <viewtype label="$PARAM[viewtype_label]">wrap</viewtype>
        </definition>
    </include>

    <include name="View_Combined_Wall_List_Horz">
        <param name="overlay">true</param>
        <param name="include_movement">View_Combined_Wall_List_Horz_Selector_Movement</param>
        <definition>
            <control type="group">
                <visible>$PARAM[visible]</visible>
                <include content="Categories_Selector">
                    <param name="id">55$PARAM[id]</param>
                    <param name="altfocusid">57$PARAM[id]</param>
                    <param name="hidden_button">View_Combined_Selector_HiddenButton</param>
                    <param name="hidden_button_enabled">true</param>
