<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="InfoLine_Editor">
        <definition>
            <include content="Object_Hidden_List">
                <param name="id">7001</param>
                <content><include>InfoLine_Count_$PARAM[dbtype]</include></content>
            </include>
            <include content="InfoLine_Preview_Data">
                <param name="dbtype">$PARAM[dbtype]</param>
            </include>
            <!-- No open animation while the style button reopens the editor -->
            <include content="Part_Dim_Overlay">
                <param name="windowopen_condition">!String.IsEqual(Window(Home).Property(InfoLine.Reopen),true)</param>
            </include>
            <control type="group">
                <include content="Animation_BounceIn_Dialog">
                    <param name="windowopen_condition">!String.IsEqual(Window(Home).Property(InfoLine.Reopen),true)</param>
                </include>
                <include>Dimension_DialogFullMenu</include>
                <include content="Part_Background_Panel">
                    <param name="dialog_size">Dimension_DialogFullMenu</param>
                </include>
                <control type="group">
                    <include>Size_Dialog_Pad</include>
                    <control type="group">
                        <include>Size_LeftGroup_Main</include>
                        <control type="group">
                            <include>Size_Group_Head</include>
                            <include content="Part_HeadText">
                                <param name="label">$INFO[Window(Home).Property(CustomDialogSettingsTitle)]</param>
                            </include>
                            <control type="group">
                                <top>80</top>
                                <include content="Part_ItemLine">
                                    <param name="label">$INFO[Container(7001).NumItems] $LOCALIZE[31939]</param>
                                </include>
                            </control>
                        </control>
                        <control type="group">
                            <top>90</top>
                            <include content="Info_Line">
                                <param name="left">constant_dialog_pad</param>
                                <param name="container">Container(7000).</param>
                                <param name="colordiffuse">dialog_fg</param>
                            </include>
                        </control>
                        <control type="group">
                            <include>Size_Group_Body</include>
                            <control type="group">
                                <top>80</top>
                                <control type="group">
                                    <include>Size_Grouplist_Pad</include>
                                    <include content="List_Dialog">
                                        <param name="id">450</param>
                                        <param name="itemlayout_include">InfoLine_RowLayout</param>
                                        <onright>9000</onright>
                                        <content>
                                            <include>InfoLine_Rows_$PARAM[dbtype]</include>
                                        </content>
                                    </include>
                                </control>
                            </control>
                        </control>
                    </control>
                    <include content="Part_Button_Grouplist">
                        <param name="onleft">450</param>
                        <param name="items">InfoLine_Editor_Buttons</param>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <!-- Right panel of the info line editor. Info lines pick their style when windows load, so switching style reopens the editor to rebuild its includes -->

    <include name="InfoLine_Editor_Buttons">
        <include content="Button_Dialog">
            <param name="id">9001</param>
            <param name="groupid">9101</param>
            <param name="icon">special://skin/extras/icons/circle-xmark.png</param>
            <label>$LOCALIZE[15067]</label>
            <onclick>Close</onclick>
        </include>
        <include content="Button_Dialog">
            <param name="id">9002</param>
            <param name="groupid">9102</param>
            <param name="icon">special://skin/extras/icons/triangle-exclamation.png</param>
            <label>$LOCALIZE[13007]</label>
            <include>InfoLine_Reset</include>
        </include>
        <include content="Button_Dialog">
            <param name="id">9003</param>
            <param name="groupid">9103</param>
            <param name="icon">special://skin/extras/icons/skinsettings.png</param>
            <label>$VAR[Label_Setting_InfoTags_Style]</label>
            <onclick condition="String.IsEmpty(Skin.String(InfoTags.Style))">Skin.SetString(InfoTags.Style,Pill)</onclick>
            <onclick condition="Skin.String(InfoTags.Style,Pill)">Skin.SetString(InfoTags.Style,Text)</onclick>
            <onclick condition="Skin.String(InfoTags.Style,Text)">Skin.Reset(InfoTags.Style)</onclick>
            <onclick>RunScript(script.skinvariables,run_executebuiltin=special://skin/shortcuts/builtins/skinvariables-infoline-budget.json,use_rules=True,layout=All,reserved=None,room=9,enable_item=)</onclick>
            <onclick>RunScript(script.skinvariables,run_executebuiltin=Dialog.Close(1162,true)||SetProperty(InfoLine.Reopen,true,Home)||ActivateWindow(1162)||SetFocus(9003)||ClearProperty(InfoLine.Reopen,Home))</onclick>
        </include>
    </include>

    <include name="InfoLine_RowLayout">
        <definition>
            <include condition="$PARAM[selected]">Part_List_Highlight</include>
            <control type="group">
                <left>40</left>
                <right>20</right>
                <animation effect="fadediffuse" start="ffffffff" end="FFBF0000" condition="String.IsEqual(ListItem.Property(disabled),true)">Conditional</animation>
                <include content="Part_List_Icon">
                    <param name="item_h">$PARAM[item_h]</param>
                    <param name="selected">$PARAM[selected]</param>
                    <param name="diffuse" />
                    <param name="bordersize">-20</param>
                </include>
                <control type="group">
                    <right>72</right>
                    <include content="List_Layout_Dialog_Labels">
                        <param name="item_h">$PARAM[item_h]</param>
                        <param name="selected">$PARAM[selected]</param>
                    </include>
                </control>
                <control type="image">
                    <right>0</right>
                    <centertop>50%</centertop>
                    <width>72</width>
                    <height>72</height>
                    <include condition="$PARAM[selected]">Color_SelectedImage</include>
                    <colordiffuse>dialog_fg_90</colordiffuse>
                    <texture>$VAR[InfoLine_RowIcon]</texture>
                </control>
            </control>
        </definition>
    </include>

    <variable name="InfoLine_RowIcon">
        <value condition="String.IsEqual(ListItem.Property(disabled),true)">special://skin/extras/icons/circle-cancel.png</value>
        <value>special://skin/extras/icons/circle-check.png</value>
    </variable>

    <!-- Sample video item for the info line preview: a SkinVariables dummy item, so the preview reads the same infolabels as a real item -->
    <include name="InfoLine_Preview_Data">
        <include content="Object_Hidden_List">
            <param name="id">7000</param>
            <content>plugin://script.skinvariables/?info=get_dummy_item&amp;mediatype=$PARAM[dbtype]&amp;duration=6120&amp;rating=8&amp;premiered=$INFO[System.Date(yyyy-mm-dd)]&amp;year=$INFO[System.Date(yyyy)]&amp;mpaa=PG&amp;video.width=3840&amp;video.height=2160&amp;video.aspect=1.78&amp;video.codec=hevc&amp;video.hdrtype=hdr10&amp;video.stereomode=left_right&amp;audio.channels=6&amp;audio.codec=aac</content>
        </include>
    </include>
</includes>
