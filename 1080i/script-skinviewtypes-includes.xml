<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!-- Defer shortcut generation until viewtypes have been rebuilt and the skin reloaded. -->
    <expression name="Exp_ViewTypes_RebuildPending">true</expression>

    <include name="Action_BuildViews">
        <onload>RunScript(script.skinvariables,action=buildviews)</onload>
    </include>

    <!-- One-off settings migrations, run once after each skin update until viewtypes are rebuilt. -->
    <include name="Action_MigrateSettings">
        <onload>RunScript(script.skinvariables,run_executebuiltin=special://skin/shortcuts/skinvariables-migrate-ratings.json,use_rules=True)</onload>
    </include>
</includes>