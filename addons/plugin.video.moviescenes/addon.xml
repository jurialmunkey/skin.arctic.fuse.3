<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.moviescenes" name="Movie Scenes" version="1.2.1" provider-name="Pavan">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video executable</provides>
    </extension>
    <extension point="kodi.context.item">
        <menu id="kodi.core.main">
            <item library="context.py">
                <label>Movie scenes…</label>
                <visible>String.IsEqual(ListItem.DBType,movie) + !String.IsEmpty(ListItem.DBID)</visible>
            </item>
        </menu>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Your own scene selection for the movies in your library</summary>
        <description lang="en_GB">Mark scenes while watching a movie, give them names, and pick them from the movie's info screen before playback starts. Scenes and their thumbnails are saved next to the movie file, so every Kodi device that plays from the same share sees them.</description>
        <platform>all</platform>
        <license>GPL-3.0-or-later</license>
        <source>https://github.com/pavanpatel687/skin.arctic.fuse.3/tree/scene-selection/addons/plugin.video.moviescenes</source>
    </extension>
</addon>
