<contents>
    <lists>
        <list name="ratingsmovies">
            <value name="content">Movies</value>
        </list>
        <list name="ratingstvshows">
            <value name="content">TVShows</value>
        </list>
    </lists>
    <items>
        <item>
            <value name="comments">Enabled {content} ratings in menu order: Info_Meta_Ratings_[path] for each, shown while it is one of the first three available</value>
            <template>generator/data/parts/basic_include.xmltemplate</template>
            <value name="includes_name">skinvariables-{item}</value>
            <value name="includes_part">
                <items menu="{item}">
                    <item>
                        <template>generator/data/parts/ratings_include_item.xmltemplate</template>
                        <condition>{item_disabled}!=True</condition>
                    </item>
                </items>
            </value>
        </item>
    </items>
</contents>
