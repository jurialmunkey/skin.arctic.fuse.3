<contents>
    <template>generator/data/parts/basic_include.xmltemplate</template>
    <value name="comments">Simple Widgets</value>
    <value name="includes_name">skinvariables-{item}-simple</value>
    <value name="includes_part">
        <value name="grouplist_id">602</value>
        <value name="grouplist_refocus">SetFocus(302)</value>
        <value name="grouplist_constants_affix">_simple</value>
        <template>generator/data/parts/widgets_grouplist.xmltemplate</template>
        <value name="all_widgets">
            <items menu="{item}">
                <item>
                    <template>generator/data/parts/widgets_row.xmltemplate</template>
                    <datafile>generator/data/setup/widgets_row.xml</datafile>
                    <datafile>generator/data/setup/widgets_include_row.xml</datafile>
                    <datafile>generator/data/setup/widgets_layout_simple.xml</datafile>
                    <condition>{item_disabled}!=True</condition>
                    <condition>{item_widget_combined}!=True</condition>
                </item>
                <item>
                    <template>generator/data/parts/widgets_row.xmltemplate</template>
                    <datafile>generator/data/setup/widgets_row.xml</datafile>
                    <datafile>generator/data/setup/widgets_include_row.xml</datafile>
                    <datafile>generator/data/setup/widgets_layout_simple.xml</datafile>
                    <condition>{item_disabled}!=True</condition>
                    <condition>{item_widget_combined}==True</condition>
                    <condition>{item_path}==Weather</condition>
                </item>
                <item>
                    <template>generator/data/parts/widgets_combined_row.xmltemplate</template>
                    <datafile>generator/data/setup/widgets_row.xml</datafile>
                    <datafile>generator/data/setup/widgets_include_row.xml</datafile>
                    <datafile>generator/data/setup/widgets_include_combined_row.xml</datafile>
                    <datafile>generator/data/setup/widgets_layout_simple.xml</datafile>
                    <condition>{item_disabled}!=True</condition>
                    <condition>{item_widget_combined}==True</condition>
                    <condition>{item_path}!=Weather</condition>
                </item>
            </items>
        </value>
        <value name="end_widgets">
            <template>
                <![CDATA[
                <include>Widget_End_Bumper</include>
                ]]>
            </template>
        </value>
    </value>
    <value name="includes_misc">
        <template>
            <![CDATA[
            <include content="Hub_Spotlight_Content_Slide"><param name="slide">440</param></include>
            ]]>
        </template>
    </value>
</contents>
