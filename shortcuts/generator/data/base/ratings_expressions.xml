<contents>
    <!-- Each ratings menu item path is the name of the rating property that holds its value.
         For every rating source (service) the expressions keep a running count of available ratings in menu order:
         Exp_Ratings_{service}_{content}_N_SeenK is true when at least K of the items before menu position N are available.
         An item is visible when it is available and fewer than three items before it are available, so the first three available ratings show. -->
    <lists>
        <list name="ratingsmovies_ListItem">
            <value name="menu">ratingsmovies</value>
            <value name="content">Movies</value>
            <value name="service">ListItem</value>
            <value name="source">Window(Home).Property(TMDbHelper.ListItem.</value>
        </list>
        <list name="ratingsmovies_Player">
            <value name="menu">ratingsmovies</value>
            <value name="content">Movies</value>
            <value name="service">Player</value>
            <value name="source">Window(Home).Property(TMDbHelper.Player.</value>
        </list>
        <list name="ratingsmovies_C7000">
            <value name="menu">ratingsmovies</value>
            <value name="content">Movies</value>
            <value name="service">C7000</value>
            <value name="source">Container(7000).ListItem.Property(</value>
        </list>
        <list name="ratingstvshows_ListItem">
            <value name="menu">ratingstvshows</value>
            <value name="content">TVShows</value>
            <value name="service">ListItem</value>
            <value name="source">Window(Home).Property(TMDbHelper.ListItem.</value>
        </list>
        <list name="ratingstvshows_Player">
            <value name="menu">ratingstvshows</value>
            <value name="content">TVShows</value>
            <value name="service">Player</value>
            <value name="source">Window(Home).Property(TMDbHelper.Player.</value>
        </list>
        <list name="ratingstvshows_C7000">
            <value name="menu">ratingstvshows</value>
            <value name="content">TVShows</value>
            <value name="service">C7000</value>
            <value name="source">Container(7000).ListItem.Property(</value>
        </list>
    </lists>
    <items>
        <item>
            <value name="comments">Ratings visibility for {content} from {service}</value>
            <template>generator/data/parts/ratings_expressions_group.xmltemplate</template>
            <value name="includes_part">
                <items menu="{menu}">
                    <item>
                        <template>generator/data/parts/ratings_expressions_enabled.xmltemplate</template>
                        <condition>{item_disabled}!=True</condition>
                    </item>
                    <item>
                        <template>generator/data/parts/ratings_expressions_disabled.xmltemplate</template>
                        <condition>{item_disabled}==True</condition>
                    </item>
                </items>
            </value>
        </item>
    </items>
</contents>
