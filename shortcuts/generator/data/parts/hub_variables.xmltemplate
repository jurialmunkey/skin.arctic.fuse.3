<variable name="Hub_Label_{item_window}">
    <value>{item_label}</value>
</variable>
<variable name="Hub_Shortcut_{item_window}">
    <value>{parts_action}</value>
</variable>
<variable name="Label_Hub_Enabled_{item_window}">
    <value condition="{parts_enabled}">True</value>
</variable>
<expression name="Exp_Hub_Enabled_{item_window}">{parts_enabled}</expression>
<variable name="Home_Icon_{item_window}">
    {parts_icon}
</variable>
