<expression name="Exp_Ratings_{service}_{content}_{item_x}_Visible">[!String.IsEmpty({source}{item_path})) + !$EXP[Exp_Ratings_{service}_{content}_{item_x}_Seen3]]</expression>
<expression name="Exp_Ratings_{service}_{content}_$MATH[{item_x} + 1]_Seen1">[$EXP[Exp_Ratings_{service}_{content}_{item_x}_Seen1] | !String.IsEmpty({source}{item_path}))]</expression>
<expression name="Exp_Ratings_{service}_{content}_$MATH[{item_x} + 1]_Seen2">[$EXP[Exp_Ratings_{service}_{content}_{item_x}_Seen2] | [$EXP[Exp_Ratings_{service}_{content}_{item_x}_Seen1] + !String.IsEmpty({source}{item_path}))]]</expression>
<expression name="Exp_Ratings_{service}_{content}_$MATH[{item_x} + 1]_Seen3">[$EXP[Exp_Ratings_{service}_{content}_{item_x}_Seen3] | [$EXP[Exp_Ratings_{service}_{content}_{item_x}_Seen2] + !String.IsEmpty({source}{item_path}))]]</expression>
