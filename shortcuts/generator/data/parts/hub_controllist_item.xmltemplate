<include content="Home_ControlList_Item">
    <param name="label">$VAR[Hub_Label_{item_window}]</param>
    <param name="icon">$VAR[Home_Icon_{item_window}]</param>
    <param name="action">ReplaceWindow({item_window})</param>
    <param name="enabled">true</param>
    <param name="visible">Window.IsVisible(1105) | Window.IsVisible(Home){parts_previous}</param>
    <param name="mod">$PARAM[mod]</param>
</include>
