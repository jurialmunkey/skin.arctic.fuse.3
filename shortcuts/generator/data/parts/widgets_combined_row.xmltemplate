<include content="Widget_Info_Row">
    <param name="id">{widget_id}</param>
    <param name="baseid" />
    <param name="basegroupid">7</param>
    <param name="label">{widget_label}</param>
    <param name="labelinclude">Widget_Categories</param>
    <param name="categoryid">{widget_category_id}</param>
    <param name="categorycontent">{widget_path}</param>
    <param name="categorytarget">{widget_target}</param>
    <param name="categoryonfocus">SetProperty(TMDbHelper.WidgetContainer,{widget_id})</param>
    <param name="categorynavigationinclude">Widget_Combined_Categories_Navigation</param>
    <param name="menuid">302</param>
    <param name="include_movement">false</param>
    <param name="include">{widget_include}</param>
    <param name="detailed">{widget_detailed}</param>
    <param name="visible">[{widget_category_visible}] + [{widget_visible}]</param>
    <param name="altvisible">[{widget_altvisible}] | Container({widget_category_id}).IsUpdating | Integer.IsGreater(Container({widget_category_id}).NumItems,0)</param>
    <param name="busy_isupdating">{widget_busy_isupdating}</param>
    <param name="busy_visible">[Integer.IsEqual(Container({widget_id}).NumItems,0) | [Integer.IsEqual(Container({widget_id}).NumItems,1) + String.IsEqual(Container({widget_id}).ListItemAbsolute(0).Label,$LOCALIZE[31046]) + Container({widget_id}).IsUpdating]]</param>
    <param name="widgetfade_include">{widget_widgetfade_include}</param>
    <param name="widgetfade_disable">{widget_widgetfade_disable}</param>
    <param name="widgettop">widget_items_t{widgetconstants_affix}</param>
    <param name="labelheight">widget_label_h{widgetconstants_affix}</param>

    <onup>{widget_category_id}</onup>
    <onfocus>ClearProperty(HomeSwitcher.IsVisible,Home)</onfocus>
    <onfocus>ClearProperty(InfoPanel.FullSwitch,Home)</onfocus>

    <include content="Action_Widget_OnBack">
        <param name="id">{widget_id}</param>
        <param name="grouplistid">{grouplist_id}</param>
        <param name="refocus">SetFocus({widget_category_id})</param>
    </include>

    <description>{description}</description>

    <include content="Widget_NoResults">
        <param name="id">{widget_id}</param>
    </include>

    <content sortby="{widget_sortby}" sortorder="{widget_sortorder}" target="{widget_target}" limit="{widget_limit}" browse="$VAR[Defs_BrowseLimitedLists]">$INFO[Container({widget_category_id}).ListItem.FolderPath]</content>

    <include content="Defs_AutoScroll" condition="{widget_isautoscroll}">
        <param name="condition">[!Control.HasFocus({widget_id}) | System.IdleTime(3)]</param>
    </include>

    {widget_custom_onclick}
    {widget_custom_onfocus}
    {widget_custom_content}

</include>
