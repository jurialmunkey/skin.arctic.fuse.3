<item>
    <label>{item_label}</label>
    <label2> ($LOCALIZE[31272]...)</label2>
    <icon>{item_icon}</icon>
    <property name="guid">{item_guid}</property>
    <property name="widget_id">$NUMBER[{widget_id}]</property>
    <property name="show_artwork">true</property>
    <property name="widget_numitems">$INFO[Container({widget_id}).NumItems]</property>
    <visible>String.IsEqual(Container(3003).ListItem.Property(mode),search) | !String.IsEqual(Skin.String(HomeSwitcher.Search.Mode),Combined)</visible>
    <visible>Container({widget_id}).IsUpdating</visible>
</item>
<item>
    <label>{item_label}</label>
    <label2>$INFO[Container({widget_id}).NumItems, (,)]</label2>
    <icon>{item_icon}</icon>
    <property name="guid">{item_guid}</property>
    <property name="widget_id">$NUMBER[{widget_id}]</property>
    <property name="show_artwork">true</property>
    <property name="widget_numitems">$INFO[Container({widget_id}).NumItems]</property>
    <!-- <visible>!Integer.IsEqual(Container({widget_id}).NumItems,0) | String.IsEmpty(Control.GetLabel(3000).index(1))</visible> -->
    <visible>String.IsEqual(Container(3003).ListItem.Property(mode),search) | !String.IsEqual(Skin.String(HomeSwitcher.Search.Mode),Combined)</visible>
    <visible>!Container({widget_id}).IsUpdating</visible>
</item>