{
    "infolabels": {
        "Season": "Window(1191).Property(SplashTest.Season)",
        "Weather": "Window(1191).Property(SplashTest.Weather)",
        "Hour": "$VAR[Label_StartUp_Test_TimeSelection]"
    },
    "regex": {
        "HourLabel": {
            "input": "{Hour}",
            "regex": "^([0-9][0-9])([0-9][0-9])$",
            "value": "\\1:\\2"
        }
    },
    "actions": [
        {
            "rules": [
                "{edit}==season"
            ],
            "value": "route=run_dialog=select&heading=Season&separator=|&list=spring|summer|autumn|winter&preselect={Season}&executebuiltin=SetProperty(SplashTest.Season,{{v}},1191)"
        },
        {
            "rules": [
                "{edit}==weather"
            ],
            "value": "route=run_dialog=select&heading=Conditions&separator=|&list=clear|partlycloudy|cloud|windy|rain|heavyrain|snow|thunderstorm|severethunderstorm|hazy&preselect={Weather}&executebuiltin=SetProperty(SplashTest.Weather,{{v}},1191)"
        },
        {
            "rules": [
                "{edit}==hour"
            ],
            "value": "route=run_dialog=select&heading=Time&separator=|&list=00:00|01:00|02:00|03:00|04:00|05:00|06:00|07:00|08:00|09:00|10:00|11:00|12:00|13:00|14:00|15:00|16:00|17:00|18:00|19:00|20:00|21:00|22:00|23:00|Auto&preselect={HourLabel}&executebuiltin_0=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,0000,1191)&executebuiltin_1=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,0100,1191)&executebuiltin_2=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,0200,1191)&executebuiltin_3=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,0300,1191)&executebuiltin_4=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,0400,1191)&executebuiltin_5=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,0500,1191)&executebuiltin_6=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,0600,1191)&executebuiltin_7=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,0700,1191)&executebuiltin_8=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,0800,1191)&executebuiltin_9=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,0900,1191)&executebuiltin_10=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,1000,1191)&executebuiltin_11=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,1100,1191)&executebuiltin_12=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,1200,1191)&executebuiltin_13=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,1300,1191)&executebuiltin_14=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,1400,1191)&executebuiltin_15=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,1500,1191)&executebuiltin_16=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,1600,1191)&executebuiltin_17=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,1700,1191)&executebuiltin_18=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,1800,1191)&executebuiltin_19=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,1900,1191)&executebuiltin_20=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,2000,1191)&executebuiltin_21=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,2100,1191)&executebuiltin_22=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,2200,1191)&executebuiltin_23=ClearProperty(SplashTest.AutoTime,1191)||SetProperty(SplashTest.Hour,2300,1191)&executebuiltin_24=SetProperty(SplashTest.AutoTime,true,1191)"
        }
    ]
}
