{
    "infolabels": {
        "SkinFolder": "$VAR[Path_SkinVariables_SkinFolder]",
        "date": "System.Date(yyyy-mm-dd)",
        "time": "System.Time(hh:mm:ss)"
    },
    "actions": [
        "route=write_menu=ratingsmovies&skin={SkinFolder}&template=special://skin/shortcuts/skinvariables-migrate-ratings-movies.json",
        "route=write_menu=ratingstvshows&skin={SkinFolder}&template=special://skin/shortcuts/skinvariables-migrate-ratings-tvshows.json",
        "route=write_menu=ratingsepisodes&skin={SkinFolder}&template=special://skin/shortcuts/skinvariables-migrate-ratings-tvshows.json",
        "Skin.SetString(Shortcuts.RebuildDateTime,{date}_{time})"
    ]
}
