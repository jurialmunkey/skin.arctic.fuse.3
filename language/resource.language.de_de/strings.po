msgctxt "#31737"
msgid "Show the channels section in this hub."
msgstr "Den Senderbereich in diesem Hub anzeigen."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31738"
msgid "Show the channel groups section in this hub."
msgstr "Den Bereich für Sendergruppen in diesem Hub anzeigen."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31739"
msgid "Show the recordings section in this hub."
msgstr "Den Aufnahmenbereich in diesem Hub anzeigen."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31740"
msgid "Show video add-ons in this hub."
msgstr "Video-Add-ons in diesem Hub anzeigen."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31741"
msgid "Show music add-ons in this hub."
msgstr "Musik-Add-ons in diesem Hub anzeigen."

