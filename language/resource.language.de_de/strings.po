msgstr "Programm-Add-ons in diesem Hub anzeigen."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31744"
msgid "Show game add-ons in this hub."
msgstr "Spiele-Add-ons in diesem Hub anzeigen."

