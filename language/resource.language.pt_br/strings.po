#: /1080i/SkinSettings.xml
msgctxt "#31644"
msgid "This category contains the settings for how the home menu, widgets and spotlight are handled."
msgstr "Esta categoria contém as configurações de como o menu inicial, widgets e destaque são gerenciados."

#: /1080i/SkinSettings.xml
msgctxt "#31645"
msgid "This category contains the settings for how colours, backgrounds and focus highlights are displayed."
msgstr "Esta categoria contém as configurações de como cores, planos de fundo e destaques de foco são exibidos."

#: /1080i/SkinSettings.xml
msgctxt "#31646"
msgid "This category contains the settings for how the footer, header and context menu are displayed."
msgstr "Esta categoria contém as configurações de como o rodapé, cabeçalho e menu de contexto são exibidos."

#: /1080i/SkinSettings.xml
msgctxt "#31647"
msgid "This category contains the settings for how ratings, plotlines and other media details are displayed."
msgstr "Esta categoria contém as configurações de como avaliações, enredos e outros detalhes de mídia são exibidos."

#: /1080i/SkinSettings.xml
msgctxt "#31648"
msgid "This category contains the settings for how viewtypes, indicators, widgets and buttons are laid out."
msgstr "Esta categoria contém as configurações de como tipos de exibição, indicadores, widgets e botões são dispostos."

#: /1080i/SkinSettings.xml
msgctxt "#31649"
msgid "This category contains the settings for how widgets, navigation, labels and playback behave."
msgstr "Esta categoria contém as configurações de como widgets, navegação, rótulos e reprodução se comportam."

#: /1080i/SkinSettings.xml
msgctxt "#31650"
msgid "This category contains the settings for input, startup, PVR and seasonal themes."
msgstr "Esta categoria contém as configurações para entrada, inicialização, PVR e temas sazonais."

#: /1080i/SkinSettings.xml
msgctxt "#31651"
msgid "This category contains the add-ons the skin depends on and the debugging tools."
msgstr "Esta categoria contém os complementos dos quais a skin depende e as ferramentas de depuração."

#: /1080i/SkinSettings.xml
msgctxt "#31652"
msgid "This category contains the settings level, which controls how many skin settings are shown."
msgstr "Esta categoria contém o nível das configurações, que controla quantas configurações da skin são exibidas."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31653"
msgid "Open the editor to customise the home menu shortcuts and the widgets shown for each item."
msgstr "Abra o editor para personalizar os atalhos do menu inicial e os widgets exibidos para cada item."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31654"
msgid "When enabled, the first widget is focused when the home screen loads instead of the menu."
msgstr "Quando ativado, o primeiro widget é focado quando a tela inicial carrega em vez do menu."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31655"
msgid "Select whether the home menu is shown along the top of the screen or down the side."
msgstr "Selecione se o menu inicial é exibido na parte superior da tela ou na lateral."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31656"
msgid "Select whether the items in the top menu are shown as text or icons."
msgstr "Selecione se os itens do menu superior são exibidos como texto ou ícones."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31657"
msgid "Select what is shown in the header above the top menu: the date, the profile, or nothing."
msgstr "Selecione o que é exibido no cabeçalho acima do menu superior: a data, o perfil ou nada."

#: /1080i/SkinSettings.xml
msgctxt "#31658"
msgid "Select whether pressing up on the top menu opens the submenu or the options menu."
msgstr "Selecione se pressionar para cima no menu superior abre o submenu ou o menu de opções."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31659"
msgid "When enabled, the spotlight slides down and dims while the top menu is shown."
msgstr "Quando ativado, o destaque desliza para baixo e esmaece enquanto o menu superior é exibido."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31660"
msgid "Select whether the spotlight button opens the information dialog or the spotlight menu."
msgstr "Selecione se o botão de destaque abre a caixa de diálogo de informações ou o menu de destaque."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31661"
msgid "Select a preset colour scheme for highlights, backgrounds and dialogs."
msgstr "Selecione um esquema de cores predefinido para destaques, planos de fundo e caixas de diálogo."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31662"
msgid "Choose the colours used for focus highlights and selected text."
msgstr "Escolha as cores usadas para destaques de foco e texto selecionado."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31663"
msgid "Choose the colour and image used for the window background."
msgstr "Escolha a cor e a imagem usadas para o plano de fundo da janela."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31664"
msgid "Choose the colour and image used for the dialog background."
msgstr "Escolha a cor e a imagem usadas para o plano de fundo da caixa de diálogo."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31665"
msgid "Choose the image shown on the splash screen while the skin starts."
msgstr "Escolha a imagem exibida na tela inicial enquanto a skin inicia."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31666"
msgid "Configure the blurred artwork shown in the background of windows."
msgstr "Configure a arte desfocada exibida no plano de fundo das janelas."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31667"
msgid "Select the background shown for genres, studios and people that have no artwork of their own."
msgstr "Selecione o plano de fundo exibido para gêneros, estúdios e pessoas que não possuem arte própria."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31668"
msgid "Select whether focused items are highlighted with a solid fill or an outline. The skin reloads to apply the change."
msgstr "Selecione se os itens em foco são realçados com um preenchimento sólido ou um contorno. A skin é recarregada para aplicar a alteração."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31669"
msgid "Select whether rating icons are shown in colour or monochrome."
msgstr "Selecione se os ícones de avaliação são exibidos em cores ou em monocromático."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31670"
msgid "Choose which viewtypes are available for each type of content."
msgstr "Escolha quais tipos de exibição estão disponíveis para cada tipo de conteúdo."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31671"
msgid "Select whether list views show simple or detailed text labels."
msgstr "Selecione se as visualizações de lista exibem rótulos de texto simples ou detalhados."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31672"
msgid "Choose which status indicators are shown on items."
msgstr "Escolha quais indicadores de status são exibidos nos itens."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31673"
msgid "Choose the widgets shown in the video OSD."
msgstr "Escolha os widgets mostrados no OSD do vídeo."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31674"
msgid "Choose the widgets shown in the information dialog."
msgstr "Escolha os widgets exibidos na caixa de diálogo de informações."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31675"
msgid "Choose the buttons shown in the information dialog."
msgstr "Escolha os botões mostrados na caixa de diálogo de informações."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31676"
msgid "Show the currently playing item in the footer."
msgstr "Mostrar o item em reprodução no rodapé."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31677"
msgid "Show the studio logo of the focused item in the footer."
msgstr "Mostrar o logotipo do estúdio do item focado no rodapé."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31678"
msgid "Show the current weather conditions in the header."
msgstr "Mostrar as condições climáticas atuais no cabeçalho."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31679"
msgid "Show the tray of quick action buttons in the context menu."
msgstr "Mostrar a bandeja de botões de ação rápida no menu de contexto."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31680"
msgid "Show the artwork of the focused item in the context menu."
msgstr "Mostrar a arte do item focado no menu de contexto."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31681"
msgid "Set how often widgets with autoscroll enabled move to the next item."
msgstr "Definir com que frequência os widgets com rolagem automática ativada passam para o próximo item."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31682"
msgid "When enabled, widgets with a limited number of items end with a Show more item that opens the full folder."
msgstr "Quando ativado, widgets com um número limitado de itens terminam com um item 'Mostrar mais' que abre a pasta completa."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31683"
msgid "Select whether widgets with no items show a placeholder or are hidden. Hiding empty widgets can cause positioning issues and reduce performance."
msgstr "Selecione se os widgets sem itens mostram um espaço reservado ou são ocultados. Ocultar widgets vazios pode causar problemas de posicionamento e reduzir o desempenho."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31684"
msgid "Cycle through the extra fanart of the focused item in the background."
msgstr "Alternar entre as fanarts extras do item focado no plano de fundo."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31685"
msgid "Select whether pressing back in a media window returns to the previous window or to the parent folder."
msgstr "Selecione se pressionar Voltar em uma janela de mídia retorna à janela anterior ou para a pasta pai."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31686"
msgid "Select whether the scrollbar jumps by letter when content is sorted alphabetically, or by page."
msgstr "Selecione se a barra de rolagem salta por letra quando o conteúdo é classificado em ordem alfabética, ou por página."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31687"
msgid "Use labels in place of textboxes for long text. This improves performance on Omega but the text will not scroll."
msgstr "Usar rótulos em vez de caixas de texto para textos longos. Isso melhora o desempenho no Omega, mas o texto não rolará."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31688"
msgid "Automatically scroll long text in textboxes, such as plots."
msgstr "Rolar automaticamente textos longos em caixas de texto, como enredos."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31689"
msgid "Automatically scroll labels that are too long to fit."
msgstr "Rolar automaticamente rótulos que são muito longos para caber."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31690"
msgid "Set the number of seconds before the video OSD closes automatically."
msgstr "Defina o número de segundos antes que o OSD do vídeo feche automaticamente."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31691"
msgid "Select whether the seekbar stays visible, shows information, or hides after playback has been paused for a while."
msgstr "Selecione se a barra de busca permanece visível, mostra informações ou se oculta depois que a reprodução for pausada por um tempo."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31692"
msgid "Set how long playback must be paused before the seekbar behaviour is applied."
msgstr "Defina por quanto tempo a reprodução deve ser pausada antes que o comportamento da barra de busca seja aplicado."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31693"
msgid "Select which times are shown on either side of the seekbar."
msgstr "Selecione quais tempos são exibidos em cada lado da barra de busca."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31694"
msgid "Show the currently playing video in the background of the interface."
msgstr "Exibir o vídeo atualmente em reprodução no plano de fundo da interface."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31695"
msgid "Enable the TMDbHelper service, which provides extra details, ratings and artwork for the focused item."
msgstr "Habilite o serviço TMDbHelper, que fornece detalhes adicionais, classificações e arte para o item focado."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31696"
msgid "Choose which ratings are shown for movies."
msgstr "Escolha quais avaliações são exibidas para filmes."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31697"
msgid "Choose which ratings are shown for TV shows."
msgstr "Escolha quais avaliações são exibidas para programas de TV."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31698"
msgid "Select the detail shown above the plot for movies: tagline, genre, director, or nothing."
msgstr "Selecione o detalhe exibido acima do enredo para filmes: slogan, gênero, diretor ou nada."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31699"
msgid "Select the detail shown above the plot for TV shows: tagline, genre, episodes, or nothing."
msgstr "Selecione o detalhe exibido acima do enredo para programas de TV: slogan, gênero, episódios ou nada."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31700"
msgid "Show the rating as stars in the item information."
msgstr "Exibir a avaliação como estrelas nas informações do item."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31701"
msgid "Show the number of audio channels in the item information."
msgstr "Exibir o número de canais de áudio nas informações do item."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31702"
msgid "Show the HDR type in the item information."
msgstr "Exibir o tipo de HDR nas informações do item."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31703"
msgid "Select the size of the mouse pointer. The skin reloads to apply the change."
msgstr "Selecione o tamanho do ponteiro do mouse. A skin é recarregada para aplicar a alteração."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31704"
msgid "Keep the splash screen visible until the home screen widgets have loaded."
msgstr "Manter a tela de carregamento visível até que os widgets da tela inicial sejam carregados."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31705"
msgid "Load hub widgets in the background during startup so that hubs open faster."
msgstr "Carregar widgets do hub em segundo plano durante a inicialização para que os hubs abram mais rápido."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31706"
msgid "Allow each skin user to have their own shortcut and widget configuration."
msgstr "Permitir que cada usuário do tema tenha sua própria configuração de atalhos e widgets."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31707"
msgid "Show the skin user selection screen each time the skin starts."
msgstr "Exibir a tela de seleção de usuário do tema sempre que o tema iniciar."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31708"
msgid "Colour the programmes in the EPG grid by genre."
msgstr "Colorir os programas na grade do EPG por gênero."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31709"
msgid "Use TMDbHelper to look up extra details and artwork for PVR programmes."
msgstr "Usar o TMDbHelper para consultar detalhes adicionais e arte para programas PVR."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31710"
msgid "Decorate the interface with seasonal themes during the dates listed for each theme."
msgstr "Decorar a interface com temas sazonais nas datas listadas para cada tema."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31711"
msgid "Select the style of the Christmas theme, or turn it off."
msgstr "Selecionar o estilo do tema de Natal ou desativá-lo."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31712"
msgid "Show the Summer Breeze theme during its season."
msgstr "Exibir o tema Brisa de Verão durante sua estação."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31713"
msgid "Show the Halloween Spook theme during its season."
msgstr "Exibir o tema Assustador de Halloween durante sua estação."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31714"
msgid "Show the seasonal overlay on top of the background."
msgstr "Exibir a sobreposição sazonal sobre o plano de fundo."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31715"
msgid "Show the looping seasonal animation in the background."
msgstr "Exibir a animação sazonal em loop no plano de fundo."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31716"
msgid "Show seasonal animations that occasionally fly across the screen."
msgstr "Exibir animações sazonais que ocasionalmente voam pela tela."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31717"
msgid "Select how many seasonal props fall down the screen."
msgstr "Selecionar quantos elementos decorativos sazonais caem pela tela."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31718"
msgid "Reset all skin settings to their default values. This cannot be undone."
msgstr "Redefinir todas as configurações do tema para os valores padrão. Isso não pode ser desfeito."

#: /1080i/Custom_1115_Window_Shortcuts.xml
msgctxt "#31719"
msgid "This category contains the settings for the search hub layout, widgets and discover lists."
msgstr "Esta categoria contém as configurações para o layout, widgets e listas de descoberta do hub de pesquisa."

#: /1080i/Custom_1115_Window_Shortcuts.xml
msgctxt "#31720"
msgid "This category contains the settings for the shortcut, submenu and widgets of this hub."
msgstr "Esta categoria contém as configurações para o atalho, submenu e widgets deste hub."

#: /1080i/Custom_1115_Window_Shortcuts.xml
msgctxt "#31721"
msgid "This category contains the settings for the options menu tiles, power menu and tray."
msgstr "Esta categoria contém as configurações para os blocos do menu de opções, menu de energia e bandeja."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31722"
msgid "Select how the widgets in the search hub are laid out."
msgstr "Selecionar como os widgets no hub de pesquisa são dispostos."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31723"
msgid "Choose the widgets shown in the search hub."
msgstr "Escolha os widgets exibidos no hub de pesquisa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31724"
msgid "Show the discover lists in the search hub."
msgstr "Exibir as listas de descoberta no hub de pesquisa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31725"
msgid "Include the movie decades list in discover."
msgstr "Incluir a lista de décadas de filmes na descoberta."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31726"
msgid "Include the movie keywords list in discover."
msgstr "Incluir a lista de palavras-chave de filmes na descoberta."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31727"
msgid "Include MDbList lists in discover."
msgstr "Incluir listas do MDbList na descoberta."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31728"
msgid "Select the type of hub: custom, next aired, Live TV, or add-ons."
msgstr "Selecionar o tipo de hub: personalizado, próximos a serem exibidos, TV ao vivo ou complementos."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31729"
msgid "Configure the label, icon and path of the menu shortcut for this hub."
msgstr "Configurar o rótulo, ícone e caminho do atalho do menu para este hub."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31730"
msgid "Customise the submenu items shown for this hub."
msgstr "Personalizar os itens do submenu exibidos para este hub."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31731"
msgid "Select how the widgets in this hub are laid out."
msgstr "Selecionar como os widgets neste hub são dispostos."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31732"
msgid "Configure the spotlight shown at the top of this hub."
msgstr "Configurar o destaque exibido no topo deste hub."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31733"
msgid "Choose the widgets shown in this hub."
msgstr "Escolha os widgets mostrados neste hub."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31734"
msgid "Select whether the next aired calendar uses your library or Trakt."
msgstr "Selecionar se o calendário de próximos a serem exibidos usa sua biblioteca ou Trakt."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31735"
msgid "Select whether channels in this hub are shown as square or landscape tiles."
msgstr "Selecionar se os canais neste hub são exibidos como blocos quadrados ou horizontais."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31736"
msgid "Show the search or last played section in this hub, depending on the layout."
msgstr "Exibir a seção de pesquisa ou de últimos reproduzidos neste hub, dependendo do layout."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31737"
msgid "Show the channels section in this hub."
msgstr "Exibir a seção de canais neste hub."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31738"
msgid "Show the channel groups section in this hub."
msgstr "Exibir a seção de grupos de canais neste hub."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31739"
msgid "Show the recordings section in this hub."
msgstr "Exibir a seção de gravações neste hub."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31740"
msgid "Show video add-ons in this hub."
msgstr "Exibir complementos de vídeo neste hub."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31741"
msgid "Show music add-ons in this hub."
msgstr "Exibir complementos de música neste hub."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31742"
msgid "Show picture add-ons in this hub."
msgstr "Exibir complementos de imagem neste hub."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31743"
msgid "Show program add-ons in this hub."
msgstr "Mostrar complementos de programa neste hub."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31744"
msgid "Show game add-ons in this hub."
msgstr "Mostrar complementos de jogo neste hub."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31745"
msgid "Select how many tiles are shown in the options menu."
msgstr "Selecione quantos blocos são mostrados no menu de opções."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31746"
msgid "Select what this tile shows. Choose Custom to set your own shortcut."
msgstr "Selecione o que este bloco mostra. Escolha Personalizado para definir seu próprio atalho."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31747"
msgid "Choose the shortcut opened by this custom tile."
msgstr "Escolha o atalho aberto por este bloco personalizado."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31748"
msgid "Set the label shown on this custom tile."
msgstr "Defina o rótulo mostrado neste bloco personalizado."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31749"
msgid "Choose the icon shown on this custom tile."
msgstr "Escolha o ícone mostrado neste bloco personalizado."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31750"
msgid "Customise the items in the power menu."
msgstr "Personalize os itens no menu de energia."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31751"
msgid "Customise the buttons in the tray of the options menu."
msgstr "Personalize os botões na bandeja do menu de opções."
