#: /1080i/SkinSettings.xml
msgctxt "#31644"
msgid "This category contains the settings for the home menu, spotlight, startup and skin users."
msgstr "Ta sekcja zawiera ustawienia menu głównego, sekcji „Wyróżnione”, uruchamiania i profili."

#: /1080i/SkinSettings.xml
msgctxt "#31645"
msgid "This category contains the settings for the colour scheme and backgrounds."
msgstr "Ta sekcja zawiera ustawienia schematu kolorów i teł."

#: /1080i/SkinSettings.xml
msgctxt "#31646"
msgid "This category contains the settings for the header, footer, context menu, text and mouse pointer."
msgstr "Ta sekcja zawiera ustawienia nagłówka, stopki, menu kontekstowego, tekstu i kursora."

#: /1080i/SkinSettings.xml
msgctxt "#31647"
msgid "This category contains the settings for viewtypes, indicators, navigation and Live TV."
msgstr "Ta sekcja zawiera ustawienia widoków, wskaźników, nawigacji i TV na żywo."

#: /1080i/SkinSettings.xml
msgctxt "#31648"
msgid "This category contains the settings for widget behaviour and the information dialog widgets and buttons."
msgstr "Ta sekcja zawiera ustawienia działania widżetów oraz zawartości okna informacji."

#: /1080i/SkinSettings.xml
msgctxt "#31649"
msgid "This category contains the settings for TMDbHelper, ratings, plotlines and other media details."
msgstr "Ta sekcja zawiera ustawienia TMDbHelper, ocen, linii informacyjnej i szczegółów mediów."

#: /1080i/SkinSettings.xml
msgctxt "#31650"
msgid "This category contains the settings for the video OSD, seekbar and background video."
msgstr "Ta sekcja zawiera ustawienia OSD, paska postępu i odtwarzania wideo w tle."

#: /1080i/SkinSettings.xml
msgctxt "#31651"
msgid "This category contains the settings for seasonal themes and their effects."
msgstr "Ta sekcja zawiera ustawienia motywów sezonowych i ich efektów."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31653"
msgid "Open the editor to customise the home menu shortcuts and the widgets shown for each item."
msgstr "Dostosuj skróty menu głównego i przypisane do nich widżety."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31654"
msgid "When enabled, the first widget is focused when the home screen loads instead of the menu."
msgstr "Po starcie skina ustaw fokus na sekcji „Wyróżnione” lub pierwszym widżecie zamiast na menu."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31655"
msgid "Select whether the home menu is shown along the top of the screen or down the side."
msgstr "Wybierz położenie menu głównego: u góry lub z boku ekranu."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31656"
msgid "Select whether the items in the top menu are shown as text or icons."
msgstr "Wyświetlaj pozycje górnego menu jako tekst lub ikony."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31657"
msgid "Select what is shown in the header above the top menu: the date, the profile, or nothing."
msgstr "Wybierz zawartość nagłówka nad górnym menu: datę, profil lub nic."

#: /1080i/SkinSettings.xml
msgctxt "#31658"
msgid "Select whether pressing up on the top menu opens the submenu or the options menu."
msgstr "Wybierz działanie przy nawigacji w górę z górnego menu."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31659"
msgid "When enabled, the spotlight slides down and dims while the top menu is shown."
msgstr "Zsuń i przyciemnij sekcję „Wyróżnione”, gdy górne menu jest widoczne."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31660"
msgid "Select whether the spotlight button opens the information dialog or the spotlight menu."
msgstr "Wybierz działanie przycisku w sekcji „Wyróżnione”."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31661"
msgid "Select a preset colour scheme for highlights, backgrounds and dialogs."
msgstr "Wybierz schemat kolorów podświetlenia, tła i okien dialogowych."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31662"
msgid "Choose the colours used for focus highlights and selected text."
msgstr "Wybierz kolory podświetlenia i zaznaczonego tekstu."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31663"
msgid "Choose the colour and image used for the window background."
msgstr "Wybierz kolor lub obraz tła interfejsu."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31664"
msgid "Choose the colour and image used for the dialog background."
msgstr "Wybierz kolor lub obraz tła okien dialogowych."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31665"
msgid "Choose the image shown on the splash screen while the skin starts."
msgstr "Wybierz obraz powitalny widoczny podczas uruchamiania skina."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31666"
msgid "Configure the blurred artwork shown in the background of windows."
msgstr "Dostosuj rozmycie grafik w tle i rozmiar FlixArt."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31667"
msgid "Select the background shown for genres, studios and people that have no artwork of their own."
msgstr "Wybierz styl tła zastępczego dla gatunków, wytwórni i osób bez własnych grafik."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31668"
msgid "Select whether focused items are highlighted with a solid fill or an outline. The skin reloads to apply the change."
msgstr "Wybierz podświetlenie aktywnych elementów: wypełnienie lub obrys. Zmiana przeładuje skin."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31669"
msgid "Select whether rating icons are shown in colour or monochrome."
msgstr "Wybierz styl logotypów źródeł ocen."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31670"
msgid "Choose which viewtypes are available for each type of content."
msgstr "Wybierz dostępne typy widoków dla każdego rodzaju treści."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31671"
msgid "Select whether list views show simple or detailed text labels."
msgstr "Wybierz proste lub szczegółowe etykiety w widoku listy."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31672"
msgid "Choose which status indicators are shown on items."
msgstr "Wybierz wskaźniki stanu widoczne na pozycjach."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31673"
msgid "Choose the widgets shown in the video OSD."
msgstr "Wybierz widżety wyświetlane w OSD wideo."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31674"
msgid "Choose the widgets shown in the information dialog."
msgstr "Wybierz widżety wyświetlane w oknie informacji."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31675"
msgid "Choose the buttons shown in the information dialog."
msgstr "Wybierz przyciski wyświetlane w oknie informacji."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31676"
msgid "Show the currently playing item in the footer."
msgstr "Pokaż odtwarzaną pozycję w stopce."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31677"
msgid "Show the studio logo of the focused item in the footer."
msgstr "Pokaż logo wytwórni w stopce."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31678"
msgid "Show the current weather conditions in the header."
msgstr "Pokaż bieżącą pogodę w nagłówku."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31679"
msgid "Show the tray of quick action buttons in the context menu."
msgstr "Pokaż zasobnik szybkich akcji w menu kontekstowym."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31680"
msgid "Show the artwork of the focused item in the context menu."
msgstr "Pokaż grafikę aktywnej pozycji w menu kontekstowym."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31681"
msgid "Set how often widgets with autoscroll enabled move to the next item."
msgstr "Ustaw, co ile sekund widżety z autoprzewijaniem przechodzą do następnej pozycji."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31682"
msgid "When enabled, widgets with a limited number of items end with a Show more item that opens the full folder."
msgstr "Pokaż pozycję „Więcej” jako ostatni element w widżetach z limitem pozycji. Otwiera ona pełną listę."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31683"
msgid "Select whether widgets with no items show a placeholder or are hidden. Hiding empty widgets can cause positioning issues and reduce performance."
msgstr "Ustaw widoczność pustych widżetów. Ich ukrywanie może zaburzać układ i obniżać wydajność."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31684"
msgid "Cycle through the extra fanart of the focused item in the background."
msgstr "Automatycznie zmieniaj fanarty aktywnej pozycji w tle."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31685"
msgid "Select whether pressing back in a media window returns to the previous window or to the parent folder."
msgstr "Wybierz działanie przycisku „Wstecz” podczas przeglądania mediów."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31686"
msgid "Select whether the scrollbar jumps by letter when content is sorted alphabetically, or by page."
msgstr "Wybierz sposób przewijania: stronami lub według pierwszej litery przy sortowaniu alfabetycznym."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31687"
msgid "Use labels in place of textboxes for long text. This improves performance on Omega but the text will not scroll."
msgstr "Zastąp pola tekstowe etykietami. Poprawia to wydajność w Kodi Omega, ale tekst nie będzie przewijany."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31688"
msgid "Automatically scroll long text in textboxes, such as plots."
msgstr "Przewijaj automatycznie długi tekst w polach tekstowych."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31689"
msgid "Automatically scroll labels that are too long to fit."
msgstr "Przewijaj automatycznie długi tekst w etykietach."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31690"
msgid "Set the number of seconds before the video OSD closes automatically."
msgstr "Ustaw, po ilu sekundach OSD wideo ma się automatycznie ukryć."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31691"
msgid "Select whether the seekbar stays visible, shows information, or hides after playback has been paused for a while."
msgstr "Wybierz działanie paska postępu podczas pauzy."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31692"
msgid "Set how long playback must be paused before the seekbar behaviour is applied."
msgstr "Ustaw, po ilu sekundach pauzy ma nastąpić wybrane działanie."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31693"
msgid "Select which times are shown on either side of the seekbar."
msgstr "Wybierz wskazania czasu po obu stronach paska postępu."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31694"
msgid "Show the currently playing video in the background of the interface."
msgstr "Pokaż odtwarzane wideo w tle interfejsu."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31695"
msgid "Enable the TMDbHelper service, which provides extra details, ratings and artwork for the focused item."
msgstr "Włącz usługę TMDbHelper, która dostarcza dodatkowe informacje, oceny i grafiki dla aktywnej pozycji."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31696"
msgid "Choose which ratings are shown for movies."
msgstr "Wybierz źródła ocen filmów."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31697"
msgid "Choose which ratings are shown for TV shows."
msgstr "Wybierz źródła ocen seriali."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31698"
msgid "Select the detail shown above the plot for movies: tagline, genre, director, or nothing."
msgstr "Wybierz, co pokazać nad opisem filmu."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31699"
msgid "Select the detail shown above the plot for TV shows: tagline, genre, episodes, or nothing."
msgstr "Wybierz, co pokazać nad opisem serialu."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31700"
msgid "Show the rating as stars in the item information."
msgstr "Pokaż ocenę gwiazdkową w szczegółach pozycji."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31701"
msgid "Show the number of audio channels in the item information."
msgstr "Pokaż liczbę kanałów dźwięku w szczegółach pozycji."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31702"
msgid "Show the HDR type in the item information."
msgstr "Pokaż typ HDR w szczegółach pozycji."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31703"
msgid "Select the size of the mouse pointer. The skin reloads to apply the change."
msgstr "Wybierz rozmiar kursora. Skin zostanie przeładowany."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31704"
msgid "Keep the splash screen visible until the home screen widgets have loaded."
msgstr "Wyświetlaj ekran powitalny do czasu załadowania widżetów."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31705"
msgid "Load hub widgets in the background during startup so that hubs open faster."
msgstr "Przyspiesz otwieranie hubów, ładując widżety w tle przy starcie."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31706"
msgid "Allow each skin user to have their own shortcut and widget configuration, like a lightweight profile."
msgstr "Używaj osobnych skrótów i widżetów dla każdego profilu skina."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31707"
msgid "Show the skin user selection screen each time the skin starts."
msgstr "Pokaż ekran wyboru profilu przy każdym uruchomieniu skina."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31708"
msgid "Colour the programmes in the EPG grid by genre."
msgstr "Koloruj programy w siatce EPG według gatunków."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31709"
msgid "Use TMDbHelper to look up extra details and artwork for PVR programmes."
msgstr "Używaj TMDbHelper do pobierania dodatkowych informacji i grafik programów PVR."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31710"
msgid "Decorate the interface with seasonal themes during the dates listed for each theme."
msgstr "Wyświetlaj motywy sezonowe w podanych okresach."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31711"
msgid "Select the style of the Christmas theme, shown from Dec 7 to Jan 7, or turn it off."
msgstr "Wybierz styl motywu bożonarodzeniowego (7 grudnia – 7 stycznia)."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31712"
msgid "Show the Summer Breeze theme from Jun 21 to Aug 15."
msgstr "Włącz motyw „Letnia Bryza” (21 czerwca – 15 sierpnia)."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31713"
msgid "Show the Halloween Spook theme from Oct 1 to Nov 1."
msgstr "Włącz motyw „Halloweenowy Duch” (1 października – 1 listopada)."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31714"
msgid "Show the seasonal overlay on top of the background."
msgstr "Wyświetlaj sezonową nakładkę tła (np. szron)."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31715"
msgid "Show the looping seasonal animation in the background."
msgstr "Wyświetlaj sezonową animację tła (np. śnieg)."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31716"
msgid "Show seasonal animations that occasionally fly across the screen."
msgstr "Wyświetlaj cykliczne przeloty postaci sezonowych (np. Mikołaja)."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31717"
msgid "Select how many seasonal props fall down the screen."
msgstr "Wybierz gęstość spadających dekoracji sezonowych (np. pierniczków)."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31718"
msgid "Reset all skin settings to their default values. This cannot be undone."
msgstr "Przywróć domyślne ustawienia skina. Tej operacji nie można cofnąć."

#: /1080i/Custom_1115_Window_Shortcuts.xml
msgctxt "#31719"
msgid "This category contains the settings for the search hub layout, widgets and discover lists."
msgstr "Ta sekcja zawiera ustawienia układu i widżetów wyszukiwarki oraz sekcji „Odkrywaj”."

#: /1080i/Custom_1115_Window_Shortcuts.xml
msgctxt "#31720"
msgid "This category contains the settings for the shortcut, submenu and widgets of this hub."
msgstr "Ta sekcja zawiera ustawienia skrótu, podmenu i widżetów hubu."

#: /1080i/Custom_1115_Window_Shortcuts.xml
msgctxt "#31721"
msgid "This category contains the settings for the options menu tiles, power menu and tray."
msgstr "Ta sekcja zawiera ustawienia menu opcji: kafelków, skrótów i zasobnika."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31722"
msgid "Select how the widgets in the search hub are laid out."
msgstr "Wybierz układ widżetów wyszukiwarki."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31723"
msgid "Choose the widgets shown in the search hub."
msgstr "Dostosuj widżety wyszukiwarki."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31724"
msgid "Show the discover lists in the search hub."
msgstr "Pokaż sekcję „Odkrywaj” w wyszukiwarce."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31725"
msgid "Include the movie decades list in discover."
msgstr "Pokaż kategorię „Dekady” w sekcji „Odkrywaj”."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31726"
msgid "Include the movie keywords list in discover."
msgstr "Pokaż kategorię „Słowa kluczowe” w sekcji „Odkrywaj”."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31727"
msgid "Include MDbList lists in discover."
msgstr "Pokaż listy MDbList w sekcji „Odkrywaj”."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31728"
msgid "Select the type of hub: custom, next aired, Live TV, or add-ons."
msgstr "Wybierz typ hubu."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31729"
msgid "Configure the label, icon and path of the menu shortcut for this hub."
msgstr "Dostosuj skrót w menu: etykietę, ikonę i ścieżkę."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31730"
msgid "Customise the submenu items shown for this hub."
msgstr "Dostosuj podmenu hubu."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31731"
msgid "Select how the widgets in this hub are laid out."
msgstr "Wybierz układ widżetów hubu."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31732"
msgid "Configure the spotlight shown at the top of this hub."
msgstr "Dostosuj sekcję „Wyróżnione”."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31733"
msgid "Choose the widgets shown in this hub."
msgstr "Dostosuj widżety hubu."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31734"
msgid "Select whether the next aired calendar uses your library or Trakt."
msgstr "Wybierz źródło kalendarza premier."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31735"
msgid "Select whether channels in this hub are shown as square or landscape tiles."
msgstr "Wybierz styl kafelków kanałów."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31736"
msgid "Show the search or last played section in this hub, depending on the layout."
msgstr "Pokaż ostatnio odtwarzane kanały, a w wybranych układach także skrót do wyszukiwania."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31737"
msgid "Show the channels section in this hub."
msgstr "Pokaż sekcję kanałów w hubie."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31738"
msgid "Show the channel groups section in this hub."
msgstr "Pokaż sekcję grup kanałów w hubie."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31739"
msgid "Show the recordings section in this hub."
msgstr "Pokaż sekcję nagrań w hubie."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31740"
msgid "Show video add-ons in this hub."
msgstr "Pokaż dodatki wideo w hubie."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31741"
msgid "Show music add-ons in this hub."
msgstr "Pokaż dodatki muzyczne w hubie."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31742"
msgid "Show picture add-ons in this hub."
msgstr "Pokaż dodatki z kategorii „Obrazy” w hubie."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31743"
msgid "Show program add-ons in this hub."
msgstr "Pokaż dodatki z kategorii „Programy” w hubie."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31744"
msgid "Show game add-ons in this hub."
msgstr "Pokaż dodatki do gier w hubie."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31745"
msgid "Select how many tiles are shown in the options menu."
msgstr "Wybierz liczbę kafelków w menu opcji."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31746"
msgid "Select what this tile shows. Choose Custom to set your own shortcut."
msgstr "Wybierz zawartość kafelka. „Własny” pozwala przypisać dowolny skrót."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31747"
msgid "Choose the shortcut opened by this custom tile."
msgstr "Przypisz skrót do kafelka."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31748"
msgid "Set the label shown on this custom tile."
msgstr "Ustaw etykietę kafelka."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31749"
msgid "Choose the icon shown on this custom tile."
msgstr "Wybierz ikonę kafelka."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31750"
msgid "Customise the items in the power menu."
msgstr "Dostosuj skróty w menu opcji."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31751"
msgid "Customise the buttons in the tray of the options menu."
msgstr "Dostosuj zasobnik w menu opcji."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31752"
msgid "Setup wizard"
msgstr "Kreator ustawień"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31753"
msgid "Run the setup wizard to choose the home layout, widgets, colours and backgrounds."
msgstr "Uruchom kreator ustawień ekranu głównego, widżetów, kolorów i tła."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31754"
msgid "Welcome to Arctic Fuse 3"
msgstr "Witaj w Arctic Fuse 3"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31755"
msgid "Choose a recommended setup to get started straight away, or use the steps on the left to set things up yourself. You can change any of these later in Skin settings."
msgstr "Wybierz zalecane ustawienia lub dostosuj skin, korzystając z menu po lewej. Konfigurację możesz później zmienić w ustawieniach skina."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31756"
msgid "Use recommended defaults (library)"
msgstr "Zalecane ustawienia (biblioteka)"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31757"
msgid "Skip setup"
msgstr "Pomiń konfigurację"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31758"
msgid "Home layout"
msgstr "Ekran główny"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31759"
msgid "Choose how the main menu is arranged and what is shown at the top of Home."
msgstr "Wybierz układ menu głównego i zawartość nagłówka."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31760"
msgid "Replace the Home widgets with a ready-made set. Kodi asks before your current widgets are overwritten. Customise them later in Skin settings."
msgstr "Wybierz gotowy zestaw widżetów ekranu głównego. Po potwierdzeniu zastąpi on obecne widżety. Później możesz je dostosować w ustawieniach skina."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31761"
msgid "My library"
msgstr "Biblioteka"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31762"
msgid "Discover"
msgstr "Odkrywaj"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31763"
msgid "Minimal"
msgstr "Minimalny"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31764"
msgid "In progress, new and recent items from your library"
msgstr "Rozpoczęte, nowe i ostatnio oglądane z biblioteki"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31765"
msgid "Your library plus trending items from TMDb"
msgstr "Biblioteka i trendy z TMDb"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31766"
msgid "Continue watching only"
msgstr "Tylko rozpoczęte"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31767"
msgid "Colours"
msgstr "Kolory"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31768"
msgid "A colour scheme sets the highlight colour, window background and dialog background together. Adjust each one afterwards if you like."
msgstr "Schemat kolorów dobiera podświetlenie oraz tła interfejsu i okien dialogowych. Każdy z tych elementów możesz później zmienić osobno."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31769"
msgid "Backgrounds"
msgstr "Tła"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31770"
msgid "Choose the window and dialog backgrounds and how artwork backgrounds are blurred."
msgstr "Wybierz tła interfejsu i okien dialogowych oraz ustaw rozmycie grafik."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31771"
msgid "Finish"
msgstr "Zakończ"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31772"
msgid "Select a choice to go back to that step. Select Finish on the left to save, rebuild the widgets and reload the skin."
msgstr "Wybierz etap, by wrócić do jego ustawień. „Zakończ” po lewej zastosuje zmiany, odświeży widżety i przeładuje skin."

