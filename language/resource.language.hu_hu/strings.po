#: /1080i/SkinSettings.xml
msgctxt "#31644"
msgid "This category contains the settings for the home menu, spotlight, startup and skin users."
msgstr "Ez a kategória a főmenü, a kiemelt elem, az indítás és a felszín felhasználók beállításait tartalmazza."

#: /1080i/SkinSettings.xml
msgctxt "#31645"
msgid "This category contains the settings for the colour scheme and backgrounds."
msgstr "Ez a kategória a színséma és a hátterek beállításait tartalmazza."

#: /1080i/SkinSettings.xml
msgctxt "#31646"
msgid "This category contains the settings for the header, footer, context menu, text and mouse pointer."
msgstr "Ez a kategória a fejléc, a lábléc, a helyi menü, a szöveg és az egérmutató beállításait tartalmazza."

#: /1080i/SkinSettings.xml
msgctxt "#31647"
msgid "This category contains the settings for viewtypes, indicators, navigation and Live TV."
msgstr "Ez a kategória a nézettípusok, a jelzők, a navigáció és az élő TV beállításait tartalmazza."

#: /1080i/SkinSettings.xml
msgctxt "#31648"
msgid "This category contains the settings for widget behaviour and the information dialog widgets and buttons."
msgstr "Ez a kategória a widgetek viselkedésének, valamint az információs ablak widgetjeinek és gombjainak beállításait tartalmazza."

#: /1080i/SkinSettings.xml
msgctxt "#31649"
msgid "This category contains the settings for TMDbHelper, ratings, plotlines and other media details."
msgstr "Ez a kategória a TMDbHelper, az értékelések, a cselekménysorok és egyéb médiaadatok beállításait tartalmazza."

#: /1080i/SkinSettings.xml
msgctxt "#31650"
msgid "This category contains the settings for the video OSD, seekbar and background video."
msgstr "Ez a kategória a videó OSD, a keresősáv és a háttérvideó beállításait tartalmazza."

#: /1080i/SkinSettings.xml
msgctxt "#31651"
msgid "This category contains the settings for seasonal themes and their effects."
msgstr "Ez a kategória a szezonális témák és hatásaik beállításait tartalmazza."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31653"
msgid "Open the editor to customise the home menu shortcuts and the widgets shown for each item."
msgstr "Megnyitja a szerkesztőt a főmenü parancsikonjainak és az egyes elemekhez megjelenő widgeteknek a testreszabásához."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31654"
msgid "When enabled, the first widget is focused when the home screen loads instead of the menu."
msgstr "Ha engedélyezve van, a főképernyő betöltésekor a menü helyett az első widget kap fókuszt."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31655"
msgid "Select whether the home menu is shown along the top of the screen or down the side."
msgstr "Válaszd ki, hogy a főmenü a képernyő tetején vagy oldalán jelenjen meg."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31656"
msgid "Select whether the items in the top menu are shown as text or icons."
msgstr "Válaszd ki, hogy a felső menü elemei szövegként vagy ikonként jelenjenek meg."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31657"
msgid "Select what is shown in the header above the top menu: the date, the profile, or nothing."
msgstr "Válaszd ki, mi látszik a felső menü feletti fejlécben: a dátum, a profil, vagy semmi."

#: /1080i/SkinSettings.xml
msgctxt "#31658"
msgid "Select whether pressing up on the top menu opens the submenu or the options menu."
msgstr "Válaszd ki, hogy a felső menün a fel gomb az almenüt vagy a beállítások menüt nyissa meg."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31659"
msgid "When enabled, the spotlight slides down and dims while the top menu is shown."
msgstr "Ha engedélyezve van, a kiemelt elem lecsúszik és elhalványul, amíg a felső menü látszik."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31660"
msgid "Select whether the spotlight button opens the information dialog or the spotlight menu."
msgstr "Válaszd ki, hogy a kiemelt gomb az információs ablakot vagy a kiemelt menüt nyissa meg."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31661"
msgid "Select a preset colour scheme for highlights, backgrounds and dialogs."
msgstr "Válassz előre beállított színsémát a kiemelésekhez, hátterekhez és párbeszédablakokhoz."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31665"
msgid "Choose the image shown on the splash screen while the skin starts."
msgstr "Válaszd ki a felszín indulásakor megjelenő nyitókép hátterét."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31667"
msgid "Select the background shown for genres, studios and people that have no artwork of their own."
msgstr "Válaszd ki a saját képpel nem rendelkező műfajok, stúdiók és személyek háttérképét."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31669"
msgid "Select whether rating icons are shown in colour or monochrome."
msgstr "Válaszd ki, hogy az értékelés ikonjai színesek vagy egyszínűek legyenek."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31670"
msgid "Choose which viewtypes are available for each type of content."
msgstr "Válaszd ki, mely nézettípusok legyenek elérhetők az egyes tartalomtípusokhoz."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31671"
msgid "Select whether list views show simple or detailed text labels."
msgstr "Válaszd ki, hogy a listanézetek egyszerű vagy részletes szövegcímkéket mutassanak."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31672"
msgid "Choose which status indicators are shown on items."
msgstr "Válaszd ki, mely állapotjelzők jelenjenek meg az elemeken."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31673"
msgid "Choose the widgets shown in the video OSD."
msgstr "Válaszd ki, mely widgetek jelenjenek meg a videó OSD-n."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31674"
msgid "Choose the widgets shown in the information dialog."
msgstr "Válaszd ki, mely widgetek jelenjenek meg az információs ablakban."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31675"
msgid "Choose the buttons shown in the information dialog."
msgstr "Válaszd ki, mely gombok jelenjenek meg az információs ablakban."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31676"
msgid "Show the currently playing item in the footer."
msgstr "A jelenleg lejátszott elem megjelenítése a láblécben."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31677"
msgid "Show the studio logo of the focused item in the footer."
msgstr "A fókuszban lévő elem stúdiólogójának megjelenítése a láblécben."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31678"
msgid "Show the current weather conditions in the header."
msgstr "Az aktuális időjárás megjelenítése a fejlécben."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31679"
msgid "Show the tray of quick action buttons in the context menu."
msgstr "A gyorsműveleti gombok sávjának megjelenítése a helyi menüben."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31680"
msgid "Show the artwork of the focused item in the context menu."
msgstr "A fókuszban lévő elem képének megjelenítése a helyi menüben."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31681"
msgid "Set how often widgets with autoscroll enabled move to the next item."
msgstr "Megadja, milyen gyakran lépnek a következő elemre az automatikus görgetésű widgetek."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31682"
msgid "When enabled, widgets with a limited number of items end with a Show more item that opens the full folder."
msgstr "Ha engedélyezve van, a korlátozott elemszámú widgetek végén egy Továbbiak elem nyitja meg a teljes mappát."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31683"
msgid "Select whether widgets with no items show a placeholder or are hidden. Hiding empty widgets can cause positioning issues and reduce performance."
msgstr "Válaszd ki, hogy az elemek nélküli widgetek helyőrzőt mutassanak vagy el legyenek rejtve. Az üres widgetek elrejtése elhelyezési problémákat és teljesítménycsökkenést okozhat."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31684"
msgid "Cycle through the extra fanart of the focused item in the background."
msgstr "A fókuszban lévő elem további háttérképeinek váltogatása a háttérben."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31685"
msgid "Select whether pressing back in a media window returns to the previous window or to the parent folder."
msgstr "Válaszd ki, hogy a vissza gomb a médiaablakban az előző ablakra vagy a szülőmappába lépjen."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31686"
msgid "Select whether the scrollbar jumps by letter when content is sorted alphabetically, or by page."
msgstr "Válaszd ki, hogy a görgetősáv betűnként ugorjon, ha a tartalom ábécé szerint rendezett, vagy oldalanként."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31687"
msgid "Use labels in place of textboxes for long text. This improves performance on Omega but the text will not scroll."
msgstr "Hosszú szövegeknél szövegdoboz helyett címkék használata. Ez Omegán javítja a teljesítményt, de a szöveg nem görgethető."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31688"
msgid "Automatically scroll long text in textboxes, such as plots."
msgstr "A hosszú szövegek, például a tartalom automatikus görgetése a szövegdobozokban."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31689"
msgid "Automatically scroll labels that are too long to fit."
msgstr "A túl hosszú címkék automatikus görgetése."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31690"
msgid "Set the number of seconds before the video OSD closes automatically."
msgstr "Megadja, hány másodperc után záródjon be automatikusan a videó OSD."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31691"
msgid "Select whether the seekbar stays visible, shows information, or hides after playback has been paused for a while."
msgstr "Válaszd ki, hogy a keresősáv látható maradjon, információt mutasson, vagy elrejtőzzön a lejátszás szüneteltetése után egy idővel."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31692"
msgid "Set how long playback must be paused before the seekbar behaviour is applied."
msgstr "Megadja, mennyi ideig kell szünetelnie a lejátszásnak, hogy a keresősáv beállítása érvénybe lépjen."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31693"
msgid "Select which times are shown on either side of the seekbar."
msgstr "Válaszd ki, mely időpontok jelenjenek meg a keresősáv két oldalán."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31694"
msgid "Show the currently playing video in the background of the interface."
msgstr "A jelenleg lejátszott videó megjelenítése a felszín hátterében."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31695"
msgid "Enable the TMDbHelper service, which provides extra details, ratings and artwork for the focused item."
msgstr "A TMDbHelper szolgáltatás engedélyezése, amely extra adatokat, értékeléseket és képeket biztosít a fókuszban lévő elemhez."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31696"
msgid "Choose which ratings are shown for movies."
msgstr "Válaszd ki, mely értékelések jelenjenek meg a filmeknél."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31697"
msgid "Choose which ratings are shown for TV shows."
msgstr "Válaszd ki, mely értékelések jelenjenek meg a sorozatoknál."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31698"
msgid "Select the detail shown above the plot for movies: tagline, genre, director, or nothing."
msgstr "Válaszd ki a filmeknél a tartalom felett megjelenő adatot: jelmondat, műfaj, rendező, vagy semmi."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31699"
msgid "Select the detail shown above the plot for TV shows: tagline, genre, episodes, or nothing."
msgstr "Válaszd ki a sorozatoknál a cselekmény felett megjelenő adatot: jelmondat műfaj, epizódok, vagy semmi."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31700"
msgid "Show the rating as stars in the item information."
msgstr "Az értékelés megjelenítése csillagokkal az elem adatai között."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31701"
msgid "Show the number of audio channels in the item information."
msgstr "A hangcsatornák számának megjelenítése az elem adatai között."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31702"
msgid "Show the HDR type in the item information."
msgstr "A HDR típus megjelenítése az elem adatai között."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31703"
msgid "Select the size of the mouse pointer. The skin reloads to apply the change."
msgstr "Válaszd ki az egérmutató méretét. A módosítás érvényesítéséhez a felszín újratölt."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31704"
msgid "Keep the splash screen visible until the home screen widgets have loaded."
msgstr "A nyitókép látható marad, amíg a főképernyő widgetjei be nem töltődnek."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31705"
msgid "Load hub widgets in the background during startup so that hubs open faster."
msgstr "A csomópont widgetek betöltése a háttérben indításkor, hogy a csomópontok gyorsabban nyíljanak meg."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31706"
msgid "Allow each skin user to have their own shortcut and widget configuration, like a lightweight profile."
msgstr "Lehetővé teszi, hogy minden felszínfelhasználónak saját parancsikon- és widget-beállítása legyen, mint egy könnyű profilnál."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31707"
msgid "Show the skin user selection screen each time the skin starts."
msgstr "A felszínfelhasználó-választó képernyő megjelenítése a felszín minden indításakor."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31708"
msgid "Colour the programmes in the EPG grid by genre."
msgstr "Az EPG rács műsorainak színezése műfaj szerint."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31709"
msgid "Use TMDbHelper to look up extra details and artwork for PVR programmes."
msgstr "A TMDbHelper használata extra adatok és képek lekéréséhez a PVR műsorokhoz."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31710"
msgid "Decorate the interface with seasonal themes during the dates listed for each theme."
msgstr "A felület díszítése szezonális témákkal az egyes témáknál megadott időszakokban."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31711"
msgid "Select the style of the Christmas theme, shown from Dec 7 to Jan 7, or turn it off."
msgstr "Válaszd ki a karácsonyi téma stílusát, amely dec. 7. és jan. 7. között látszik, vagy kapcsold ki."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31712"
msgid "Show the Summer Breeze theme from Jun 21 to Aug 15."
msgstr "A Nyári szellő téma megjelenítése jún. 21. és aug. 15. között."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31713"
msgid "Show the Halloween Spook theme from Oct 1 to Nov 1."
msgstr "A Halloween téma megjelenítése okt. 1. és nov. 1. között."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31714"
msgid "Show the seasonal overlay on top of the background."
msgstr "A szezonális réteg megjelenítése a háttér felett."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31715"
msgid "Show the looping seasonal animation in the background."
msgstr "A szezonális ismétlődő animáció megjelenítése a háttérben."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31716"
msgid "Show seasonal animations that occasionally fly across the screen."
msgstr "Időnként átrepülő szezonális animációk megjelenítése a képernyőn."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31717"
msgid "Select how many seasonal props fall down the screen."
msgstr "Válaszd ki, hány szezonális dísz hulljon le a képernyőn."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31718"
msgid "Reset all skin settings to their default values. This cannot be undone."
msgstr "Az összes felszínbeállítás visszaállítása az alapértelmezett értékre. Ez nem vonható vissza."

#: /1080i/Custom_1115_Window_Shortcuts.xml
msgctxt "#31719"
msgid "This category contains the settings for the search hub layout, widgets and discover lists."
msgstr "Ez a kategória a keresési csomópont elrendezésének, widgetjeinek és a felfedezés listáinak beállításait tartalmazza."

#: /1080i/Custom_1115_Window_Shortcuts.xml
msgctxt "#31720"
msgid "This category contains the settings for the shortcut, submenu and widgets of this hub."
msgstr "Ez a kategória ennek a csomópontnak a parancsikon-, almenü- és widget-beállításait tartalmazza."

#: /1080i/Custom_1115_Window_Shortcuts.xml
msgctxt "#31721"
msgid "This category contains the settings for the options menu tiles, power menu and tray."
msgstr "Ez a kategória a beállítások menü csempéinek, a kikapcsolás menünek és a sávnak a beállításait tartalmazza."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31722"
msgid "Select how the widgets in the search hub are laid out."
msgstr "Válaszd ki, hogyan legyenek elrendezve a keresési csomópont widgetjei."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31723"
msgid "Choose the widgets shown in the search hub."
msgstr "Válaszd ki, mely widgetek jelenjenek meg a keresési csomópontban."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31724"
msgid "Show the discover lists in the search hub."
msgstr "A felfedezés listáinak megjelenítése a keresési csomópontban."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31725"
msgid "Include the movie decades list in discover."
msgstr "A filmes évtizedek listájának felvétele a felfedezésbe."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31726"
msgid "Include the movie keywords list in discover."
msgstr "A filmes kulcsszavak listájának felvétele a felfedezésbe."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31727"
msgid "Include MDbList lists in discover."
msgstr "Az MDbList listák felvétele a felfedezésbe."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31728"
msgid "Select the type of hub: custom, next aired, Live TV, or add-ons."
msgstr "Válaszd ki a csomópont típusát: egyéni, következő adás, élő TV, vagy kiegészítők."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31730"
msgid "Customise the submenu items shown for this hub."
msgstr "A csomópont almenüelemeinek testreszabása."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31731"
msgid "Select how the widgets in this hub are laid out."
msgstr "Válaszd ki, hogyan legyenek elrendezve a csomópont widgetjei."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31732"
msgid "Configure the spotlight shown at the top of this hub."
msgstr "A csomópont tetején megjelenő kiemelt elem beállítása."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31733"
msgid "Choose the widgets shown in this hub."
msgstr "Válaszd ki, mely widgetek jelenjenek meg ebben a csomópontban."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31734"
msgid "Select whether the next aired calendar uses your library or Trakt."
msgstr "Válaszd ki, hogy a következő adások naptára a könyvtáradat vagy a Trakt-ot használja."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31735"
msgid "Select whether channels in this hub are shown as square or landscape tiles."
msgstr "Válaszd ki, hogy a csomópont csatornái négyzet vagy fekvő csempeként jelenjenek meg."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31736"
msgid "Show the search or last played section in this hub, depending on the layout."
msgstr "A keresés vagy az utoljára lejátszott rész megjelenítése ebben a csomópontban, az elrendezéstől függően."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31737"
msgid "Show the channels section in this hub."
msgstr "A csatornák szakaszának megjelenítése ebben a csomópontban."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31738"
msgid "Show the channel groups section in this hub."
msgstr "A csatornacsoportok szakaszának megjelenítése ebben a csomópontban."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31739"
msgid "Show the recordings section in this hub."
msgstr "A felvételek szakaszának megjelenítése ebben a csomópontban."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31740"
msgid "Show video add-ons in this hub."
msgstr "A videó kiegészítők megjelenítése ebben a csomópontban."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31741"
msgid "Show music add-ons in this hub."
msgstr "A zenei kiegészítők megjelenítése ebben a csomópontban."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31742"
msgid "Show picture add-ons in this hub."
msgstr "A képkiegészítők megjelenítése ebben a csomópontban."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31743"
msgid "Show program add-ons in this hub."
msgstr "A program kiegészítők megjelenítése ebben a csomópontban."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31744"
msgid "Show game add-ons in this hub."
msgstr "A játék kiegészítők megjelenítése ebben a csomópontban."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31745"
msgid "Select how many tiles are shown in the options menu."
msgstr "Válaszd ki, hány csempe jelenjen meg a beállítások menüben."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31746"
msgid "Select what this tile shows. Choose Custom to set your own shortcut."
msgstr "Válaszd ki, mit mutat ez a csempe. Egyéni parancsikonhoz válaszd az Egyénit."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31747"
msgid "Choose the shortcut opened by this custom tile."
msgstr "Válaszd ki az egyéni csempe által megnyitott parancsikont."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31748"
msgid "Set the label shown on this custom tile."
msgstr "Add meg az egyéni csempén megjelenő címkét."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31749"
msgid "Choose the icon shown on this custom tile."
msgstr "Válaszd ki az egyéni csempén megjelenő ikont."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31750"
msgid "Customise the items in the power menu."
msgstr "A kikapcsolás menü elemeinek testreszabása."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31751"
msgid "Customise the buttons in the tray of the options menu."
msgstr "A beállítások menü sávjában lévő gombok testreszabása."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31752"
msgid "Setup wizard"
msgstr "Beállítási varázsló"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31753"
msgid "Run the setup wizard to choose the home layout, widgets, colours and backgrounds."
msgstr "A beállítási varázsló futtatása a főképernyő elrendezésének, a widgetek, a színek és a hátterek kiválasztásához."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31754"
msgid "Welcome to Arctic Fuse 3"
msgstr "Üdvözöl az Arctic Fuse 3"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31755"
msgid "Choose a recommended setup to get started straight away, or use the steps on the left to set things up yourself. You can change any of these later in Skin settings."
msgstr "Válassz ajánlott beállítást az azonnali induláshoz, vagy a bal oldali lépésekkel állítsd be magad. Később bármelyiket módosíthatod a Felszín beállításaiban."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31756"
msgid "Use recommended defaults (library)"
msgstr "Ajánlott alapértékek használata (könyvtár)"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31757"
msgid "Skip setup"
msgstr "Beállítás kihagyása"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31758"
msgid "Home layout"
msgstr "Főképernyő elrendezése"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31759"
msgid "Choose how the main menu is arranged and what is shown at the top of Home."
msgstr "Válaszd ki a főmenü elrendezését és azt, hogy mi látszik a Főoldal tetején."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31760"
msgid "Replace the Home widgets with a ready-made set. Kodi asks before your current widgets are overwritten. Customise them later in Skin settings."
msgstr "A Főoldal widgetjeinek cseréje egy kész készletre. A Kodi rákérdez, mielőtt felülírná a jelenlegi widgeteket. Később a Felszín beállításaiban testreszabhatod őket."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31761"
msgid "My library"
msgstr "Saját könyvtár"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31762"
msgid "Discover"
msgstr "Felfedezés"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31763"
msgid "Minimal"
msgstr "Minimális"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31764"
msgid "Movies, TV and music hubs with in progress, new and recent items from your library"
msgstr "Filmes, sorozat és zenei csomópontok folyamatban lévő, új és friss elemekkel a könyvtáradból"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31765"
msgid "Library hubs plus trending items and next aired from TMDb"
msgstr "Könyvtári csomópontok, valamint a TMDb népszerű elemei és következő adásai"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31766"
msgid "Continue watching on home with only the add-ons hub"
msgstr "Folytatás a főoldalon, csak a kiegészítők csomóponttal"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31767"
msgid "Colours"
msgstr "Színek"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31768"
msgid "A colour scheme sets the highlight colour, window background and dialog background together. Adjust each one afterwards if you like."
msgstr "A színséma egyszerre állítja be a kiemelés színét, az ablak hátterét és a párbeszédablak hátterét. Utána mindegyiket külön is módosíthatod."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31769"
msgid "Backgrounds"
msgstr "Hátterek"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31770"
msgid "Choose the window and dialog backgrounds and how artwork backgrounds are blurred."
msgstr "Válaszd ki az ablak- és párbeszédablak-hátteret, valamint a képháttérek elmosását."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31771"
msgid "Finish"
msgstr "Befejezés"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31772"
msgid "Select a choice to go back to that step. Select Finish on the left to save, rebuild the widgets and reload the skin."
msgstr "Válassz egy lehetőséget, hogy visszalépj arra a lépésre. A mentéshez, a widgetek újraépítéséhez és a felszín újratöltéséhez válaszd a bal oldali Befejezést."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31773"
msgid "Hide parent folder items"
msgstr "Szülőmappa elemeinek elrejtése"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31774"
msgid "Next"
msgstr "Következő"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31775"
msgid "Back"
msgstr "Vissza"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31776"
msgid "Exit setup"
msgstr "Kilépés a varázslóból"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31777"
msgid "Step"
msgstr "Lépés"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31779"
msgid "Welcome"
msgstr "Üdvözöljük"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31780"
msgid "Choose how to get started"
msgstr "Válaszd ki, hogyan kezdjünk"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31781"
msgid "How the main menu is arranged"
msgstr "A főmenü elrendezése"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31782"
msgid "A starting set of widgets for Home"
msgstr "Kiinduló widgetkészlet a Főoldalhoz"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31783"
msgid "Colour scheme and highlight colour"
msgstr "Színséma és kiemelés színe"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31784"
msgid "Window and dialog backgrounds"
msgstr "Ablak- és párbeszédablak-hátterek"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31785"
msgid "Review your choices"
msgstr "A választások áttekintése"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31786"
msgid "Top menu"
msgstr "Felső menü"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31787"
