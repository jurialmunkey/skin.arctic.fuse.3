msgstr "Szöveges menü felül"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31790"
msgid "Icon buttons across the top"
msgstr "Ikongombok felül"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31791"
msgid "Vertical menu on the left"
msgstr "Függőleges menü balra"

