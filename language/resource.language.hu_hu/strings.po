msgctxt "#31793"
msgid "Window background"
msgstr "Ablak háttere"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31794"
msgid "Menu style"
msgstr "Menü stílusa"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31796"
msgid "Use recommended defaults (TMDb Helper)"
msgstr "Ajánlott alapértékek használata (TMDb Helper)"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31797"
msgid "Default settings with movies, TV and music hubs and widgets from your library"
msgstr "Alapbeállítások filmes, sorozat és zenei csomópontokkal és widgetekkel a könyvtáradból"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31798"
msgid "Default settings with movies, TV and next aired hubs and widgets from TMDb"
msgstr "Alapbeállítások filmes, sorozat és következő adás csomópontokkal és widgetekkel a TMDb-ből"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31799"
msgid "Keep the current settings. Run this wizard again from Skin settings."
msgstr "A jelenlegi beállítások megtartása. A varázslót később újra futtathatod a Felszín beállításaiból."

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31800"
msgid "TMDb Helper"
msgstr "TMDb Helper"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31801"
msgid "Movies, TV and next aired hubs with trending, popular and new items from TMDb"
msgstr "Filmes, sorozat és következő adás csomópontok a TMDb népszerű, felkapott és új elemeivel"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31803"
msgid "Review"
msgstr "Áttekintés"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31802"
msgid "Home screen preset"
msgstr "Főképernyő előbeállítás"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31804"
msgid "A row for each widget"
msgstr "Minden widgethez egy sor"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31805"
msgid "One row with a selector to switch widgets"
msgstr "Egy sor, választóval a widgetek váltásához"

#: /1080i/Dialog_DialogSetupWizard.xml
msgctxt "#31806"
msgid "A grid of items with a selector to switch widgets"
msgstr "Elemrács, választóval a widgetek váltásához"

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31807"
msgid "Home"
msgstr "Főoldal"

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31808"
msgid "Views"
msgstr "Nézetek"

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31809"
