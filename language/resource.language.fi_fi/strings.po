msgstr "Määrittää näytetäänkö löydä-listat hakuvalikossa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31725"
msgid "Include the movie decades list in discover."
msgstr "Määrittää käytetäänkö elokuvien vuosikymmeniä löydä-toiminnossa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31726"
msgid "Include the movie keywords list in discover."
msgstr "Määrittää käytetäänkö elokuvien avainsanoja löydä-toiminnossa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31727"
msgid "Include MDbList lists in discover."
msgstr "Määrittää käytetäänkö MDbList-listoja löydä-toiminnossa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31728"
msgid "Select the type of hub: custom, next aired, Live TV, or add-ons."
msgstr "Määrittää hubin tyypin; mukautettu, next aired -kalenteri, televisio tai lisäosat."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31730"
msgid "Customise the submenu items shown for this hub."
msgstr "Määrittää tämän hubin alivalikon kohteet."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31731"
msgid "Select how the widgets in this hub are laid out."
msgstr "Määrittää tämän hubin widgetien asettelun."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31732"
msgid "Configure the spotlight shown at the top of this hub."
msgstr "Määrittää tämän hubin valokeilan sisällön."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31733"
msgid "Choose the widgets shown in this hub."
msgstr "Määrittää tämän hubin widgetien sisällön."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31734"
msgid "Select whether the next aired calendar uses your library or Trakt."
msgstr "Määrittää käyttääkö next aired -kalenteri mediakirjaston tietoja vai Trakt-palvelua."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31735"
msgid "Select whether channels in this hub are shown as square or landscape tiles."
msgstr "Määrittää onko tämän hubin kuvakkeet neliön vai suorakaiteen muotoisia."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31736"
msgid "Show the search or last played section in this hub, depending on the layout."
msgstr "Määrittää näytetäänkö tässä hubissa hakutoiminto vai viimeksi katsottujen lista, riippuen asettelusta."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31737"
msgid "Show the channels section in this hub."
msgstr "Määrittää näytetäänkö kanavalista tässä hubissa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31738"
msgid "Show the channel groups section in this hub."
msgstr "Määrittää näytetäänkö kanavaryhmät tässä hubissa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31739"
msgid "Show the recordings section in this hub."
msgstr "Määrittää näytetäänkö tallenteet tässä hubissa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31740"
msgid "Show video add-ons in this hub."
msgstr "Määrittää näytetäänkö videolisäosat tässä hubissa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31741"
msgid "Show music add-ons in this hub."
msgstr "Määrittää näytetäänkö musiikkilisäosat tässä hubissa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31742"
msgid "Show picture add-ons in this hub."
msgstr "Määrittää näytetäänkö kuvalisäosat tässä hubissa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31743"
msgid "Show program add-ons in this hub."
msgstr "Määrittää näytetäänkö ohjelmalisäosat tässä hubissa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31744"
msgid "Show game add-ons in this hub."
msgstr "Määrittää näytetäänkö pelilisäosat tässä hubissa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31745"
msgid "Select how many tiles are shown in the options menu."
msgstr "Määritää montako ruutua näytetään virtavalikossa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31746"
msgid "Select what this tile shows. Choose Custom to set your own shortcut."
msgstr "Määrittää mitä tässä ruudussa näkyy. Valitse Mukautettu määrittääksesi oman pikakuvakkeesi."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31747"
msgid "Choose the shortcut opened by this custom tile."
msgstr "Määrittää toiminnon, joka suoritetaan tästä mukautetusta ruudusta."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31748"
msgid "Set the label shown on this custom tile."
msgstr "Määrittää nimen tälle mukautetulle ruudulle."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31749"
msgid "Choose the icon shown on this custom tile."
msgstr "Määrittää kuvakkeen tälle mukautetulle ruudulle."

