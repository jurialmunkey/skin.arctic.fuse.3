#: /1080i/SkinSettings.xml
msgctxt "#31644"
msgid "This category contains the settings for the home menu, spotlight, startup and skin users."
msgstr "Tämä kategoria sisältää kotivalikkoon, valokeilaan, käynnistykseen ja käyttäjiin liittyviä asetuksia."

#: /1080i/SkinSettings.xml
msgctxt "#31645"
msgid "This category contains the settings for the colour scheme and backgrounds."
msgstr "Tämä kategoria sisältää käyttöliittymän väreihin ja taustakuviin liittyviä asetuksia."

#: /1080i/SkinSettings.xml
msgctxt "#31646"
msgid "This category contains the settings for the header, footer, context menu, text and mouse pointer."
msgstr "Tämä kategoria sisältää otsikkoriviin, alapalkkiin, sisältövalikkoon, teksteihin ja hiiren osoittimeen liittyviä asetuksia."

#: /1080i/SkinSettings.xml
msgctxt "#31647"
msgid "This category contains the settings for viewtypes, indicators, navigation and Live TV."
msgstr "Tämä kategoria sisältää näkymätyyppeihin, merkintöihin, navigointiin ja televisiolähetyksiin liittyviä asetuksia."

#: /1080i/SkinSettings.xml
msgctxt "#31648"
msgid "This category contains the settings for widget behaviour and the information dialog widgets and buttons."
msgstr "Tämä kategoria sisältää yleisiä widgetien asetuksia ja tietovalikossa näkyvien widgetien ja painikkeiden asetuksia."

#: /1080i/SkinSettings.xml
msgctxt "#31649"
msgid "This category contains the settings for TMDbHelper, ratings, plotlines and other media details."
msgstr "Tämä kategoria sisältää TMDbHelperiin, arvioihin, juoniriveihin ja muihin mediatietoihin liittyviä asetuksia."

#: /1080i/SkinSettings.xml
msgctxt "#31650"
msgid "This category contains the settings for the video OSD, seekbar and background video."
msgstr "Tämä kategoria sisältää videon kuvaruutuvalikkoon, hakupalkkiin ja taustavideoon liittyviä asetuksia."

#: /1080i/SkinSettings.xml
msgctxt "#31651"
msgid "This category contains the settings for seasonal themes and their effects."
msgstr "Tämä kategoria sisältää erikoisteemoihin ja niiden efekteihin liittyviä asetuksia."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31653"
msgid "Open the editor to customise the home menu shortcuts and the widgets shown for each item."
msgstr "Avaa editorin, jonka avulla voidaan muokata kotivalikon osioita ja niihin kuuluvia widgetejä."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31654"
msgid "When enabled, the first widget is focused when the home screen loads instead of the menu."
msgstr "Kun käytössä, kohdistaa valinnan automaattisesti ensimmäiseen widgetiin kotivalikon sijaan."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31655"
msgid "Select whether the home menu is shown along the top of the screen or down the side."
msgstr "Määrittää sijaitseeko kotivalikko ruudun yläreunassa vai sivussa."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31656"
msgid "Select whether the items in the top menu are shown as text or icons."
msgstr "Määrittää näytetäänkö kotivalikon osiot tekstinä vai kuvakkeina."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31657"
msgid "Select what is shown in the header above the top menu: the date, the profile, or nothing."
msgstr "Määrittää näytetäänkö otsikkorivillä päivämäärä, käyttäjäprofiili vai ei mitään."

#: /1080i/SkinSettings.xml
msgctxt "#31658"
msgid "Select whether pressing up on the top menu opens the submenu or the options menu."
msgstr "Määrittää avaako painallus ylöspäin kotivalikossa alivalikon vai asetusvalikon."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31659"
msgid "When enabled, the spotlight slides down and dims while the top menu is shown."
msgstr "Kun käytössä, kotivalikon ollessa näkyvissä, valokeila liukuu alaspäin ja himmenee."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31660"
msgid "Select whether the spotlight button opens the information dialog or the spotlight menu."
msgstr "Määrittää avaako valokeilan painike lisätietoruudun vai valokeilan valikon."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31661"
msgid "Select a preset colour scheme for highlights, backgrounds and dialogs."
msgstr "Määrittää väriteeman, joka vaikuttaa korostuksiin, taustakuviin ja valikoihin."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31665"
msgid "Choose the image shown on the splash screen while the skin starts."
msgstr "Määrittää taustakuvan, joka näkyy ruudulla ulkoasun latautuessa."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31667"
msgid "Select the background shown for genres, studios and people that have no artwork of their own."
msgstr "Määrittää taustakuvan, joka näkyy ruudulla silloin kun lajityypille, studiolle tai henkilölle ei löydy omaa kuvaa."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31669"
msgid "Select whether rating icons are shown in colour or monochrome."
msgstr "Määrittää käytetäänkö arvioille yksivärisiä vai monivärisiä kuvakkeita."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31670"
msgid "Choose which viewtypes are available for each type of content."
msgstr "Määrittää millainen näkymä on käytössä eri sisältötyypeille."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31671"
msgid "Select whether list views show simple or detailed text labels."
msgstr "Määrittää näkyykö listausnäkymissä yksinkertaiset vai yksityiskohtaiset tiedot."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31672"
msgid "Choose which status indicators are shown on items."
msgstr "Määrittää mitkä tilamerkinnät ovat käytössä."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31673"
msgid "Choose the widgets shown in the video OSD."
msgstr "Määrittää mitkä widgetit näytetään videon kuvaruutuvalikossa."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31674"
msgid "Choose the widgets shown in the information dialog."
msgstr "Määrittää mitkä widgetit näytetään lisätietoruudussa."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31675"
msgid "Choose the buttons shown in the information dialog."
msgstr "Määrittää mitkä painikkeet näytetään lisätietoruudussa."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31676"
msgid "Show the currently playing item in the footer."
msgstr "Määrittää näytetäänkö toistettavan kohteen nimi alanurkassa."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31677"
msgid "Show the studio logo of the focused item in the footer."
msgstr "Määrittää näytetäänkö valittuna olevan kohteen studiologo alanurkassa."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31678"
msgid "Show the current weather conditions in the header."
msgstr "Määrittää näytetäänkö nykyinen säätila ylänurkassa."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31679"
msgid "Show the tray of quick action buttons in the context menu."
msgstr "Määrittää näytetäänkö pikatoimintojen kuvakkeet sisältövalikon reunassa."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31680"
msgid "Show the artwork of the focused item in the context menu."
msgstr "Määrittää näytetäänkö valittuna olevan kohteen mediakuvitukset sisältövalikossa."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31681"
msgid "Set how often widgets with autoscroll enabled move to the next item."
msgstr "Määrittää kuinka nopeasti widgetit siirtyvät seuraavaan nimikkeeseen, jos automaattinen vieritys on käytössä."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31682"
msgid "When enabled, widgets with a limited number of items end with a Show more item that opens the full folder."
msgstr "Jos käytössä, lisätään widgetin loppuun painike, joka avaa koko kansion, jos widgetin kohteiden enimmäismäärää on rajoitettu."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31683"
msgid "Select whether widgets with no items show a placeholder or are hidden. Hiding empty widgets can cause positioning issues and reduce performance."
msgstr "Määrittää piilotetaanko tyhjät widgetit vai korvataanko ne paikkamerkillä. Tyhjän widgetin piilotus voi aiheuttaa ongelmia asemoinnin kanssa ja lisätä laitteen kuormitusta."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31684"
msgid "Cycle through the extra fanart of the focused item in the background."
msgstr "Määrittää kierrätetäänkö valittuna olevan kohteen taustakuvia, jos niitä on useita."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31685"
msgid "Select whether pressing back in a media window returns to the previous window or to the parent folder."
msgstr "Määrittää palataanko mediaikkunassa takaisin-nappia painamalla edelliseen ikkunaan vai yläkansioon."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31686"
msgid "Select whether the scrollbar jumps by letter when content is sorted alphabetically, or by page."
msgstr "Määrittää siirrytäänkö vierityspalkilla seuraavan kirjaimen kohdalle vai seuraavalle sivulle, jos sisältö on aakkosjärjestyksessä."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31688"
msgid "Automatically scroll long text in textboxes, such as plots."
msgstr "Määrittää vieritetäänkö tekstikappaleiden sisältöä automaattisesti, jos se ei mahdu kokonaan ruudulle."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31689"
msgid "Automatically scroll labels that are too long to fit."
msgstr "Määrittää vieritetäänkö tekstirivien sisältöä automaattisesti, jos se ei mahdu kokonaan ruudulle."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31690"
msgid "Set the number of seconds before the video OSD closes automatically."
msgstr "Määrittää ajan, jonka jälkeen videon kuvaruutuvalikko sulkeutuu automaattisesti."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31691"
msgid "Select whether the seekbar stays visible, shows information, or hides after playback has been paused for a while."
msgstr "Määrittää näytetäänkö hakupalkki, näytetäänkö tiedot vai piilotetaanko hakupalkki, jos toisto on tauolla pidempään."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31692"
msgid "Set how long playback must be paused before the seekbar behaviour is applied."
msgstr "Määrittää kuinka pitkään toiston on oltava tauolla ennen kuin tehdään mitään."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31693"
msgid "Select which times are shown on either side of the seekbar."
msgstr "Määrittää mitkä ajat näytetään hakupalkin eri puolilla."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31694"
msgid "Show the currently playing video in the background of the interface."
msgstr "Määrittää näytetäänkö toistettava video käyttöliittymän taustalla."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31695"
msgid "Enable the TMDbHelper service, which provides extra details, ratings and artwork for the focused item."
msgstr "Määrittää käytetäänkö TMDbHelper-palvelua, joka tarjoaa lisätietoja, arvioita ja mediakuvituksia valittuna olevalle kohteelle."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31696"
msgid "Choose which ratings are shown for movies."
msgstr "Määrittää elokuva-arvioiden lähteet."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31697"
msgid "Choose which ratings are shown for TV shows."
msgstr "Määrittää tv-sarja-arvioiden lähteet"

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31698"
msgid "Select the detail shown above the plot for movies: tagline, genre, director, or nothing."
msgstr "Määrittää mitkä lisätiedot näytetään elokuvan juonirivin yläpuolella; iskulause, lajityyppi, ohjaaja vai ei mitään."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31699"
msgid "Select the detail shown above the plot for TV shows: tagline, genre, episodes, or nothing."
msgstr "Määrittää mitkä lisätiedot näytetään tv-sarjan juonirivin yläpuolella; iskulause, lajityyppi, jaksot vai ei mitään."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31700"
msgid "Show the rating as stars in the item information."
msgstr "Määrittää näytetäänkö arviot inforivillä tähtinä numeroiden sijaan."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31701"
msgid "Show the number of audio channels in the item information."
msgstr "Määrittää näytetäänkö äänikanavien määrä inforivillä."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31702"
msgid "Show the HDR type in the item information."
msgstr "Määrittää näytetäänkö HDR-tyyppi inforivillä."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31703"
msgid "Select the size of the mouse pointer. The skin reloads to apply the change."
msgstr "Määritää hiiren osoittimen koon. Asetuksen muuttaminen vaatii käyttöliitymän uudelleenlatauksen."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31704"
msgid "Keep the splash screen visible until the home screen widgets have loaded."
msgstr "Määrittää näkyykö latausruutu niin pitkään, kunnes kotivalikon widgetit ovat latautuneet."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31705"
msgid "Load hub widgets in the background during startup so that hubs open faster."
msgstr "Määrittää ladataanko kaikki hubien widgetit taustalla käynnistyksen yhteydessä. Nopeuttaa hubien avautumista."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31706"
msgid "Allow each skin user to have their own shortcut and widget configuration, like a lightweight profile."
msgstr "Määrittää onko käyttäjillä omat valikko- ja widget-asetuksensa, jolloin jokaisella käyttäjällä on ikäänkuin oma käyttäjäprofiilinsa."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31707"
msgid "Show the skin user selection screen each time the skin starts."
msgstr "Määrittää näytetäänkö kirjautumisruutu aina, kun ulkoasu ladataan."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31708"
msgid "Colour the programmes in the EPG grid by genre."
msgstr "Määrittää korostetaanko ohjelmaoppaassa ohjelmien lajityypit eri väreillä."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31709"
msgid "Use TMDbHelper to look up extra details and artwork for PVR programmes."
msgstr "Määrittää käytetäänkö TMDbHelper-lisäosaa hakemaan lisätietoja ja mediakuvituksia PVR-toiminnon ohjelmille."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31710"
msgid "Decorate the interface with seasonal themes during the dates listed for each theme."
msgstr "Määrittää käytetäänkö erikoisteemoja piristämään käyttöliittymää tiettyinä ajankohtina."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31711"
msgid "Select the style of the Christmas theme, shown from Dec 7 to Jan 7, or turn it off."
msgstr "Määrittää jouluteeman tyylin. Käytössä välillä joulukuun 7. - tammikuun 7."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31712"
msgid "Show the Summer Breeze theme from Jun 21 to Aug 15."
msgstr "Määrittää kesäteeman tyylin. Käytössä välillä kesäkuun 21. - elokuun 15."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31713"
msgid "Show the Halloween Spook theme from Oct 1 to Nov 1."
msgstr "Määrittää halloween-teeman tyylin. Käytössä välillä lokakuun 1. - marraskuun 1."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31714"
msgid "Show the seasonal overlay on top of the background."
msgstr "Määrittää näytetäänkö teemaan kuuluva peittokuva taustan päällä."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31715"
msgid "Show the looping seasonal animation in the background."
msgstr "Määrittää näytetäänkö teemaan kuuluva animaatio taustalla."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31716"
msgid "Show seasonal animations that occasionally fly across the screen."
msgstr "Määrittää näytetäänkö ajoittain ruudun poikki lentäviä esineitä tai hahmoja."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31717"
msgid "Select how many seasonal props fall down the screen."
msgstr "Määrittää kuinka paljon teemaan kuuluvia esineitä näkyy ruudulla."

#: /1080i/Includes_SkinSettings.xml
msgctxt "#31718"
msgid "Reset all skin settings to their default values. This cannot be undone."
msgstr "Palauttaa kaikki ulkoasun asetukset oletusarvoihinsa. Tätä toimintoa ei voi kumota."

#: /1080i/Custom_1115_Window_Shortcuts.xml
msgctxt "#31719"
msgid "This category contains the settings for the search hub layout, widgets and discover lists."
msgstr "Tämä kategoria sisältää hakuvalikon asetteluun, widgeteihin ja listoihin liittyvät asetukset."

#: /1080i/Custom_1115_Window_Shortcuts.xml
msgctxt "#31720"
msgid "This category contains the settings for the shortcut, submenu and widgets of this hub."
msgstr "Tämä kategoria sisältää tämän hubin pikakuvakkeeseen, alivalikkoon ja widgeteihin liittyvät asetukset."

#: /1080i/Custom_1115_Window_Shortcuts.xml
msgctxt "#31721"
msgid "This category contains the settings for the options menu tiles, power menu and tray."
msgstr "Tämä kategoria sisältää virtavalikon ruutuihin, valikkoon ja alareunaan liittyvät asetukset."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31722"
msgid "Select how the widgets in the search hub are laid out."
msgstr "Määrittää hakuvalikon widgetien asettelun."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31723"
msgid "Choose the widgets shown in the search hub."
msgstr "Määrittää mitkä widgetit näkyvät hakuvalikossa."

#: /1080i/Dialog_DialogShortcuts.xml
msgctxt "#31724"
